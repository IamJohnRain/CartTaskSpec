{
    "version": "v0.9",
    "createSurface": {
        "surfaceId": "card",
        "catalogId": "ohos.a2ui.extended.catalog",
        "width": 300,
        "height": 140
    }
}
{
    "version": "v0.9",
    "updateComponents": {
        "surfaceId": "card",
        "root": "root",
        "components": [
            {
                "id": "root",
                "component": {
                    "component": "Column",
                    "width": 300,
                    "height": 140,
                    "padding": 12,
                    "borderRadius": 22,
                    "clip": true,
                    "backgroundImage": "linear-gradient(135deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05))",
                    "backgroundColor": "rgba(240,245,255,0.15)",
                    "border": {
                        "width": 1,
                        "color": "rgba(255,255,255,0.3)",
                        "style": "solid"
                    },
                    "children": [
                        "header_row",
                        "divider",
                        "actions_row"
                    ]
                }
            },
            {
                "id": "header_row",
                "component": {
                    "component": "Row",
                    "width": "100%",
                    "height": 52,
                    "gap": 12,
                    "alignItems": "center",
                    "justifyContent": "space-between",
                    "children": [
                        "brand_info",
                        "battery_container"
                    ]
                }
            },
            {
                "id": "brand_info",
                "component": {
                    "component": "Row",
                    "width": 120,
                    "height": 52,
                    "gap": 10,
                    "alignItems": "center",
                    "children": [
                        "earbuds_icon",
                        "device_name"
                    ]
                }
            },
            {
                "id": "earbuds_icon",
                "component": {
                    "component": "Image",
                    "src": "assets/freeclip2-earbuds.png",
                    "width": 40,
                    "height": 40,
                    "objectFit": "contain"
                }
            },
            {
                "id": "device_name",
                "component": {
                    "component": "Text",
                    "content": "{{ $__dataModel.device.name }}",
                    "fontSize": 16,
                    "fontWeight": "bold",
                    "fontColor": "#FFFFFF",
                    "maxLines": 2,
                    "textOverflow": "ellipsis"
                }
            },
            {
                "id": "battery_container",
                "component": {
                    "component": "Row",
                    "width": 124,
                    "height": 52,
                    "gap": 12,
                    "alignItems": "center",
                    "justifyContent": "flex-end",
                    "children": [
                        "left_battery_col",
                        "right_battery_col"
                    ]
                }
            },
            {
                "id": "left_battery_col",
                "component": {
                    "component": "Column",
                    "width": 56,
                    "height": 48,
                    "gap": 4,
                    "alignItems": "center",
                    "justifyContent": "center",
                    "children": [
                        "left_progress",
                        "left_battery"
                    ]
                }
            },
            {
                "id": "left_progress",
                "component": {
                    "component": "Progress",
                    "type": "ring",
                    "width": 20,
                    "height": 20,
                    "percent": 47,
                    "color": "rgba(255,255,255,0.85)",
                    "backgroundColor": "rgba(255,255,255,0.2)"
                }
            },
            {
                "id": "left_battery",
                "component": {
                    "component": "Text",
                    "content": "{{ $__dataModel.device.leftBatteryText }}",
                    "fontSize": 10,
                    "fontColor": "rgba(255,255,255,0.9)",
                    "maxLines": 1
                }
            },
            {
                "id": "right_battery_col",
                "component": {
                    "component": "Column",
                    "width": 56,
                    "height": 48,
                    "gap": 4,
                    "alignItems": "center",
                    "justifyContent": "center",
                    "children": [
                        "right_progress",
                        "right_battery"
                    ]
                }
            },
            {
                "id": "right_progress",
                "component": {
                    "component": "Progress",
                    "type": "ring",
                    "width": 20,
                    "height": 20,
                    "percent": 95,
                    "color": "rgba(255,255,255,0.85)",
                    "backgroundColor": "rgba(255,255,255,0.2)"
                }
            },
            {
                "id": "right_battery",
                "component": {
                    "component": "Text",
                    "content": "{{ $__dataModel.device.rightBatteryText }}",
                    "fontSize": 10,
                    "fontColor": "rgba(255,255,255,0.9)",
                    "maxLines": 1
                }
            },
            {
                "id": "divider",
                "component": {
                    "component": "Divider",
                    "width": "100%",
                    "height": 1,
                    "color": "rgba(255,255,255,0.25)",
                    "margin": {
                        "top": 4,
                        "bottom": 4
                    }
                }
            },
            {
                "id": "actions_row",
                "component": {
                    "component": "Row",
                    "width": "100%",
                    "height": 44,
                    "gap": 12,
                    "alignItems": "center",
                    "children": [
                        "daily_30_btn",
                        "favorite_playlist_btn"
                    ]
                }
            },
            {
                "id": "daily_30_btn",
                "component": {
                    "component": "Button",
                    "label": "每日30首",
                    "width": 124,
                    "height": 40,
                    "fontSize": 14,
                    "fontColor": "#FFFFFF",
                    "backgroundColor": "rgba(255,255,255,0.18)",
                    "border": {
                        "width": 1,
                        "color": "rgba(255,255,255,0.3)",
                        "style": "solid"
                    },
                    "borderRadius": 20,
                    "onClick": [
                        {
                            "call": "clickToDeeplink",
                            "args": {
                                "bundleName": "",
                                "abilityName": "",
                                "uri": "hwmusic://com.huawei.hmsapp.music/showMusicList?code=a001&type=4"
                            }
                        }
                    ]
                }
            },
            {
                "id": "favorite_playlist_btn",
                "component": {
                    "component": "Button",
                    "label": "心动歌单",
                    "width": 124,
                    "height": 40,
                    "fontSize": 14,
                    "fontColor": "#FFFFFF",
                    "backgroundColor": "rgba(255,255,255,0.18)",
                    "border": {
                        "width": 1,
                        "color": "rgba(255,255,255,0.3)",
                        "style": "solid"
                    },
                    "borderRadius": 20,
                    "onClick": [
                        {
                            "call": "clickToDeeplink",
                            "args": {
                                "bundleName": "",
                                "abilityName": "",
                                "uri": "hwmusic://com.huawei.hmsapp.music/showMusicList?code=favoriteSong&type=412"
                            }
                        }
                    ]
                }
            }
        ]
    }
}
{
    "version": "v0.9",
    "updateDataModel": {
        "surfaceId": "card",
        "path": "/",
        "value": {
            "device": {
                "name": "Free Clip 2",
                "leftBatteryText": "左耳 47%",
                "rightBatteryText": "右耳 95%",
                "leftBatteryPercent": 47,
                "rightBatteryPercent": 95
            },
            "style": {
                "mood": "frosted glass premium"
            }
        }
    }
}