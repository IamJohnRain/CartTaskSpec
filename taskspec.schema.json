{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/taskspec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "required": [
    "userQuery",
    "size",
    "eventCandidates",
    "dataModel",
    "assetCandidates"
  ],
  "properties": {
    "userQuery": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "enum": ["2x2", "2x4"]
    },
    "eventCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventCandidate"
      }
    },
    "dataModel": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "assetCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetCandidate"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~0|~1)*)*$"
    },
    "eventCandidate": {
      "type": "object",
      "required": ["call"],
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "assetCandidate": {
      "type": "object",
      "required": ["src", "use", "description"],
      "properties": {
        "assetRef": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "给 A2UI 模型理解素材内容、视觉语义和适用场景；文本模型应依据该字段决定是否使用素材。"
        },
        "bindTo": {
          "$ref": "#/$defs/jsonPointer"
        },
        "static": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
