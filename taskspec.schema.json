{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/taskspec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "required": [
    "userQuery",
    "task",
    "target",
    "displayCandidates",
    "eventCandidates",
    "dataModel",
    "assetCandidates"
  ],
  "properties": {
    "userQuery": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "size": {
          "enum": ["2x2", "2x4"]
        },
        "sceneHints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "styleHints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "displayCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/displayCandidate"
      }
    },
    "eventCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventCandidate"
      }
    },
    "dataModel": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "assetCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetCandidate"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~0|~1)*)*$"
    },
    "displayCandidate": {
      "type": "object",
      "required": ["id", "role", "label"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "role": {
          "enum": ["identity", "primary", "metric", "status", "context", "media"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "dataPath": {
          "$ref": "#/$defs/jsonPointer"
        },
        "assetRef": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "eventCandidate": {
      "type": "object",
      "required": ["id", "label", "onClick"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "onClick": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/eventHandler"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assetCandidate": {
      "type": "object",
      "required": ["src", "use"],
      "properties": {
        "assetRef": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "type": "string",
          "minLength": 1
        },
        "bindTo": {
          "$ref": "#/$defs/jsonPointer"
        },
        "static": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "eventHandler": {
      "type": "object",
      "required": ["call"],
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        },
        "condition": {
          "type": "string"
        },
        "as": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
