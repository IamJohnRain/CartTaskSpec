{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/taskspec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "required": [
    "userQuery",
    "task",
    "target",
    "displayCandidates",
    "eventCandidates",
    "dataModel",
    "assetCandidates"
  ],
  "properties": {
    "userQuery": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "size": {
          "enum": ["2x2", "2x4"]
        }
      },
      "additionalProperties": false
    },
    "displayCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/displayCandidate"
      }
    },
    "eventCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventCandidate"
      }
    },
    "dataModel": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "assetCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetCandidate"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~0|~1)*)*$"
    },
    "displayCandidate": {
      "type": "object",
      "required": ["id", "role", "label", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "role": {
          "enum": ["identity", "primary", "metric", "status", "context", "media"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "给 A2UI 模型理解该内容候选的语义、用途和展示重点；不是布局、字号或位置指令。"
        },
        "dataPath": {
          "$ref": "#/$defs/jsonPointer"
        },
        "assetRef": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "eventCandidate": {
      "type": "object",
      "required": ["id", "label", "description", "onClick"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "给 A2UI 模型理解该动作入口的意图、触发结果和展示优先级；不是按钮样式或位置指令。"
        },
        "required": {
          "type": "boolean"
        },
        "onClick": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/eventHandler"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assetCandidate": {
      "type": "object",
      "required": ["src", "use", "description"],
      "properties": {
        "assetRef": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "给 A2UI 模型理解素材内容、视觉语义和适用场景；文本模型应依据该字段决定是否使用素材。"
        },
        "bindTo": {
          "$ref": "#/$defs/jsonPointer"
        },
        "static": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "eventHandler": {
      "type": "object",
      "required": ["call"],
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        },
        "condition": {
          "type": "string"
        },
        "as": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
