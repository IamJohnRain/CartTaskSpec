{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/taskspec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "required": [
    "schema",
    "rulesVersion",
    "userQuery",
    "task",
    "card",
    "dataModel",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "taskspec/v1"
    },
    "rulesVersion": {
      "const": "harmony-form-datamodel-first-rules/v1"
    },
    "userQuery": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "card": {
      "type": "object",
      "required": ["scenario", "size", "requirements"],
      "properties": {
        "scenario": {
          "enum": ["status", "reminder", "action", "device", "summary"]
        },
        "size": {
          "enum": ["2x2", "2x4"]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "type": {
                "enum": ["identity", "primary", "metric", "status", "context", "media", "action", "style"]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "dataPath": {
                "$ref": "#/$defs/jsonPointer"
              },
              "assetRef": {
                "type": "string",
                "minLength": 1
              },
              "onClick": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/eventHandler"
                }
              },
              "required": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dataModel": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "use"],
        "properties": {
          "assetRef": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "bindTo": {
            "$ref": "#/$defs/jsonPointer"
          },
          "static": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~0|~1)*)*$"
    },
    "eventHandler": {
      "type": "object",
      "required": ["call"],
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        },
        "condition": {
          "type": "string"
        },
        "as": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
