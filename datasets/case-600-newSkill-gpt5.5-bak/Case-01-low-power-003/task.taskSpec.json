{
  "userQuery": "整个电量监控的嘛,能看百分比,点能开省电,能读天气,红色警告加上",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "battery": {
      "levelPercent": {
        "type": "number",
        "description": "当前电量百分比数值，用于进度组件展示。",
        "sampleValue": 18
      },
      "levelText": {
        "type": "string",
        "description": "当前电量百分比展示文本。",
        "sampleValue": "18%"
      },
      "statusText": {
        "type": "string",
        "description": "电量告警状态短文本。",
        "sampleValue": "红色警告"
      },
      "powerModeText": {
        "type": "string",
        "description": "省电模式动作入口展示文案。",
        "sampleValue": "开启省电"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区的区县名称。",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前天气温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          },
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警信息。",
            "sampleValue": "高温预警"
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "端侧天气能力更新时间。",
          "sampleValue": "15:30"
        }
      }
    },
    "asset": {
      "powerIcon": {
        "type": "string",
        "description": "低电模式电池图标素材路径。",
        "sampleValue": "resources/base/media/icon_electricity.png"
      },
      "weatherIcon": {
        "type": "string",
        "description": "天气状态图标素材路径。",
        "sampleValue": "resources/base/media/cloudy.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "电池图标，适合低电模式卡片中作为电量监控的主识别素材。",
      "bindTo": "/asset/powerIcon"
    },
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色多云天气图标，适合天气速览支撑信息展示。",
      "bindTo": "/asset/weatherIcon"
    }
  ]
}
