{
  "userQuery": "搞个省电模式卡片 文字叠在图上 显示剩多少电 点了能跳应用",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "power": {
      "modeTitle": {
        "type": "string",
        "description": "省电模式卡片标题",
        "sampleValue": "省电模式"
      },
      "batteryPercentText": {
        "type": "string",
        "description": "当前剩余电量百分比展示文案",
        "sampleValue": "18%"
      },
      "statusText": {
        "type": "string",
        "description": "低电量状态提示",
        "sampleValue": "低电量"
      },
      "actionText": {
        "type": "string",
        "description": "跳转到电池设置页的动作文案",
        "sampleValue": "查看"
      }
    },
    "assets": {
      "backgroundIcon": {
        "type": "string",
        "description": "省电模式背景图标素材路径",
        "sampleValue": "resources/base/media/icon_save_power.png"
      },
      "statusIcon": {
        "type": "string",
        "description": "低电模式电池图标素材路径",
        "sampleValue": "resources/base/media/icon_electricity.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，适用于低电模式卡片的主视觉或背景图像叠层。",
      "bindTo": "/assets/backgroundIcon"
    },
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "电池图标，适用于低电模式卡片的电量状态识别。",
      "bindTo": "/assets/statusIcon"
    }
  ]
}
