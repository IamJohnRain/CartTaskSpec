{
  "userQuery": "弄个卡片吧，按钮能进系统设置，电量数字会变，能读日历提醒快没电了",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "battery": {
      "level": {
        "type": "number",
        "description": "当前设备电量百分比，用于进度条和运行时变化。",
        "sampleValue": 18
      },
      "levelText": {
        "type": "string",
        "description": "当前设备电量展示文本。",
        "sampleValue": "18%"
      },
      "statusText": {
        "type": "string",
        "description": "低电状态短标签。",
        "sampleValue": "低电量"
      },
      "captionText": {
        "type": "string",
        "description": "电量主数值的短说明。",
        "sampleValue": "当前电量"
      },
      "adviceText": {
        "type": "string",
        "description": "低电模式下的处理建议。",
        "sampleValue": "建议充电"
      }
    },
    "data": {
      "calendar": {
        "items": [
          {
            "entityName": {
              "type": "string",
              "description": "日历事件类别说明。",
              "sampleValue": "日历事件"
            },
            "entityId": {
              "type": "string",
              "description": "日历事件唯一标识符。",
              "sampleValue": "calendar-low-power-001"
            },
            "title": {
              "type": "string",
              "description": "用于提醒快没电的日历事件标题。",
              "sampleValue": "充电提醒"
            },
            "dtStart": {
              "type": "string",
              "description": "日历事件开始时间，今日事件使用 HH:MM 格式。",
              "sampleValue": "21:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "日历事件结束时间，今日事件使用 HH:MM 格式。",
              "sampleValue": "21:35"
            }
          }
        ]
      }
    },
    "state": {
      "loading": {
        "type": "boolean",
        "description": "日历数据是否仍在加载。",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "电池图标，适用场景：低电模式，用于卡片主视觉识别当前电量状态。"
    }
  ]
}
