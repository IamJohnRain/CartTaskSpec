{
  "userQuery": "做个背景上加文字的卡片，专注时间倒计时，点开始，显示已连接状态",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "focus_mode",
          "switchFlag": 1
        }
      }
    }
  ],
  "dataModel": {
    "value": {
      "focus": {
        "title": "专注倒计时",
        "remainingText": "25:00",
        "progressValue": 0,
        "progressTotal": 25,
        "statusText": "已连接",
        "actionText": "开始",
        "icon": "assets/focus-timer-icon.png"
      }
    }
  },
  "assetCandidates": [
    {
      "assetRef": "focus_timer_icon",
      "src": "assets/focus-timer-icon.png",
      "use": "focus icon",
      "description": "专注计时图标素材，适合用于倒计时或专注模式的轻量视觉提示。",
      "bindTo": "/focus/icon"
    }
  ]
}
