          "items": [
            {
              "entityName": "calendar",
              "entityId": "mock-calendar-001",
              "title": "例会",
              "dtStart": "14:00",
              "dtEnd": "15:00"
            }
          ]
        }
      },
      "state": {
        "loading": true
      }
    }
  },
  "assetCandidates": [
    {
      "assetRef": "memory_clean_icon",
      "src": "resources/base/media/icon_clear.png",
      "use": "memory clean icon",
