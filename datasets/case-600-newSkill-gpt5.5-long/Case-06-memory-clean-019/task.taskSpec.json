      "powerLabel": {
        "type": "string",
        "description": "省电模式开关旁的短标签。",
        "sampleValue": "省电"
      },
      "powerModeEnabled": {
        "type": "boolean",
        "description": "省电模式当前是否已开启。",
        "sampleValue": false
