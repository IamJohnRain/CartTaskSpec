{
  "userQuery": "卡片左边放个语义图标当主视觉,右边信息区,带勾选框,点能跳到音乐歌单放点轻松的歌(等快递焦虑用)。读天气数据,完成状态用绿色。视觉风格从图标延伸出来,左右分区。纯文字和色块,不要图片。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hwmusic://com.huawei.hmsapp.music/showMusicList?code=a001&type=4"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询对应的区县名称。",
            "sampleValue": "朝阳区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        }
      }
    },
    "ui": {
      "courierIcon": {
        "type": "string",
        "description": "快递物流语义图标素材路径，用作左侧主视觉。",
        "sampleValue": "resources/base/media/courier_box.png"
      },
      "title": {
        "type": "string",
        "description": "右侧信息区标题。",
        "sampleValue": "快递到站"
      },
      "statusLabel": {
        "type": "string",
        "description": "快递完成状态文案。",
        "sampleValue": "已完成"
      },
      "statusDone": {
        "type": "boolean",
        "description": "快递流程是否已完成。",
        "sampleValue": true
      },
      "actionLabel": {
        "type": "string",
        "description": "音乐歌单跳转入口短文案。",
        "sampleValue": "听歌"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/courier_box.png",
      "description": "快递箱子彩色图标，适合表达物流、取件和包裹状态，可作为左侧主视觉语义图标。",
      "bindTo": "/ui/courierIcon"
    }
  ]
}
