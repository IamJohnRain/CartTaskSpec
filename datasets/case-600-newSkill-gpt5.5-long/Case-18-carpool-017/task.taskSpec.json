{
  "userQuery": "周末拼车郊游卡，列表展示几条备选路线，每条前面勾选我心仪那条，点进去能查看对应日程详情，读目的地天气看温度。简洁素净风格，中间放环形仪表盘显示\"路线已规划\"完成状态，\"已就绪\"用绿色对勾正向呈现。夜晚深蓝到紫倒计时渐变，纯文字与色块不用图。每次出游前都要纠结半天路线，能这样对比就好了。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/trip/routes/0/entityId} }}"
        }
      }
    },
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/trip/routes/1/entityId} }}"
        }
      }
    },
