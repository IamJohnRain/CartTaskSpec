{
  "userQuery": "帮我做期末复习倒计时卡片,主题色背景,顶部大数字\"还剩21天\",环形进度中心叠数字那种叠加感。点一下能查看或进入具体的某个日程事件看复习安排。运动激励渐变(虽然奇怪但我想要紧迫感),可以用语义图标比如书本或闹钟。下面需要一个可滚动的重复列表,显示每天的复习任务项,静态示例数据填就行。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "exam-review-plan"
        }
      }
    }
  ],
  "dataModelSchema": {
    "countdown": {
      "title": {
        "type": "string",
        "description": "卡片标题，说明倒计时对象。",
        "sampleValue": "期末复习"
      },
      "remainingText": {
        "type": "string",
        "description": "距离期末复习目标日期的剩余天数展示文案。",
        "sampleValue": "还剩21天"
      },
      "days": {
        "type": "string",
        "description": "环形进度中心叠加的剩余天数数字。",
        "sampleValue": "21"
      },
      "progressValue": {
        "type": "number",
        "description": "当前复习周期已经推进的进度值。",
        "sampleValue": 9
      },
      "progressTotal": {
        "type": "number",
        "description": "复习倒计时总周期对应的进度总值。",
        "sampleValue": 30
      },
      "caption": {
        "type": "string",
        "description": "主倒计时下方的短提示文案。",
        "sampleValue": "今晚冲刺英语阅读"
      }
    },
    "event": {
      "entityId": {
        "type": "string",
        "description": "可打开的日程事件 ID，用于查看复习安排详情。",
        "sampleValue": "exam-review-plan"
      },
      "actionText": {
        "type": "string",
        "description": "查看日程安排的短动作文案。",
        "sampleValue": "看安排"
      }
    },
    "assets": {
      "timerIcon": {
        "type": "string",
        "description": "倒计时或复习提醒语义图标路径。",
        "sampleValue": "resources/base/media/stopwatch_fill.svg"
      }
    },
    "tasks": [
      {
        "day": {
          "type": "string",
          "description": "第一条复习任务的日期或天次。",
          "sampleValue": "D-21"
        },
        "title": {
          "type": "string",
          "description": "第一条复习任务标题。",
          "sampleValue": "英语阅读 2 组"
        },
        "slot": {
          "type": "string",
          "description": "第一条复习任务建议时间段。",
          "sampleValue": "20:00"
        }
      },
      {
        "day": {
          "type": "string",
          "description": "第二条复习任务的日期或天次。",
          "sampleValue": "D-20"
        },
        "title": {
          "type": "string",
          "description": "第二条复习任务标题。",
          "sampleValue": "高数错题复盘"
        },
        "slot": {
          "type": "string",
          "description": "第二条复习任务建议时间段。",
          "sampleValue": "19:30"
        }
      },
      {
        "day": {
          "type": "string",
          "description": "第三条复习任务的日期或天次。",
          "sampleValue": "D-19"
        },
        "title": {
          "type": "string",
          "description": "第三条复习任务标题。",
          "sampleValue": "专业课章节背诵"
        },
        "slot": {
          "type": "string",
          "description": "第三条复习任务建议时间段。",
          "sampleValue": "21:10"
        }
      }
    ]
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/stopwatch_fill.svg",
      "description": "秒表实心图标，适合表达期末复习倒计时、计时冲刺和紧迫感。",
      "bindTo": "/assets/timerIcon"
    }
  ]
}
