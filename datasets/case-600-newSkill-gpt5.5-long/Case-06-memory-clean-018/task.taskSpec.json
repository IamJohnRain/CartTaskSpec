{
  "userQuery": "手机卡死了，做个内存分析卡片，用静态数据展示就行，中间是个大仪表盘显示总存储用量，旁边用不同底色分成几个区域，区域里面横向排列好几个可勾选的清理项目比如视频缓存、卸载残留，用上内存和扫描的语义图标，背景配色带点清理加速那种紧迫的渐变风格，点击这些选项要能跳到系统的存储管理界面去处理。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "storage": {
      "title": {
        "type": "string",
        "description": "卡片主仪表盘标题，说明当前展示的是存储占用分析。",
        "sampleValue": "存储占用"
      },
      "usagePercentText": {
        "type": "string",
        "description": "总存储用量百分比的展示文本。",
        "sampleValue": "78%"
      },
      "usedText": {
        "type": "string",
        "description": "已用容量与总容量的短展示文本。",
        "sampleValue": "128GB/256GB"
      },
      "progress": {
        "value": {
          "type": "number",
          "description": "总存储用量进度值。",
          "sampleValue": 78
        },
        "total": {
          "type": "number",
          "description": "总存储用量进度总值。",
          "sampleValue": 100
        }
      }
    },
    "cleanup": {
      "memoryTitle": {
        "type": "string",
        "description": "内存清理项目区域标题。",
        "sampleValue": "内存项"
      },
      "scanTitle": {
        "type": "string",
        "description": "扫描清理项目区域标题。",
        "sampleValue": "扫描项"
      },
      "videoCache": {
        "label": {
          "type": "string",
          "description": "视频缓存清理项名称。",
          "sampleValue": "视频缓存"
        },
        "selected": {
          "type": "boolean",
          "description": "视频缓存清理项是否默认勾选。",
          "sampleValue": true
        }
      },
      "tempFiles": {
        "label": {
          "type": "string",
          "description": "临时文件清理项名称。",
          "sampleValue": "临时文件"
        },
        "selected": {
          "type": "boolean",
          "description": "临时文件清理项是否默认勾选。",
          "sampleValue": true
        }
      },
      "uninstallResidue": {
        "label": {
          "type": "string",
          "description": "卸载残留清理项名称。",
          "sampleValue": "卸载残留"
        },
        "selected": {
          "type": "boolean",
          "description": "卸载残留清理项是否默认勾选。",
          "sampleValue": true
        }
      },
      "appCache": {
        "label": {
          "type": "string",
          "description": "应用缓存清理项名称。",
          "sampleValue": "应用缓存"
        },
        "selected": {
          "type": "boolean",
          "description": "应用缓存清理项是否默认勾选。",
          "sampleValue": false
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/externaldrive_fill.svg",
      "description": "外置存储设备实心图标，适合表达本地存储、容量占用和文件管理语义。"
    },
    {
      "src": "resources/base/media/clean_fill.svg",
      "description": "清洁实心图标，适合表达扫描清理、释放空间和加速处理语义。"
    }
  ]
}
