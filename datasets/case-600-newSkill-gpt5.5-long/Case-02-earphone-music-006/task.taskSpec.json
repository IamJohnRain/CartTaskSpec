{
  "userQuery": "帮我做一个深色舞台风格的音乐卡片，背景搞点音乐节奏感的渐变氛围。卡片上面横着排开三个日程提醒，比如用文字图标写成“【会议】【下班】【健身】”，后面拼上动态文案显示“距离下班还有3小时12分”。耳机名字和电量并排显示在下面，点一下能直接进手机系统设置里改应用使用时间。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "title": {
              "type": "string",
              "description": "日程标题，用于顶部横排日程提醒。",
              "sampleValue": "会议"
            },
            "dtStart": {
              "type": "string",
              "description": "日程开始时间，如果是当天则为 HH:MM。",
              "sampleValue": "14:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "日程结束时间，如果是当天则为 HH:MM。",
              "sampleValue": "15:00"
            },
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符。",
              "sampleValue": "calendar-event-001"
            }
          },
          {
            "title": {
              "type": "string",
              "description": "日程标题，用于顶部横排日程提醒。",
              "sampleValue": "下班"
            },
            "dtStart": {
              "type": "string",
              "description": "日程开始时间，如果是当天则为 HH:MM。",
              "sampleValue": "18:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "日程结束时间，如果是当天则为 HH:MM。",
              "sampleValue": "18:30"
            },
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符。",
              "sampleValue": "calendar-event-002"
            }
          },
          {
            "title": {
              "type": "string",
              "description": "日程标题，用于顶部横排日程提醒。",
              "sampleValue": "健身"
            },
            "dtStart": {
              "type": "string",
              "description": "日程开始时间，如果是当天则为 HH:MM。",
              "sampleValue": "20:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "日程结束时间，如果是当天则为 HH:MM。",
              "sampleValue": "21:00"
            },
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符。",
              "sampleValue": "calendar-event-003"
            }
          }
        ]
      },
      "music": {
        "countdownText": {
          "type": "string",
          "description": "面向当前日程目标的动态倒计时文案。",
          "sampleValue": "距离下班还有3小时12分"
        },
        "earphoneName": {
          "type": "string",
          "description": "当前连接的耳机名称。",
          "sampleValue": "FreeBuds 3"
        },
        "batteryText": {
          "type": "string",
          "description": "耳机剩余电量展示文本。",
          "sampleValue": "82%"
        }
      }
    },
    "assets": {
      "musicIcon": {
        "type": "string",
        "description": "音乐音符图标资源路径。",
        "sampleValue": "resources/base/media/icon_music.png"
      },
      "earphoneIcon": {
        "type": "string",
        "description": "耳机图标资源路径。",
        "sampleValue": "resources/base/media/icon_earphone.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_music.png",
      "description": "音乐图标，适合用于音乐氛围或播放状态的视觉识别。",
      "bindTo": "/assets/musicIcon"
    },
    {
      "src": "resources/base/media/icon_earphone.png",
      "description": "耳机图标，适合用于耳机设备名称与连接状态识别。",
      "bindTo": "/assets/earphoneIcon"
    }
  ]
}
