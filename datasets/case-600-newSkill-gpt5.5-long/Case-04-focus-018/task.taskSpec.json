              "title": {
                "type": "string",
                "description": "日程标题",
                "sampleValue": "需求评审"
              },
              "dtStart": {
                "type": "string",
                "description": "日程开始时间，今天内使用 HH:MM 格式",
                "sampleValue": "09:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "日程结束时间，今天内使用 HH:MM 格式",
                "sampleValue": "10:00"
              }
            }
          }
        }
      }
    }
  },
  "assetCandidates": [
