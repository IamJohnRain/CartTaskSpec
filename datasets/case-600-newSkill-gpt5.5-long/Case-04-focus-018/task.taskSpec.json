{
  "userQuery": "我工作安排太杂了，做个专注卡片把日历日程数据读出来。背景弄浅色调，卡片中心放个圆环显示今日专注时长，上面用分隔线划开几块，下半部分弄个能滚动的列表把今天的日程一条条列出来。带个深灰到黑的渐变效果，加个文字按钮能一键屏蔽消息免打扰就行。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "summary": {
      "todayLabel": {
        "type": "string",
        "description": "今日时间范围的短标签",
        "sampleValue": "今天"
      }
    },
    "focus": {
      "durationText": {
        "type": "string",
        "description": "今日专注时长的紧凑展示文本",
        "sampleValue": "135分"
      },
      "progressValue": {
        "type": "number",
        "description": "今日专注时长相对目标的进度值",
        "sampleValue": 135
      },
      "progressTotal": {
        "type": "number",
        "description": "今日专注目标时长总量，单位为分钟",
        "sampleValue": 180
      }
    },
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "今天的日历日程列表",
          "sampleValue": [
            {
              "entityId": "calendar-event-001",
              "title": "需求评审",
              "dtStart": "09:30",
              "dtEnd": "10:00"
            },
            {
              "entityId": "calendar-event-002",
              "title": "方案同步",
              "dtStart": "14:00",
              "dtEnd": "14:30"
            }
          ],
          "items": {
            "type": "object",
            "description": "单条日程项",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程唯一标识符",
                "sampleValue": "calendar-event-001"
