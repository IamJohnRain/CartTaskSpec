{
  "userQuery": "帮我做个磨砂质感的专注模式小卡片，中间放个圆环仪表盘，里面纯用文字显示当前的日历日程标题和状态。圆环下面横向排开几个项，比如“屏蔽通知”、“省电模式”、“倒计时”这种固定文案。用文字符号做个“☀”图标，卡片背景能跟着晚上变暗的渐变就行，最后加个按钮可以直接切换系统的勿扰开关。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程唯一标识符",
              "sampleValue": "calendar_focus_001"
            },
            "title": {
              "type": "string",
              "description": "当前日历日程标题",
              "sampleValue": "复盘会"
            },
            "dtStart": {
              "type": "string",
              "description": "当前日程开始时间，今日事件使用 HH:MM 格式",
              "sampleValue": "14:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "当前日程结束时间，今日事件使用 HH:MM 格式",
              "sampleValue": "15:00"
            }
          }
        ]
      }
    },
    "focus": {
      "statusText": {
        "type": "string",
        "description": "专注模式下当前日程的短状态文案",
        "sampleValue": "日程中"
      },
      "ringValue": {
        "type": "number",
        "description": "专注圆环仪表盘当前进度样例值",
        "sampleValue": 68
      },
      "ringTotal": {
        "type": "number",
        "description": "专注圆环仪表盘总量样例值",
        "sampleValue": 100
      }
    },
    "theme": {
      "rootStart": {
        "type": "string",
        "description": "夜间专注背景渐变起始色",
        "sampleValue": "#ff202224"
      },
      "rootEnd": {
        "type": "string",
        "description": "夜间专注背景渐变结束色",
        "sampleValue": "#5550a6"
      },
      "ringColor": {
        "type": "string",
        "description": "专注圆环强调色",
        "sampleValue": "#8c55c2"
      }
    }
  },
  "assetCandidates": []
}
