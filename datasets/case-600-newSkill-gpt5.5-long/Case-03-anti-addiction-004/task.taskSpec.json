          "sampleValue": "douyin"
        },
        "checked": {
          "type": "boolean",
          "description": "第二个应用是否已勾选绑定。",
          "sampleValue": true
        }
      },
      "third": {
        "name": {
          "type": "string",
          "description": "第三个已绑定管控应用名称。",
          "sampleValue": "视频"
        },
        "value": {
          "type": "string",
          "description": "第三个已绑定管控应用的选择值。",
