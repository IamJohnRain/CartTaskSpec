{
  "userQuery": "帮我做个管控卡片，左边放大图，右边横着排几个能打勾绑定的应用，上下堆叠显示今天玩王者的时间，比如写死了120分钟，要是把限制取消掉就会触发红色超限告警，深色舞台风格，不要渐变色，上面用个锁屏的语义图标，底部按键直接跳到系统的应用管理。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "control": {
      "title": {
        "type": "string",
        "description": "防沉迷管控卡片标题。",
        "sampleValue": "应用管控"
      },
      "statusText": {
        "type": "string",
        "description": "限制取消后触发的超限告警状态文本。",
        "sampleValue": "超限告警"
      },
      "actionLabel": {
        "type": "string",
        "description": "跳转到系统健康使用 App 页面管理限制的按钮文案。",
        "sampleValue": "应用管理"
      },
      "heroCaption": {
        "type": "string",
        "description": "左侧主视觉下方的管控语义短文案。",
        "sampleValue": "锁屏守护"
      }
    },
    "usage": {
