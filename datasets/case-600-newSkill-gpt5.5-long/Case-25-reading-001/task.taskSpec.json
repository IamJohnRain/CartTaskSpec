{
  "userQuery": "听书卡想要图片延伸视觉,氛围背景,前景叠文字加环形数字,一组书目可勾选(双向绑定)要能上下滚动,点跳音乐app歌单,环境氛围渐变(适合听书),图标用文字字符,示例数据,无特殊状态色。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hwmusic://com.huawei.hmsapp.music/showMusicList?code=a001&type=4"
      }
    }
  ],
  "dataModelSchema": {
    "assets": {
      "coverSrc": {
        "type": "string",
        "description": "听书氛围背景图素材路径，必须来自素材候选白名单。",
        "sampleValue": "resources/base/media/icon_music.png"
      }
    },
    "header": {
      "title": {
        "type": "string",
        "description": "卡片顶部的听书服务短标题。",
        "sampleValue": "夜读"
      },
      "glyph": {
        "type": "string",
        "description": "用文字字符表达的听书图标。",
        "sampleValue": "听"
      }
    },
    "session": {
      "progressValue": {
        "type": "number",
        "description": "当前听书进度数值。",
        "sampleValue": 73
      },
      "progressTotal": {
        "type": "number",
        "description": "听书进度总量。",
        "sampleValue": 100
      },
      "progressLabel": {
        "type": "string",
        "description": "环形进度中央显示的百分比文本。",
        "sampleValue": "73%"
      },
      "bookTitle": {
        "type": "string",
        "description": "当前正在听的书名短标题。",
        "sampleValue": "夜航船"
      },
      "meta": {
        "type": "string",
        "description": "当前听书的剩余时间或章节提示。",
        "sampleValue": "32分 · 柔声"
      },
      "actionHint": {
        "type": "string",
        "description": "整卡跳转到音乐歌单的短提示。",
        "sampleValue": "点进歌单"
      }
    },
    "books": [
      {
        "id": {
          "type": "string",
          "description": "第一本书的选项标识。",
          "sampleValue": "book-001"
        },
        "title": {
          "type": "string",
          "description": "第一本可勾选书目标题。",
          "sampleValue": "夜航船"
        },
        "selected": {
          "type": "boolean",
          "description": "第一本书是否已被勾选。",
          "sampleValue": true
        }
      },
      {
        "id": {
          "type": "string",
          "description": "第二本书的选项标识。",
          "sampleValue": "book-002"
        },
        "title": {
          "type": "string",
          "description": "第二本可勾选书目标题。",
          "sampleValue": "山海经"
        },
        "selected": {
          "type": "boolean",
          "description": "第二本书是否已被勾选。",
          "sampleValue": false
        }
      },
      {
        "id": {
          "type": "string",
          "description": "第三本书的选项标识。",
          "sampleValue": "book-003"
        },
        "title": {
          "type": "string",
          "description": "第三本可勾选书目标题。",
          "sampleValue": "人间词话"
        },
        "selected": {
          "type": "boolean",
          "description": "第三本书是否已被勾选。",
          "sampleValue": true
        }
      },
      {
        "id": {
          "type": "string",
          "description": "第四本书的选项标识。",
          "sampleValue": "book-004"
        },
        "title": {
          "type": "string",
          "description": "第四本可勾选书目标题。",
          "sampleValue": "瓦尔登湖"
        },
        "selected": {
          "type": "boolean",
          "description": "第四本书是否已被勾选。",
          "sampleValue": false
        }
      }
    ]
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_music.png",
      "description": "音乐图形素材，适合用于听书或歌单卡片的背景氛围识别，主色为彩色媒体图标。",
      "bindTo": "/assets/coverSrc"
