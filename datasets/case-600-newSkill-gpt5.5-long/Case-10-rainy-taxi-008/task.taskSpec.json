{
  "userQuery": "雨天叫车那张卡片再改一版，图标要够大视觉冲击力要足，左边一个大雨云+雨滴的图标做主体，右侧分几个不同底色的小区显示温度、湿度、当前排队数。要能勾选同时呼叫多个打车App，再加个开关让我一键打开\"勿扰模式\"这样司机来电不响铃但能震。下面再做一个可滚动的车辆类型列表（快车/优享/豪华车这些），等五分钟没接单红色告警给我高亮标出来。整体用那种橙红到深紫的紧迫渐变。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前叫车位置所在区县名称",
            "sampleValue": "雨花台"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "22℃"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比",
            "sampleValue": 88
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "小雨"
          }
        }
      }
    },
    "asset": {
      "rainIcon": {
        "type": "string",
        "description": "雨云和雨滴主视觉图标路径",
        "sampleValue": "resources/base/media/rain.png"
      }
    },
    "taxi": {
      "queueText": {
        "type": "string",
        "description": "当前排队数量展示文本",
        "sampleValue": "排6"
      },
      "appA": {
        "label": {
          "type": "string",
          "description": "第一个已勾选打车应用短名称",
          "sampleValue": "滴滴"
        },
        "selected": {
          "type": "boolean",
          "description": "第一个打车应用是否参与同时呼叫",
          "sampleValue": true
        }
      },
      "appB": {
        "label": {
          "type": "string",
          "description": "第二个已勾选打车应用短名称",
          "sampleValue": "高德"
        },
        "selected": {
          "type": "boolean",
          "description": "第二个打车应用是否参与同时呼叫",
          "sampleValue": true
        }
      },
      "dnd": {
        "label": {
          "type": "string",
          "description": "勿扰模式开关短标签",
          "sampleValue": "勿扰"
        },
        "enabled": {
          "type": "boolean",
          "description": "司机来电不响铃但震动的勿扰模式是否开启",
          "sampleValue": true
        }
      },
      "vehicleTypes": [
        {
          "name": {
            "type": "string",
            "description": "第一种车辆类型名称",
            "sampleValue": "快车"
          }
        },
        {
          "name": {
            "type": "string",
            "description": "第二种车辆类型名称",
            "sampleValue": "优享"
          }
        },
        {
          "name": {
            "type": "string",
            "description": "第三种车辆类型名称",
            "sampleValue": "豪华"
          }
        }
      ],
      "alertText": {
        "type": "string",
        "description": "五分钟未接单红色告警文本",
        "sampleValue": "5分告警"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合的彩色天气图标，适合雨天出行和打车卡片主视觉。",
      "bindTo": "/asset/rainIcon"
    }
  ]
}
