{
  "userQuery": "每次等大件快递都焦虑到不行,想做个快递物流卡片安抚下自己。顶部放超大倒计时\"还有X小时送达\"这种大号信息,下方可滚动列表是所有包裹,每条前有勾选框,签收完点掉,要能跳音乐App歌单放点轻音乐。背景用浅米色,渐变从傍晚过渡到深夜那种,已签收的用绿色包裹已签收小图标,再加个天气显示,下雨天取件更烦。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hwmusic://com.huawei.hmsapp.music/showMusicList?code=a001&type=4"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "express": {
        "countdownText": {
          "type": "string",
          "description": "距离最近一个大件包裹预计送达的倒计时展示文本。",
          "sampleValue": "还有6小时"
        },
        "etaCaption": {
          "type": "string",
          "description": "倒计时下方的送达说明短文本。",
          "sampleValue": "预计送达"
        },
        "packageSummary": {
          "type": "string",
          "description": "当前待关注包裹总数摘要。",
          "sampleValue": "3个包裹"
        },
        "weatherPickupTip": {
          "type": "string",
          "description": "结合天气给出的取件安抚提示。",
          "sampleValue": "下雨带伞"
        },
        "packages": {
          "type": "array",
          "description": "当前关注的包裹列表，按预计送达或关注优先级排序。",
          "sampleValue": [
            {
              "title": "洗衣机",
              "status": "派送中",
              "signed": false
            },
            {
              "title": "收纳柜",
              "status": "已签收",
              "signed": true
            },
            {
              "title": "床垫",
              "status": "运输中",
              "signed": false
            }
          ],
          "items": {
            "type": "object",
            "description": "单个包裹的卡片展示字段。",
            "properties": {
              "title": {
                "type": "string",
                "description": "包裹名称或简短识别名。",
                "sampleValue": "洗衣机"
              },
              "status": {
                "type": "string",
                "description": "包裹当前物流状态。",
                "sampleValue": "派送中"
              },
              "signed": {
                "type": "boolean",
                "description": "包裹是否已签收。",
                "sampleValue": false
              }
            }
          }
        }
      },
      "weather": {
        "current": {
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "小雨"
          },
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "24°C"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/courier_box.png",
      "description": "彩色快递箱子图标，适合用于物流包裹识别和已签收状态提示。"
    },
    {
      "src": "resources/base/media/rain.png",
      "description": "彩色云朵和雨滴天气图标，适合用于下雨取件提醒。"
    },
    {
      "src": "resources/base/media/music_fill.svg",
      "description": "黑色音乐音符实心图标，适合用于轻音乐歌单入口。"
    }
  ]
