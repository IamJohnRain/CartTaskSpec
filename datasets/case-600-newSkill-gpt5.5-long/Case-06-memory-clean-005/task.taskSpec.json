{
  "userQuery": "做个主题色背景带倒计时渐变的内存清理卡片吧，我手机总是晚上发现内存不够，所以卡片要体现出那种临近阈值的风险告警状态，用分隔线把空间、电量和应用占用这三个数据区块分开，里面加上代表垃圾清理的语义小图标，各项数据纵向列出来，点击就能去系统设置里清理存储。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "card": {
      "title": {
        "type": "string",
        "description": "卡片服务对象标题",
        "sampleValue": "内存清理"
      },
      "subtitle": {
        "type": "string",
        "description": "夜间存储风险提示",
        "sampleValue": "夜间存储风险"
      }
    },
    "asset": {
      "cleanIcon": {
        "type": "string",
        "description": "垃圾清理语义图标素材路径",
        "sampleValue": "resources/base/media/icon_clear.png"
      }
    },
    "countdown": {
      "label": {
        "type": "string",
        "description": "倒计时状态标签",
        "sampleValue": "临界"
      },
      "valueText": {
        "type": "string",
        "description": "距离建议清理时机的倒计时展示文本",
        "sampleValue": "18分"
      }
    },
    "memory": {
      "riskPercentText": {
        "type": "string",
        "description": "内存或存储风险占用比例展示文本",
        "sampleValue": "86%"
      },
      "caption": {
        "type": "string",
        "description": "接近阈值的风险告警说明",
        "sampleValue": "阈值将满"
      },
      "riskValue": {
        "type": "number",
        "description": "风险进度当前值",
        "sampleValue": 86
      },
      "riskTotal": {
        "type": "number",
        "description": "风险进度总值",
        "sampleValue": 100
      }
    },
    "metrics": {
      "storage": {
        "label": {
          "type": "string",
          "description": "空间区块标签",
          "sampleValue": "空间"
        },
        "valueText": {
          "type": "string",
          "description": "剩余存储空间展示值",
          "sampleValue": "17GB"
        },
        "detailText": {
          "type": "string",
          "description": "空间区块辅助状态",
          "sampleValue": "剩余"
        }
      },
      "battery": {
        "label": {
          "type": "string",
          "description": "电量区块标签",
          "sampleValue": "电量"
        },
        "valueText": {
          "type": "string",
          "description": "当前电量展示值",
          "sampleValue": "22%"
        },
        "detailText": {
          "type": "string",
          "description": "电量区块辅助状态",
          "sampleValue": "低电"
        }
      },
      "apps": {
        "label": {
          "type": "string",
          "description": "应用占用区块标签",
          "sampleValue": "应用"
        },
        "valueText": {
          "type": "string",
          "description": "高占用应用缓存展示值",
          "sampleValue": "18GB"
        },
        "detailText": {
          "type": "string",
          "description": "应用占用来源说明",
          "sampleValue": "微信"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适合表达垃圾清理、缓存清理和存储释放入口。",
      "bindTo": "/asset/cleanIcon"
    }
  ]
}
