{
  "userQuery": "文字为主的菜价卡,显示今日均价,能点进某个买菜日程,读天气数据,分区不同底色,环境氛围渐变,价格高标注意,文字字符做图标,纵向排几项。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/0/entityId} }}"
        }
      }
    }
  ],
  "dataModelSchema": {
    "price": {
      "marketName": {
        "type": "string",
        "description": "菜价比价的市场或区域名称",
        "sampleValue": "附近菜场"
      },
      "averagePriceValue": {
        "type": "string",
        "description": "今日蔬菜均价的数值部分",
        "sampleValue": "4.8"
      },
      "unitText": {
        "type": "string",
        "description": "菜价均价单位",
        "sampleValue": "元/斤"
      },
      "warningText": {
        "type": "string",
        "description": "价格偏高时的简短注意提示",
        "sampleValue": "青椒高于均价"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询区县名称",
            "sampleValue": "青浦区"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询城市名称",
            "sampleValue": "上海市"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          }
        }
      },
      "calendar": {
        "items": {
          "type": "array",
          "description": "今日买菜相关日程列表",
          "sampleValue": [
            {
              "entityId": "calendar-veggie-001",
              "title": "买菜"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程唯一标识符",
                "sampleValue": "calendar-veggie-001"
              },
              "title": {
                "type": "string",
                "description": "日程标题",
                "sampleValue": "买菜"
              },
              "dtStart": {
                "type": "string",
                "description": "日程开始时间",
                "sampleValue": "17:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "日程结束时间",
                "sampleValue": "18:10"
              }
            }
          }
        }
      }
    }
  },
  "assetCandidates": []
}
