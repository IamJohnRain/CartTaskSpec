{
  "userQuery": "智能家居天气预警列表卡,纵向重复排列多个城市的预警信息(暴雨/大风/高温),以固定静态文案为主。每项右边带个按钮跳到系统存储设置(管理本地天气缓存)。分区不同底色,整体加氛围背景,渐变要那种运动/紧迫动作的感觉(橙红到深紫),文字字符做图标,不用特殊状态色。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
