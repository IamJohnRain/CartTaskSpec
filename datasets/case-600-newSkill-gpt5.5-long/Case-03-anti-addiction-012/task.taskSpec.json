{
  "userQuery": "做个防沉迷卡片，整张卡都要铺满我们手机的主题色背景，最上面用超大字号显示今日已亮屏“6.5小时”这个动态数据。下面横向排列几个不同的管控项目，如果今天的健康步数达标了，就显示绿色的“目标已达成”正向状态，旁边带个对勾图标。再加点那种很像扫地机器人清理进度的紧迫感渐变色，右上角同步下我的日历日程，点卡片空白处能进系统设置改应用时长限制。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "metrics": {
      "screenTime": {
        "caption": {
          "type": "string",
          "description": "今日亮屏时长标题",
          "sampleValue": "今日已亮屏"
        },
        "valueText": {
          "type": "string",
          "description": "今日累计亮屏时长展示值",
          "sampleValue": "6.5小时"
        },
        "progress": {
          "type": "number",
          "description": "今日亮屏时长相对使用限制的进度值",
          "sampleValue": 65
        },
        "limitTotal": {
          "type": "number",
          "description": "亮屏时长进度条总量",
          "sampleValue": 100
        }
      }
    },
    "controls": {
      "shortVideo": {
        "label": {
          "type": "string",
          "description": "短视频管控项目短标签",
          "sampleValue": "短视频"
        }
      },
      "limit": {
        "label": {
          "type": "string",
          "description": "应用时长限额管控项目短标签",
          "sampleValue": "限额"
        }
      },
      "focus": {
        "label": {
          "type": "string",
          "description": "专注或休息管控项目短标签",
          "sampleValue": "休息"
        }
      }
    },
    "health": {
      "steps": {
        "reached": {
          "type": "boolean",
          "description": "今日健康步数是否达标",
          "sampleValue": true
        },
        "statusText": {
          "type": "string",
          "description": "健康步数达标后的正向状态文案",
          "sampleValue": "目标已达成"
        },
        "statusColor": {
          "type": "string",
          "description": "健康步数达标状态色，达标时为确认绿色",
          "sampleValue": "#ff64bb5c"
        }
      }
    },
    "data": {
      "calendar": {
        "items": [
          {
            "entityName": {
              "type": "string",
              "description": "日程实体类别",
              "sampleValue": "calendar"
            },
            "entityId": {
              "type": "string",
              "description": "日程唯一标识符",
              "sampleValue": "calendar-demo-001"
            },
            "title": {
              "type": "string",
              "description": "今日下一条日程标题",
              "sampleValue": "产品评审"
            },
            "dtStart": {
              "type": "string",
              "description": "今日下一条日程开始时间",
              "sampleValue": "09:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "今日下一条日程结束时间",
              "sampleValue": "10:00"
            }
          }
        ]
      }
    }
  },
