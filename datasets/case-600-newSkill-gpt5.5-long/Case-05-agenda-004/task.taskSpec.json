{
  "userQuery": "我是个户外摄影的，天天在外面跑。帮我弄个纵向堆叠信息的磨砂卡片，背景带点那种冲锋跑动的橙红紧迫渐变。最上面显示天气数据“当前湿度45%”和“电量剩余20%”，下面弄个能滚动的列表展示今天的拍摄日历日程，用文字和色块区分上午下午就行，点一下列表最底下的设置区域能跳到系统电量管理里面去开省电模式。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "current": {
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比，用于显示户外拍摄环境的湿度。",
            "sampleValue": 45
          }
        }
      },
      "device": {
        "battery": {
          "remainingPercent": {
            "type": "number",
            "description": "当前设备剩余电量百分比，用于提示户外拍摄时的续航状态。",
            "sampleValue": 20
          }
        }
      },
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
