              "type": "string",
              "description": "日程项唯一标识符。",
              "sampleValue": "photo-pm-001"
            },
            "dtStart": {
              "type": "string",
              "description": "今天拍摄日程的开始时间。",
              "sampleValue": "14:30"
            },
            "title": {
              "type": "string",
              "description": "今天拍摄日程标题。",
              "sampleValue": "林线夕光取景"
