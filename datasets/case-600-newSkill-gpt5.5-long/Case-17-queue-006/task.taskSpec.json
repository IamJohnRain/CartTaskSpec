{
  "userQuery": "叫号倒计时卡片，纯文字和色块不要图片。背景叠加图层（夜空渐变+前景超大号数字），环形进度中心叠数字。动态数值变化（倒计时秒数），点卡片跳系统设置（应用时长控制），读取日历日程。简洁表面，临近叫号要红色风险提示，倒计时夜晚渐变。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日历日程唯一标识符，用于端侧识别叫号相关日程。",
              "sampleValue": "calendar_queue_001"
            },
            "title": {
              "type": "string",
              "description": "下一条排队叫号相关日程标题。",
              "sampleValue": "A17号排队"
            },
            "dtStart": {
              "type": "string",
              "description": "叫号日程开始时间，当天日程使用 HH:MM 格式。",
              "sampleValue": "20:45"
            },
            "eventLocation": {
              "type": "string",
              "description": "叫号或排队所在窗口、地点或队列位置。",
              "sampleValue": "3号窗口"
            }
          }
        ]
      }
    },
    "queue": {
      "countdownSeconds": {
        "type": "number",
        "description": "距离预计叫号剩余秒数，用于环形进度动态变化。",
        "sampleValue": 28
      },
      "countdownTotal": {
        "type": "number",
        "description": "倒计时进度参考总秒数。",
        "sampleValue": 60
      },
      "countdownText": {
        "type": "string",
        "description": "环形进度中心展示的倒计时秒数字符串。",
        "sampleValue": "28"
      },
      "watermarkNumber": {
        "type": "string",
        "description": "叠加在夜空渐变上的前景超大号倒计时数字。",
        "sampleValue": "28"
      },
      "riskText": {
        "type": "string",
        "description": "临近叫号时的风险提示短文案。",
        "sampleValue": "临近叫号"
      },
      "riskBgColor": {
        "type": "string",
        "description": "风险提示色块背景色，临近叫号时使用红色风险色。",
        "sampleValue": "#ffe84026"
      },
      "progressColor": {
        "type": "string",
        "description": "环形进度高亮颜色，临近叫号时使用红色风险色。",
        "sampleValue": "#ffe84026"
      }
    }
  },
  "assetCandidates": []
}
