{
  "userQuery": "做个清理状态的卡片，背景弄个清新的整体氛围图，上面横着排几个内存数据，比如“可用空间12GB”，配个存储已满的警告图标，如果明天的日历日程里有开会提醒，就把晚上的电量数据也显示出来，点卡片能直接跳到系统存储设置里去。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "card": {
      "title": {
        "type": "string",
        "description": "卡片主标题，表达当前服务对象为手机清理状态。",
        "sampleValue": "清理状态"
      }
    },
    "storage": {
      "freeLabel": {
        "type": "string",
        "description": "可用存储空间的短标签。",
        "sampleValue": "可用空间"
      },
      "freeValue": {
        "type": "string",
        "description": "当前可用存储空间展示值。",
        "sampleValue": "12GB"
      },
      "usedLabel": {
        "type": "string",
        "description": "已用存储空间比例的短标签。",
        "sampleValue": "已用空间"
      },
      "usedValue": {
        "type": "string",
        "description": "当前已用存储空间比例展示值。",
        "sampleValue": "96%"
      },
      "warningText": {
        "type": "string",
        "description": "无会议提醒时用于提示存储接近满载的短状态。",
        "sampleValue": "存储满"
      }
    },
    "calendar": {
      "hasMeetingReminder": {
        "type": "boolean",
        "description": "明日日历日程中是否存在会议提醒，用于决定是否展示晚间电量数据。",
        "sampleValue": true
      }
    },
    "battery": {
      "eveningText": {
        "type": "string",
        "description": "明日日历存在会议提醒时展示的晚间电量短文本。",
        "sampleValue": "晚间68%"
      }
    },
    "asset": {
      "ambientImage": {
        "type": "string",
        "description": "清理状态氛围背景图素材路径。",
        "sampleValue": "resources/base/media/icon_clear.png"
      },
      "warningIcon": {
        "type": "string",
        "description": "存储接近满载时使用的存储设备警告图标素材路径。",
        "sampleValue": "resources/base/media/externaldrive_fill.svg"
      },
      "batteryIcon": {
        "type": "string",
        "description": "晚间电量数据旁使用的电池图标素材路径。",
        "sampleValue": "resources/base/media/icon_electricity.png"
      }
    },
    "action": {
      "label": {
        "type": "string",
        "description": "跳转到系统存储设置的短按钮文案。",
        "sampleValue": "设置"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标素材，适合清理无忧、内存清理等场景，可作为清新清理氛围背景图。",
      "bindTo": "/asset/ambientImage"
    },
    {
      "src": "resources/base/media/externaldrive_fill.svg",
      "description": "外置存储设备实心图标，适合表达本地存储管理、存储空间接近满载的警告状态。",
      "bindTo": "/asset/warningIcon"
    },
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "电池图标素材，适合低电模式或晚间电量数据展示。",
      "bindTo": "/asset/batteryIcon"
    }
  ]
}
