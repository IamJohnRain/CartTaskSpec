{
  "userQuery": "来个简洁的喂食卡,左边环形\"今日已喂 X 次\",右边横向排三个开关图标(自动出粮、勿扰时段、低粮推送),点开关能切系统勿扰,顶上一行天气,别用渐变,图标用粮桶、铃铛、月亮这种语义图标。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气所在区县名称",
            "sampleValue": "南山"
          }
        },
        "current": {
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          },
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "26°C"
          }
        }
      }
    },
    "feeder": {
      "fedCount": {
        "type": "number",
        "description": "今日已经完成的喂食次数",
        "sampleValue": 3
      },
      "dailyTarget": {
        "type": "number",
        "description": "今日计划喂食总次数，用于环形进度总量",
        "sampleValue": 5
      },
      "switches": {
        "autoFeed": {
          "statusText": {
            "type": "string",
            "description": "自动出粮开关当前状态展示文本",
            "sampleValue": "开"
          }
        },
        "doNotDisturb": {
          "statusText": {
            "type": "string",
            "description": "勿扰时段开关当前状态展示文本",
            "sampleValue": "开"
          }
        },
        "lowFoodPush": {
          "statusText": {
            "type": "string",
            "description": "低粮推送开关当前状态展示文本",
            "sampleValue": "开"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "彩色多云天气图标，适合用于顶部天气状态识别。"
    },
    {
      "src": "resources/base/media/alarm_fill_1.svg",
      "description": "带铃铛的闹钟实心图标，适合表达自动出粮或定时喂食开关。"
    },
    {
      "src": "resources/base/media/moon_circle_fill.svg",
      "description": "月亮圆形实心图标，适合表达勿扰时段或夜间模式开关。"
    },
    {
      "src": "resources/base/media/bell_fill.svg",
      "description": "铃铛实心图标，适合表达低粮推送或通知提醒开关。"
    }
  ]
}
