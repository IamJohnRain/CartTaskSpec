{
  "userQuery": "给爸妈做个雨天打车卡片，整张深蓝主题色背景，最上面一把大雨伞图标当主视觉，中间嵌一块小面板显示日历里今天的日程（他们要去医院复查），右上角天气图标点进去看详细天气，下面是几个平台勾选项（滴滴/高德/曹操），要是所有平台都没人接单伞图标变红告警，背景雨夜渐变氛围拉满。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "title": {
              "type": "string",
              "description": "今天日历中需要展示的日程标题。",
              "sampleValue": "医院复查"
            },
            "dtStart": {
              "type": "string",
              "description": "今天日程的开始时间，格式为 HH:MM。",
              "sampleValue": "09:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "今天日程的结束时间，格式为 HH:MM。",
              "sampleValue": "10:30"
            }
          }
        ]
      }
    },
    "ui": {
      "assets": {
        "umbrellaIcon": {
          "type": "string",
          "description": "雨天打车主视觉雨伞图标素材路径。",
          "sampleValue": "resources/base/media/icon_weather1.png"
        },
        "weatherIcon": {
          "type": "string",
          "description": "右上角天气详情入口图标素材路径。",
          "sampleValue": "resources/base/media/icon_weathe2.png"
        }
      },
      "alertFillColor": {
        "type": "string",
        "description": "所有平台无人接单时用于雨伞主视觉底板的告警红色。",
        "sampleValue": "#ffed6f21"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_weather1.png",
      "description": "天气/雨伞图标，适合亲人关怀与雨天出行主视觉，可用于雨伞状态识别。",
      "bindTo": "/ui/assets/umbrellaIcon"
    },
    {
      "src": "resources/base/media/icon_weathe2.png",
      "description": "天气图标，适合雨天打车卡片右上角天气详情入口。",
      "bindTo": "/ui/assets/weatherIcon"
    }
  ]
}
