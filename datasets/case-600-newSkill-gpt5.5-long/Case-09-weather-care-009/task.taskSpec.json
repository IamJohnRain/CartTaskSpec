{
  "userQuery": "帮我弄个磨砂玻璃效果的天气卡片，整体背景用那种晨曦微光的渐变，视觉中间就放个巨大的天气语义图标。我要能直接点这个卡片跳转到天气APP里看详细数据。卡片上弄个备忘勾选框，双绑一下状态，要是今天适合出门散步，勾选框旁边就直接亮起绿色的“适宜外出”正向状态。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "current": {
          "condition": {
            "type": "string",
            "description": "当前天气现象，用于卡片顶部短状态展示。",
            "sampleValue": "多云"
          },
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "24°C"
          }
        }
      }
    },
    "asset": {
      "weatherIcon": {
        "type": "string",
        "description": "天气语义主图标资源路径，取自素材白名单。",
        "sampleValue": "resources/base/media/cloudy_turning_sunny.png"
      }
    },
    "memo": {
      "walkChecked": {
        "type": "boolean",
        "description": "散步备忘勾选状态，用于 Checkbox 的双向状态绑定。",
        "sampleValue": true
      }
    },
    "care": {
      "walkStatusText": {
        "type": "string",
        "description": "今日散步适宜性的正向状态文案。",
        "sampleValue": "适宜外出"
      },
      "walkStatusColor": {
        "type": "string",
        "description": "散步适宜时的确认状态色。",
        "sampleValue": "#ff64bb5c"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy_turning_sunny.png",
      "description": "小云朵和太阳组合的彩色天气图标，适合表达晨曦、多云转晴和出行天气语义。",
      "bindTo": "/asset/weatherIcon"
    }
  ]
}
