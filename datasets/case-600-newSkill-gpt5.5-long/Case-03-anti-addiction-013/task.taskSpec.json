{
  "userQuery": "给孩子弄个作息防沉迷管控卡片，配上夜晚时间相关的渐变背景。里面弄个小内嵌面板块，结合日历日程的作业清单，上面要有“距离强制关机还有60分”这种文字，带有风险提醒状态。下面弄几个可勾选的选项比如“做完作业解锁”、“吃完饭解锁”，只要不勾选就直接跳转系统设置里的屏幕时间管理强制锁屏。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "control": {
      "countdownText": {
        "type": "string",
        "description": "距离强制关机的倒计时展示文案。",
        "sampleValue": "距离强制关机还有60分"
      },
      "riskStatus": {
        "type": "string",
        "description": "当前防沉迷管控风险状态。",
        "sampleValue": "风险提醒"
      },
      "riskDetail": {
        "type": "string",
        "description": "未完成解锁条件时的锁屏提醒。",
        "sampleValue": "未完成将锁屏"
      },
      "screenTimeHint": {
        "type": "string",
        "description": "跳转屏幕时间管理的辅助提示。",
        "sampleValue": "未勾选跳转屏幕时间管理"
      },
      "homeworkDone": {
        "type": "boolean",
        "description": "做完作业解锁选项是否已勾选。",
        "sampleValue": false
      },
      "dinnerDone": {
        "type": "boolean",
        "description": "吃完饭解锁选项是否已勾选。",
        "sampleValue": false
      }
    },
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符。",
              "sampleValue": "homework-001"
            },
            "title": {
              "type": "string",
              "description": "作业日程标题。",
              "sampleValue": "数学作业"
            },
            "dtStart": {
              "type": "string",
              "description": "作业日程开始时间，今天内为 HH:MM。",
              "sampleValue": "19:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "作业日程结束时间，今天内为 HH:MM。",
              "sampleValue": "20:10"
            }
          },
          {
            "entityId": {
              "type": "string",
              "description": "第二条日程项唯一标识符。",
              "sampleValue": "homework-002"
            },
            "title": {
              "type": "string",
              "description": "第二条作业日程标题。",
              "sampleValue": "英语背诵"
            },
            "dtStart": {
              "type": "string",
              "description": "第二条作业日程开始时间，今天内为 HH:MM。",
              "sampleValue": "20:15"
            },
            "dtEnd": {
              "type": "string",
              "description": "第二条作业日程结束时间，今天内为 HH:MM。",
              "sampleValue": "20:35"
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_timing.png",
      "description": "防沉迷计时图标，适合表达应用时长、倒计时和屏幕时间管控。"
    },
    {
      "src": "resources/base/media/icon_schedule.png",
      "description": "日程彩色图标，适合表达当日作业安排和日程清单。"
    }
  ]
}
