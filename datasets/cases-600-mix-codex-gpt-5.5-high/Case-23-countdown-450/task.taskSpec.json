      },
      "data": {
        "calendar": {
          "items": [
            {
              "entityName": "calendar",
              "entityId": "calendar_placeholder",
              "title": "纪念日",
              "dtStart": "00:00",
              "dtEnd": "23:59",
              "importantEventType": 2
            }
          ]
        }
      },
      "state": {
        "loading": true,
        "completed": true
      }
    }
  },
  "assetCandidates": [
    {
      "assetRef": "schedule_icon",
      "src": "resources/base/media/icon_schedule.png",
      "use": "calendar glyph",
      "description": "日程图标素材，适合表达日历读取、纪念日和倒计时入口。",
      "bindTo": "/asset/scheduleIcon",
      "static": true
    }
  ]
