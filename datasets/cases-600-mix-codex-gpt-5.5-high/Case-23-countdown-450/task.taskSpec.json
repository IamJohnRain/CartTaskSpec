{
  "userQuery": "帮我弄个倒计时卡片,数字放背景图上,点一下能进系统,能读日历,要看到已完成",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": {
            "path": "/data/calendar/items/0/entityId"
          }
        }
      }
    }
  ],
  "dataModel": {
    "value": {
