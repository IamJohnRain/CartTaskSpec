{
  "userQuery": "做一张存储清理卡,横向排几个勾选项(清理缓存、清空回收站、压缩旧照片、卸载不常用应用),每个都能勾选双向绑定。点\"前往设置\"按钮能跳系统存储设置。卡片简洁素净有点整体氛围背景,适合夜晚渐变,可以用素材库里的语义图标(电池、文件夹、清扫)。纯静态示例数据,不用特殊状态色。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "title": {
      "type": "string",
      "description": "卡片标题",
      "sampleValue": "存储清理"
    },
    "subtitle": {
      "type": "string",
      "description": "卡片辅助说明",
      "sampleValue": "夜间轻量整理建议"
    },
    "summary": {
      "type": "string",
      "description": "当前可勾选项目数量摘要",
      "sampleValue": "4项可选"
    },
    "helperText": {
      "type": "string",
      "description": "底部操作前提示",
      "sampleValue": "清理前请确认备份"
    },
    "actionLabel": {
      "type": "string",
      "description": "跳转系统存储设置的按钮文案",
      "sampleValue": "前往设置"
    },
    "iconSrc": {
      "type": "string",
      "description": "清扫语义图标素材路径",
      "sampleValue": "resources/base/media/clean_fill.svg"
    },
    "cleanup": {
      "options": [
        {
          "label": {
            "type": "string",
            "description": "清理缓存选项标签",
            "sampleValue": "清理缓存"
          },
          "shortLabel": {
            "type": "string",
            "description": "清理缓存选项短标签",
            "sampleValue": "缓存"
          },
          "value": {
            "type": "string",
            "description": "清理缓存选项值",
            "sampleValue": "cache"
          },
          "selected": {
            "type": "boolean",
            "description": "清理缓存选项是否勾选",
            "sampleValue": true
          }
        },
        {
          "label": {
            "type": "string",
            "description": "清空回收站选项标签",
            "sampleValue": "清空回收站"
          },
          "shortLabel": {
            "type": "string",
            "description": "清空回收站选项短标签",
            "sampleValue": "回收站"
          },
          "value": {
            "type": "string",
            "description": "清空回收站选项值",
            "sampleValue": "recycle"
          },
          "selected": {
            "type": "boolean",
            "description": "清空回收站选项是否勾选",
            "sampleValue": false
          }
        },
        {
          "label": {
            "type": "string",
            "description": "压缩旧照片选项标签",
            "sampleValue": "压缩旧照片"
          },
          "shortLabel": {
            "type": "string",
            "description": "压缩旧照片选项短标签",
            "sampleValue": "旧照片"
          },
          "value": {
            "type": "string",
            "description": "压缩旧照片选项值",
            "sampleValue": "photos"
          },
          "selected": {
            "type": "boolean",
            "description": "压缩旧照片选项是否勾选",
            "sampleValue": true
          }
        },
        {
          "label": {
            "type": "string",
            "description": "卸载不常用应用选项标签",
            "sampleValue": "卸载不常用应用"
          },
          "shortLabel": {
            "type": "string",
            "description": "卸载不常用应用选项短标签",
            "sampleValue": "少用应用"
          },
          "value": {
            "type": "string",
            "description": "卸载不常用应用选项值",
            "sampleValue": "unused_apps"
          },
          "selected": {
            "type": "boolean",
            "description": "卸载不常用应用选项是否勾选",
            "sampleValue": false
          }
        }
      ]
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/clean_fill.svg",
      "description": "清洁实心图标，适合存储清理、缓存整理等清扫语义入口。",
      "bindTo": "/iconSrc"
    }
  ]
}
