{
  "userQuery": "给我做个小孩周末防沉迷卡片，表面简洁素净，带个整体氛围背景。卡片上要读取周末天气数据，把玩游戏、看动画片、听故事这几个选项横向排成一排，每个旁边带个勾选框做双向绑定，一旦总时长临近设定的2小时风险阈值，就在旁边亮起一个沙漏语义图标提醒注意。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "周末天气查询的区县名称",
            "sampleValue": "朝阳区"
          }
        },
        "daily": [
          {
            "weekday": {
              "type": "string",
              "description": "周末预报对应星期文本",
              "sampleValue": "周六"
            },
            "condition": {
              "type": "string",
              "description": "周末白天天气现象",
              "sampleValue": "多云"
            },
            "temperatureRangeText": {
              "type": "string",
              "description": "周末温度范围展示文本",
              "sampleValue": "22°/29°"
            }
          }
        ]
      }
    },
    "usage": {
      "title": {
        "type": "string",
        "description": "卡片标题",
        "sampleValue": "周末防沉迷"
      },
      "usedMinutesText": {
        "type": "string",
        "description": "当前已安排屏幕娱乐总时长文本",
        "sampleValue": "105分钟"
      },
      "thresholdText": {
        "type": "string",
        "description": "家长设定的风险阈值文本",
        "sampleValue": "2小时"
      },
      "riskTip": {
        "type": "string",
        "description": "临近阈值时的提醒短文案",
        "sampleValue": "临近上限"
      }
    },
    "activities": {
      "gameSelected": {
        "type": "boolean",
        "description": "玩游戏选项是否选中",
        "sampleValue": true
      },
      "cartoonSelected": {
        "type": "boolean",
        "description": "看动画片选项是否选中",
        "sampleValue": true
      },
      "storySelected": {
        "type": "boolean",
        "description": "听故事选项是否选中",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_timing.png",
      "description": "防沉迷计时图标，可作为卡片标题旁的轻量识别素材。"
    },
    {
      "src": "resources/base/media/hourglass_fill.svg",
      "description": "沙漏语义图标，适合在应用时长临近阈值时做风险提醒。"
    }
  ]
}
