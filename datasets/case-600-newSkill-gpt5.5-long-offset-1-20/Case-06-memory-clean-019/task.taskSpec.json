{
  "userQuery": "给我做个全主题色背景的内存优化卡片，里面嵌套两个小面板。左边实时显示天气状况和手机电量百分比，右边横向排几个待清理的相册、应用缓存项，每个项目前面带个勾选框能让我手动选。再给加个一键开启省电模式的开关，整体加点黑紫色的夜间倒计时渐变风，图标用你库里自带的就行。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名称",
            "sampleValue": "青浦"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "24°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          }
        }
      }
    },
    "device": {
      "batteryPercent": {
        "type": "string",
        "description": "手机当前电量百分比展示文本",
        "sampleValue": "68%"
      }
    },
    "cleanup": {
      "album": {
        "label": {
          "type": "string",
          "description": "待清理相册项名称",
          "sampleValue": "相册"
        },
        "selected": {
          "type": "boolean",
          "description": "相册清理项是否被选中",
          "sampleValue": true
        }
      },
      "cache": {
        "label": {
          "type": "string",
          "description": "待清理应用缓存项名称",
          "sampleValue": "缓存"
        },
        "selected": {
          "type": "boolean",
          "description": "应用缓存清理项是否被选中",
          "sampleValue": true
        }
      }
    },
    "power": {
      "modeLabel": {
        "type": "string",
        "description": "开启省电模式动作的短标签",
        "sampleValue": "省电开"
      }
    },
    "asset": {
      "weatherIcon": {
        "type": "string",
        "description": "天气图标素材路径",
        "sampleValue": "resources/base/media/cloudy.png"
      },
      "powerIcon": {
        "type": "string",
        "description": "省电图标素材路径",
        "sampleValue": "resources/base/media/icon_save_power.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色云朵天气图标，可用于天气状态识别。",
      "bindTo": "/asset/weatherIcon"
    },
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，可用于省电模式动作识别。",
      "bindTo": "/asset/powerIcon"
    }
  ]
}
