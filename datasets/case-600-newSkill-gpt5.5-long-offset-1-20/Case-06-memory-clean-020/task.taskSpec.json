{
  "userQuery": "帮我弄个上下堆叠的存储空间卡片，按那种图片延伸出的科技风来做，数据先用静态示例就行，中间放个大大的仪表盘环形占比图。要是存储空间到了要注意的风险状态就给我用渐变色高亮，背景加点清理加速的渐变效果，配上你们的扫描图标，横着多排几个“清理微信”“清理相册”的选项，点进去能跳到系统存储设置。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "storage": {
      "title": {
        "type": "string",
        "description": "存储空间卡片标题",
        "sampleValue": "存储空间"
      },
      "statusText": {
        "type": "string",
        "description": "当前存储风险状态提示",
        "sampleValue": "空间偏紧"
      },
      "usedPercentText": {
        "type": "string",
        "description": "已使用存储空间百分比展示文本",
        "sampleValue": "88%"
      },
      "usedPercent": {
        "type": "number",
        "description": "已使用存储空间百分比数值",
        "sampleValue": 88
      },
      "totalPercent": {
        "type": "number",
        "description": "仪表盘总百分比数值",
        "sampleValue": 100
      },
      "detailText": {
        "type": "string",
        "description": "存储容量使用情况摘要",
        "sampleValue": "已用 225GB / 256GB"
      },
      "suggestion": {
        "type": "string",
        "description": "清理建议短提示",
        "sampleValue": "建议立即清理缓存"
      },
      "ringColor": {
        "type": "string",
        "description": "风险状态下仪表盘高亮色",
        "sampleValue": "#ffe84026"
      }
    },
    "asset": {
      "scanIcon": {
        "type": "string",
        "description": "扫描清理图标素材路径",
        "sampleValue": "resources/base/media/icon_clear.png"
      }
    },
    "actions": [
      {
        "label": {
          "type": "string",
          "description": "第一个清理入口文案",
          "sampleValue": "清理微信"
        }
      },
      {
        "label": {
          "type": "string",
          "description": "第二个清理入口文案",
          "sampleValue": "清理相册"
        }
      },
      {
        "label": {
          "type": "string",
          "description": "第三个清理入口文案",
          "sampleValue": "系统存储"
        }
      }
    ]
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适合用于存储扫描、缓存清理和加速清理入口。",
      "bindTo": "/asset/scanIcon"
    }
  ]
}
