{
  "userQuery": "手环昨晚充满电就戴着睡了，电池还有78%。帮我做个睡眠卡片横向排三个数据块：深睡时长、浅睡时长、清醒次数，每个块用不同底色。背景夜晚蓝紫渐变氛围，前景用环形进度中心叠数字。卡片右上角显示\"手环已连接\"，底部一个按钮点一下能跳到省电设置。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "sleep": {
      "title": {
        "type": "string",
        "description": "睡眠卡片标题",
        "sampleValue": "昨晚睡眠"
      },
      "deviceStatus": {
        "type": "string",
        "description": "手环连接状态展示文本",
        "sampleValue": "手环已连接"
      },
      "batteryText": {
        "type": "string",
        "description": "手环剩余电量展示文本",
        "sampleValue": "电池 78%"
      },
      "deepSleep": {
        "label": {
          "type": "string",
          "description": "深睡时长标签",
          "sampleValue": "深睡"
        },
        "valueText": {
          "type": "string",
          "description": "深睡时长展示值",
          "sampleValue": "2h18"
        },
        "progress": {
          "type": "number",
          "description": "深睡时长环形进度值",
          "sampleValue": 66
        }
      },
      "lightSleep": {
        "label": {
          "type": "string",
          "description": "浅睡时长标签",
          "sampleValue": "浅睡"
        },
        "valueText": {
          "type": "string",
          "description": "浅睡时长展示值",
          "sampleValue": "4h06"
        },
        "progress": {
          "type": "number",
          "description": "浅睡时长环形进度值",
          "sampleValue": 74
        }
      },
      "awake": {
        "label": {
          "type": "string",
          "description": "清醒次数标签",
          "sampleValue": "清醒"
        },
        "valueText": {
          "type": "string",
          "description": "清醒次数展示值",
          "sampleValue": "2次"
        },
        "progress": {
          "type": "number",
          "description": "清醒次数环形进度值",
          "sampleValue": 24
        }
      },
      "actionLabel": {
        "type": "string",
        "description": "进入省电设置的动作入口文案",
        "sampleValue": "省电设置"
      }
    },
    "asset": {
      "sleepIcon": {
        "type": "string",
        "description": "睡眠场景图标素材路径",
        "sampleValue": "resources/base/media/icon_sleep.png"
      },
      "savePowerIcon": {
        "type": "string",
        "description": "省电设置图标素材路径",
        "sampleValue": "resources/base/media/icon_save_power.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_sleep.png",
      "description": "睡眠图标，适合用于睡眠监督或睡眠追踪卡片的对象识别。",
      "bindTo": "/asset/sleepIcon"
    },
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，适合用于省电模式或电池设置入口的动作识别。",
      "bindTo": "/asset/savePowerIcon"
    }
  ]
}
