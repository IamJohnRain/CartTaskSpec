{
  "userQuery": "给小孩做学习管控卡片，左右分两个不同底色区域，左边信息区纵向排列着好几个受限的娱乐应用，比如游戏和视频，右侧动作区上方有醒目的红色“超时违规”状态。前面放些勾选框，勾选状态要能双向绑定，选中的应用会被直接锁掉。读取下日历行程，要是周末就留个跳转系统设置的按钮，让我能手动给他加点玩耍时长，纵向多列几个任务项方便挨个勾选。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "status": {
      "text": {
        "type": "string",
        "description": "学习管控当前风险状态",
        "sampleValue": "超时违规"
      }
    },
    "apps": {
      "type": "array",
