{
  "userQuery": "给我做个防沉迷卡片，背景素净点别太乱。左边放个环形仪表盘显示\"今日已用42分\"，中间塞几个可勾选的任务选项比如\"完成作业才能玩\"。如果时间快到了要让仪表盘变黄提示注意。顶部用太阳和云朵的天气图标，右上角点一下能跳系统设置改时长限制。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询所在区县名称。",
            "sampleValue": "青浦区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "26°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云转晴"
          }
        }
      }
    },
    "usage": {
      "title": {
        "type": "string",
        "description": "防沉迷卡片标题。",
        "sampleValue": "防沉迷"
      },
      "usedMinutes": {
        "type": "number",
        "description": "今日已使用时长，单位为分钟。",
        "sampleValue": 42
      },
      "limitMinutes": {
        "type": "number",
        "description": "今日允许使用总时长，单位为分钟。",
        "sampleValue": 60
      },
      "usedText": {
        "type": "string",
        "description": "今日已用时长展示文本。",
        "sampleValue": "今日已用42分"
      },
      "statusText": {
        "type": "string",
        "description": "剩余时长或临近限制提示。",
        "sampleValue": "快到时长"
      },
      "ringColor": {
        "type": "string",
        "description": "仪表盘进度颜色，临近时长限制时为提示黄色。",
        "sampleValue": "#f7ce00"
      },
      "task1Label": {
        "type": "string",
        "description": "第一项可勾选任务文案。",
        "sampleValue": "完成作业才能玩"
      },
      "task1Done": {
        "type": "boolean",
        "description": "第一项任务是否已完成。",
        "sampleValue": false
      },
      "task2Label": {
        "type": "string",
        "description": "第二项可勾选任务文案。",
        "sampleValue": "运动20分钟"
      },
      "task2Done": {
        "type": "boolean",
        "description": "第二项任务是否已完成。",
        "sampleValue": true
      },
      "task3Label": {
        "type": "string",
        "description": "第三项可勾选任务文案。",
        "sampleValue": "护眼休息"
      },
      "task3Done": {
        "type": "boolean",
        "description": "第三项任务是否已完成。",
        "sampleValue": false
      }
    },
    "assets": {
      "weatherIcon": {
        "type": "string",
        "description": "太阳和云朵组合天气图标素材路径。",
        "sampleValue": "resources/base/media/cloudy_turning_sunny.png"
      }
    },
    "state": {
      "loading": {
        "type": "boolean",
        "description": "天气数据加载状态。",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy_turning_sunny.png",
      "description": "小云朵和太阳组合的彩色天气图标，适合表达顶部天气状态。"
    }
  ]
}
