                "sampleValue": "东门上车"
              },
              "eventLocation": {
                "type": "string",
                "description": "行程目的地或关键地点",
                "sampleValue": "科技园"
              },
              "dtStart": {
                "type": "string",
                "description": "行程开始时间",
                "sampleValue": "14:08"
              },
              "dtEnd": {
                "type": "string",
                "description": "行程结束时间",
                "sampleValue": "14:36"
              }
            }
          }
        }
      }
    },
    "state": {
