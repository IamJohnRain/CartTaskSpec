{
  "userQuery": "主题色背景的基金+日程卡,内嵌几个小面板块用分隔线分组。每个写\"距离定投日还有3天\"这种拼接,读天气加图标。点日程能进详情,有\"今日待复盘\"风险标签,运动感渐变,文字符号画图标,横向并排面板。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "calendar_event_001"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "fund": {
        "name": {
          "type": "string",
          "description": "基金定投计划名称",
          "sampleValue": "指数定投"
        },
        "investCountdownText": {
          "type": "string",
          "description": "距离下一次基金定投日的展示文本",
          "sampleValue": "距离定投日还有3天"
        },
        "riskReviewTag": {
          "type": "string",
          "description": "今日风险复盘状态标签",
          "sampleValue": "今日待复盘"
        },
        "reviewHint": {
          "type": "string",
          "description": "基金复盘辅助提示",
          "sampleValue": "关注波动"
        }
      },
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询区县名称",
            "sampleValue": "浦东新区"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询城市名称",
            "sampleValue": "上海市"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          }
        }
      },
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符，用于打开日程详情",
              "sampleValue": "calendar_event_001"
            },
            "title": {
              "type": "string",
              "description": "今日基金复盘日程标题",
              "sampleValue": "基金复盘"
            },
            "dtStart": {
              "type": "string",
              "description": "日程开始时间",
              "sampleValue": "20:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "日程结束时间",
              "sampleValue": "21:00"
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "多云天气彩色图标，可用于当前天气状态识别。"
    },
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "日历实心图标，可用于日程查看或日程提醒入口。"
    }
  ]
}
