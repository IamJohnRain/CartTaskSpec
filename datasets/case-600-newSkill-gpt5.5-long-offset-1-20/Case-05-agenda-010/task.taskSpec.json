              "entityId": "sample-meeting-001",
              "title": "产品评审",
              "eventLocation": "8楼会议室",
              "dtStart": "14:30",
              "dtEnd": "15:00"
            }
          ],
          "items": {
            "type": "object",
            "description": "单条会议日程。",
            "properties": {
              "entityName": {
                "type": "string",
