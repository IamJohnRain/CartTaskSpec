        "sampleValue": "10分钟内开会"
      },
      "riskVisibility": {
        "type": "string",
        "description": "风险提示是否显示，低于20%或临近开会十分钟内为 visible，否则为 none。",
        "sampleValue": "visible"
      }
    }
  },
  "assetCandidates": [
