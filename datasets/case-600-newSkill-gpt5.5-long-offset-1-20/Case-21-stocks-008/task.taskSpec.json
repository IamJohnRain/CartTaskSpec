{
  "userQuery": "自选基金速览卡,横向排几个,带天气数据(阴雨心情差那种),用\"今日+1.2%\"这种固定文字加数值拼接,跌停熔断的红色告警,磨砂面板嵌进去,图标用素材库里那种语义图标就行。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "funds": {
      "todayLabel": {
        "type": "string",
        "description": "今日涨跌前缀文案，用于与基金涨跌数值拼接。",
        "sampleValue": "今日"
      },
      "first": {
        "name": {
          "type": "string",
          "description": "第一只自选基金简称。",
          "sampleValue": "沪深300"
        },
        "changeText": {
          "type": "string",
          "description": "第一只自选基金今日涨跌幅文本。",
          "sampleValue": "+1.2%"
        }
      },
      "second": {
        "name": {
          "type": "string",
          "description": "第二只自选基金简称。",
          "sampleValue": "成长混合"
        },
        "changeText": {
          "type": "string",
          "description": "第二只自选基金今日涨跌幅文本。",
          "sampleValue": "-0.8%"
        }
      },
      "alertText": {
        "type": "string",
        "description": "跌停熔断风险告警文本。",
        "sampleValue": "跌停熔断"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询的区县名称。",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "19°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "小雨"
          },
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警信息。",
            "sampleValue": "阴雨"
          }
        }
      }
    },
    "weatherMoodText": {
      "type": "string",
      "description": "结合阴雨天气表达的短心情提示。",
      "sampleValue": "阴雨心情差"
    },
    "asset": {
      "weatherIcon": {
        "type": "string",
        "description": "雨天天气语义图标素材路径。",
        "sampleValue": "resources/base/media/rain.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合的彩色天气图标，适合表达阴雨天气和天气状态入口。"
    }
  ]
}
