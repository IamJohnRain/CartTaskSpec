{
  "userQuery": "来一张主题色背景的待办卡,中间圆环显示整体完成度,下面竖着排可勾选的任务,某项临近截止要黄色待处理提示,点任务能跳到天气详情页,读天气数据,勾选前面用对号图标。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "title": {
      "type": "string",
      "description": "待办卡片标题。",
      "sampleValue": "今日待办"
    },
    "progress": {
      "value": {
        "type": "number",
        "description": "整体完成度数值。",
        "sampleValue": 75
      },
      "total": {
        "type": "number",
        "description": "整体完成度总值。",
        "sampleValue": 100
      },
      "text": {
        "type": "string",
        "description": "整体完成度展示文本。",
        "sampleValue": "75%"
      },
      "caption": {
        "type": "string",
        "description": "完成度辅助说明。",
        "sampleValue": "已完成 3/4"
      }
    },
    "tasks": {
      "type": "array",
      "description": "待办任务列表，卡片固定展示前三项。",
      "items": {
        "title": {
          "type": "string",
          "description": "任务标题。",
          "sampleValue": "带伞出门"
        },
        "done": {
          "type": "boolean",
          "description": "任务是否已完成。",
          "sampleValue": true
        },
        "status": {
          "type": "string",
          "description": "任务短状态或截止提示。",
          "sampleValue": "已完成"
        },
        "warning": {
          "type": "boolean",
          "description": "任务是否临近截止并需要黄色待处理提示。",
          "sampleValue": false
        }
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询区县名称。",
            "sampleValue": "青浦区"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询城市名称。",
            "sampleValue": "上海市"
          },
          "cityCode": {
            "type": "string",
            "description": "天气城市代码。",
            "sampleValue": "60814"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/checkmark_calendar_fill.svg",
      "description": "带对勾的日历实心图标，适合表达待办完成和任务打卡。"
    },
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "云朵在前、太阳在后的彩色天气图标，适合表达天气详情入口和天气数据。"
    }
  ]
}
