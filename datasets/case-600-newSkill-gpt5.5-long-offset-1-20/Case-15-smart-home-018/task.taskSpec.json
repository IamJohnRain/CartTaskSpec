      "purifySelected": {
        "type": "boolean",
        "description": "净化项是否勾选。",
        "sampleValue": true
      },
      "detectSelected": {
        "type": "boolean",
        "description": "检测项是否勾选。",
        "sampleValue": true
      },
      "thresholdSelected": {
        "type": "boolean",
        "description": "报警阈值项是否勾选。",
        "sampleValue": false
      }
    }
