{
  "userQuery": "智能家居空气质量卡，视觉风格想要那种由实景图延伸出来的科技色调。中间一个环形显示PM2.5当前75μg/m³要飘红那种注意状态，毕竟今天过敏季得盯着。下方纵向排几项勾选：新风、净化、检测、报警阈值。点任意一项跳到天气app，顺便读今天的日程，图标都用文字字符。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "current": {
          "pm25Value": {
            "type": "number",
            "description": "当前 PM2.5 数值，用于环形仪表进度。",
            "sampleValue": 75
          },
          "pm25Text": {
            "type": "string",
            "description": "当前 PM2.5 数值展示文本。",
            "sampleValue": "75"
          },
          "pm25Unit": {
            "type": "string",
            "description": "PM2.5 浓度单位。",
            "sampleValue": "μg/m³"
          },
          "alertLevel": {
            "type": "string",
            "description": "空气质量注意状态。",
            "sampleValue": "注意"
          }
        }
      },
      "calendar": {
        "items": {
          "type": "array",
          "description": "今日日程列表，卡片只展示第一条摘要。",
          "sampleValue": [
            {
              "entityId": "calendar-sample-1",
              "title": "过敏提醒",
              "dtStart": "09:30",
              "dtEnd": "10:00"
            }
          ],
          "items": {
            "type": "object",
            "description": "日程项。",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程唯一标识。",
                "sampleValue": "calendar-sample-1"
              },
              "title": {
                "type": "string",
                "description": "日程标题。",
                "sampleValue": "过敏提醒"
              },
              "dtStart": {
                "type": "string",
                "description": "日程开始时间。",
                "sampleValue": "09:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "日程结束时间。",
                "sampleValue": "10:00"
              }
            }
          }
        }
      }
    },
    "controls": {
      "freshAirSelected": {
        "type": "boolean",
