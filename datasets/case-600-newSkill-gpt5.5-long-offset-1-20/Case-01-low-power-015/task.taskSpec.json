            "temperatureRangeText": {
              "type": "string",
              "description": "明早温度范围展示文本。",
              "sampleValue": "24°/31°"
            }
          }
        }
      },
      "alarm": {
        "nextTimeText": {
          "type": "string",
          "description": "下一次起床闹钟时间。",
          "sampleValue": "07:20"
        }
      }
    },
    "assets": {
