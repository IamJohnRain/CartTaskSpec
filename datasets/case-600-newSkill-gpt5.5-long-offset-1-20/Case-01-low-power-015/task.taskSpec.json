{
  "userQuery": "晚上睡前手机经常只剩30%多,第二天起床怕没电。做个卡片纵向堆叠显示当前电量、明早天气、闹钟时间几个信息。卡片内嵌小面板,点卡片能跳到闹钟应用。浅色调底色,用夜晚的深蓝紫色渐变。电量低于30%时显示橙色待处理。底部横向排几个常用图标。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.clock",
        "abilityName": "com.huawei.hmos.clock.phone",
        "uri": ""
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "power": {
        "batteryText": {
          "type": "string",
          "description": "当前手机电量展示文本。",
          "sampleValue": "32%"
        },
        "batteryLevel": {
          "type": "number",
          "description": "当前手机电量百分比数值，用于进度条。",
          "sampleValue": 32
        },
        "statusText": {
          "type": "string",
          "description": "低电状态短提示，低于30%时表示待处理。",
          "sampleValue": "电量偏低"
        },
        "statusColor": {
          "type": "string",
          "description": "低电状态颜色，低于30%时使用橙色警示，否则使用夜间场景强调色。",
          "sampleValue": "#ffed6f21"
        }
      },
      "weather": {
        "daily": {
