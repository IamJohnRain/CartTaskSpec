{
  "userQuery": "给我做个清理卡片，背景有那种急迫感的渐变色，别用真实图片，纯色块和自带图标拼。上面横着排好几列大型的垃圾篓语义图标作为主体，旁边展示“系统垃圾1.2GB”这种动态数值。下面必须显示红色的“空间耗尽”超限告警，要带上我日历里今天“清理手机”的日程事件，点进去能看详细。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/0/entityId} }}"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "cleanup": {
        "wasteLabel": {
          "type": "string",
          "description": "系统垃圾类型标签",
          "sampleValue": "系统垃圾"
        },
        "wasteValue": {
          "type": "string",
          "description": "可清理系统垃圾容量展示值",
          "sampleValue": "1.2GB"
        },
        "alertText": {
          "type": "string",
          "description": "存储空间超限告警文案",
          "sampleValue": "空间耗尽"
        }
      },
      "calendar": {
        "items": {
          "type": "array",
          "description": "今天匹配清理手机的日历事件列表",
          "sampleValue": [
            {
              "entityId": "calendar-clean-phone-001",
              "title": "清理手机",
              "dtStart": "15:00",
              "dtEnd": "15:30"
            }
          ],
          "items": {
            "type": "object",
            "description": "日历事件",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日历事件唯一标识符",
                "sampleValue": "calendar-clean-phone-001"
              },
              "title": {
                "type": "string",
                "description": "日历事件标题",
                "sampleValue": "清理手机"
              },
              "dtStart": {
                "type": "string",
                "description": "日历事件开始时间",
                "sampleValue": "15:00"
              },
              "dtEnd": {
                "type": "string",
                "description": "日历事件结束时间",
                "sampleValue": "15:30"
              }
            }
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适合表达手机清理、垃圾清理和清理入口。"
    },
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "日历实心图标，适合表达日历事件查看和当日安排。"
    }
  ]
