{
  "userQuery": "做张简洁的通知聚合卡,白底干净不花哨,上面大号字显示今天未读总数。横向排几个群入口,每条前面可以打勾勾掉。再放个勿扰开关我通勤路上用。要能读取今天天气,有消息发送失败用红色警示。系统素材库里的铃铛和警示图标都可以用,适合有点柔和的氛围渐变。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "notifications": {
        "unreadTotalText": {
          "type": "string",
          "description": "今天所有通知入口的未读总数展示文本。",
          "sampleValue": "48"
        },
        "subtitle": {
          "type": "string",
          "description": "通知聚合的短说明。",
          "sampleValue": "今日未读"
        },
        "failureText": {
          "type": "string",
          "description": "消息发送失败的红色警示文案。",
          "sampleValue": "发送失败 2条"
        },
        "groups": {
          "0": {
            "name": {
              "type": "string",
              "description": "第一个群入口名称。",
              "sampleValue": "工作群"
            },
            "unreadText": {
              "type": "string",
              "description": "第一个群入口未读数量展示文本。",
              "sampleValue": "12"
            },
            "checked": {
              "type": "boolean",
              "description": "第一个群入口是否已勾掉。",
              "sampleValue": false
            }
          },
          "1": {
            "name": {
              "type": "string",
              "description": "第二个群入口名称。",
              "sampleValue": "家人"
            },
            "unreadText": {
              "type": "string",
              "description": "第二个群入口未读数量展示文本。",
              "sampleValue": "8"
            },
            "checked": {
              "type": "boolean",
              "description": "第二个群入口是否已勾掉。",
              "sampleValue": true
            }
          },
          "2": {
            "name": {
              "type": "string",
              "description": "第三个群入口名称。",
              "sampleValue": "项目群"
            },
            "unreadText": {
              "type": "string",
              "description": "第三个群入口未读数量展示文本。",
              "sampleValue": "28"
            },
            "checked": {
              "type": "boolean",
              "description": "第三个群入口是否已勾掉。",
              "sampleValue": false
            }
          }
        },
        "dndStatusText": {
          "type": "string",
          "description": "通勤勿扰模式当前状态短文案。",
          "sampleValue": "通勤勿扰"
        }
      },
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询的区县名称。",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "26°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/bell_fill.svg",
      "description": "铃铛实心图标，黑色，适合表示通知聚合入口。"
    },
    {
      "src": "resources/base/media/bell_slash_fill.svg",
      "description": "铃铛加斜杠实心图标，黑白双色，适合表示勿扰或关闭通知状态。"
    },
    {
      "src": "resources/base/media/cloudy.png",
      "description": "云朵组合彩色图标，适合展示多云天气。"
    }
  ]
}
