{
  "userQuery": "做一张通知聚合卡,左右并排布局,浅色调底。左边主视觉显示天气28度点跳天气应用,右边横向滚动显示钉钉群消息,每条用→或!文字字符当图标。整体要适合运动/紧迫感的渐变,读一下日历日程,有超时或取消的标红警告。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名称",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "28°"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级",
            "sampleValue": "空气良"
          }
        }
      },
      "notifications": {
        "sourceName": {
          "type": "string",
          "description": "通知来源应用或群组名称",
          "sampleValue": "钉钉群消息"
        },
        "messages": [
          {
            "icon": {
              "type": "string",
              "description": "消息前置文字图标",
              "sampleValue": "→"
            },
            "text": {
              "type": "string",
              "description": "群消息摘要",
              "sampleValue": "跑团 18:30 集合"
            }
          },
          {
            "icon": {
              "type": "string",
              "description": "消息前置文字图标",
              "sampleValue": "!"
            },
            "text": {
              "type": "string",
              "description": "需要关注的群消息摘要",
              "sampleValue": "审批 10 分钟超时"
            }
          }
        ]
      },
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符",
              "sampleValue": "calendar-001"
            },
            "title": {
              "type": "string",
              "description": "日程标题",
              "sampleValue": "训练复盘"
            },
            "dtStart": {
              "type": "string",
              "description": "日程开始时间",
              "sampleValue": "16:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "日程结束时间",
              "sampleValue": "17:00"
            }
          }
        ]
      },
      "alerts": {
        "statusText": {
          "type": "string",
          "description": "超时或取消状态警告文案",
          "sampleValue": "超时/取消需处理"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色云朵天气图标，适合用于浅色天气主视觉。"
    }
  ]
}
