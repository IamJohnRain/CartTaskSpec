  },
  "assetCandidates": [
    {
      "src": "resources/base/media/thunderstorm.png",
      "description": "雷雨天气彩色图标，适合用于暴雨、雷暴和天气告警场景的视觉识别。",
      "bindTo": "/asset/weatherGlyph"
    }
  ]
