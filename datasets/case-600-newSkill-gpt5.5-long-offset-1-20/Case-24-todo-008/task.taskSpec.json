{
  "userQuery": "想要一个天气类的待办卡片,左侧信息区显示温度和几条待办,右侧动作区跳到天气app,如果暴雨或者高温要有红色的告警状态,左右分区用不同底色,夜晚深蓝渐变,任务要竖着重复排几行。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
