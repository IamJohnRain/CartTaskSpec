          "sampleValue": "带伞出门"
        }
      },
      {
        "title": {
          "type": "string",
          "description": "第二条待办事项",
          "sampleValue": "检查窗户"
        }
      },
      {
        "title": {
          "type": "string",
          "description": "第三条待办事项",
          "sampleValue": "补水防暑"
        }
      }
