{
  "userQuery": "弄个浅色背景的专注卡片，最上面显示今天下雨的实时天气数据，竖着往下排我的番茄钟时间，底下嵌套一小块显示白噪音播放进度的区域，旁边放三个横向排列的「🔔」图标按钮，点一下能跳到时钟应用去调下一个闹钟。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.clock",
        "abilityName": "com.huawei.hmos.clock.phone",
        "uri": ""
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名称",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "21°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "小雨"
          }
        },
        "daily": [
          {
            "rainProbabilityPercent": {
              "type": "string",
              "description": "今天白天降雨概率百分比",
              "sampleValue": "86%"
            }
          }
        ],
        "updatedAt": {
          "type": "string",
          "description": "端侧完成天气查询和归一化的时间",
          "sampleValue": "实时"
        }
      }
    },
    "focus": {
      "pomodoroTime": {
        "type": "string",
        "description": "当前番茄钟倒计时时间",
        "sampleValue": "25:00"
      },
      "pomodoroLabel": {
        "type": "string",
        "description": "番茄钟状态短标签",
        "sampleValue": "番茄钟"
      }
    },
    "noise": {
      "name": {
        "type": "string",
        "description": "白噪音名称",
        "sampleValue": "雨声"
      },
      "progressValue": {
        "type": "number",
        "description": "白噪音播放进度当前值",
        "sampleValue": 42
      },
      "progressTotal": {
        "type": "number",
        "description": "白噪音播放进度总值",
        "sampleValue": 100
      },
      "progressLabel": {
        "type": "string",
        "description": "白噪音播放进度展示文本",
        "sampleValue": "42%"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合的彩色天气图标，适合表达当前下雨天气。"
    },
    {
      "src": "resources/base/media/bell_fill.svg",
      "description": "铃铛实心图标，适合表达提醒、通知或闹铃入口。"
    }
  ]
}
