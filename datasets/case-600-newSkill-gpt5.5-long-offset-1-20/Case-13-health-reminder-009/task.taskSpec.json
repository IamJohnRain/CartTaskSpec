{
  "userQuery": "做一张浅色底纵向喝水提醒卡，横排三项用文字图标加动态数值（如\"今日饮水 1200ml\"\"已服药 2 次\"\"距目标还差 800ml\"），能点进最近一次饮水日程看详情，读一下天气，氛围感底色不用渐变，目标已达成那种绿色正向状态。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "water-event-001"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "health": {
