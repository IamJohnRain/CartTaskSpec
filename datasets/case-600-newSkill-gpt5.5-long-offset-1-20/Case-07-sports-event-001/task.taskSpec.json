{
  "userQuery": "做张赛前装备检查卡，主题色背景配夜晚蓝紫渐变，横向排列几个勾选框（跑鞋、号码布、补给、能量胶），每项旁边显示动态步数或距离数据，勾完显示绿色\"已就绪\"。卡片底部嵌一个赛前歌单小版块，点一下跳音乐App播放，卡片要读取我日历里的比赛日程做关联。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hwmusic://com.huawei.hmsapp.music/showMusicList?code=a001&type=4"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
