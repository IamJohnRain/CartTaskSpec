              "sampleValue": "城市夜跑赛"
            },
            "dtStart": {
              "type": "string",
              "description": "比赛日程的开始时间，若为当天则展示为 HH:MM。",
              "sampleValue": "20:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "比赛日程的结束时间，若为当天则展示为 HH:MM。",
              "sampleValue": "22:00"
            },
            "eventLocation": {
              "type": "string",
              "description": "比赛日程地点。",
              "sampleValue": "滨江跑道"
