    },
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "低电模式省电图标，适合用于省电模式动作入口。"
    },
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "低电模式电池图标，适合用于剩余电量识别。"
    }
  ]
