{
  "userQuery": "想做一个智能缴费助手卡,横向三块根据天气预测(读取天气数据)显示\"明天预计用电增加15%\"、\"冷空气将增加燃气用量\"之类的,根据天气图片延伸出冷暖色调。中间要有个\"加入缴费日程\"按钮,点一下能跳到日历加一个缴费提醒事件。卡片分内外两层,里面那块是详细预测,外面是标题状态,纯文字图标,环境氛围渐变。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.calendar",
        "abilityName": "",
        "uri": "calendar://createEvent?title=水电燃缴费提醒"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本，用于外层状态。",
            "sampleValue": "24° / 31°"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象，用于外层状态。",
            "sampleValue": "多云转凉"
          }
        }
      }
    },
    "assets": {
      "weatherIcon": {
        "type": "string",
        "description": "天气图标素材路径，用于从天气图片延伸冷暖氛围。",
        "sampleValue": "resources/base/media/cloudy_turning_sunny.png"
      }
    },
    "forecast": {
      "electricity": {
        "label": {
          "type": "string",
          "description": "用电预测分块标题。",
          "sampleValue": "用电"
        },
        "text": {
          "type": "string",
          "description": "根据天气推导的用电量变化预测。",
          "sampleValue": "明天用电\n增加15%"
        }
      },
      "gas": {
        "label": {
          "type": "string",
          "description": "燃气预测分块标题。",
          "sampleValue": "燃气"
        },
        "text": {
          "type": "string",
          "description": "根据冷空气推导的燃气用量预测。",
          "sampleValue": "冷空气将\n增加用量"
        }
      },
      "water": {
        "label": {
          "type": "string",
          "description": "用水预测分块标题。",
          "sampleValue": "用水"
        },
        "text": {
          "type": "string",
          "description": "根据降雨或湿度推导的用水趋势预测。",
          "sampleValue": "降雨后\n用水趋稳"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy_turning_sunny.png",
      "description": "小云朵和太阳组合的天气彩色图标，适合表达多云转晴或冷暖交替天气，并作为冷暖环境渐变的视觉锚点。",
      "bindTo": "/assets/weatherIcon"
    }
  ]
}
