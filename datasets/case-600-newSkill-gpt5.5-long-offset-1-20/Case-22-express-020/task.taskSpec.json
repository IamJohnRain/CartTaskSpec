{
  "userQuery": "做一张图片风格的快递卡,上面放一张大号快递车的图当主视觉(用图延伸出整体色调),图下面横着并排几个包裹小卡片,每张写'预计今天18:30送达'这种固定文字+具体时间。再嵌一个'明天有2个待取'的提醒,跟我的日程挂钩能点进去看详情。顺便读天气显示'气温12°C注意保暖'。不要渐变,干净点,图标用文字字符,横向并排多个。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "calendar-package-pickup-001"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "logistics": {
        "title": {
          "type": "string",
          "description": "快递物流卡片标题",
          "sampleValue": "快递车"
        },
        "subtitle": {
          "type": "string",
          "description": "物流主视觉辅助说明",
          "sampleValue": "今日派送中"
        },
        "parcels": [
          {
            "label": {
              "type": "string",
              "description": "第一件包裹预计送达日期提示",
              "sampleValue": "预计今天"
            },
            "timeText": {
              "type": "string",
              "description": "第一件包裹预计送达时间",
              "sampleValue": "18:30送达"
            }
          },
          {
            "label": {
              "type": "string",
              "description": "第二件包裹预计送达日期提示",
              "sampleValue": "预计今天"
            },
            "timeText": {
              "type": "string",
              "description": "第二件包裹预计送达时间",
              "sampleValue": "20:10送达"
            }
          }
        ],
        "pickupSummary": {
          "type": "string",
          "description": "明日待取包裹日程提醒摘要",
          "sampleValue": "明天有2个待取"
        }
      },
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "待取提醒关联的日程唯一标识",
              "sampleValue": "calendar-package-pickup-001"
            },
            "title": {
              "type": "string",
              "description": "待取包裹日程标题",
              "sampleValue": "取快递提醒"
            },
            "dtStart": {
              "type": "string",
              "description": "待取提醒开始时间",
              "sampleValue": "明天"
            },
            "dtEnd": {
              "type": "string",
              "description": "待取提醒结束时间",
              "sampleValue": "明天"
            }
          }
        ]
      },
      "weather": {
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前气温展示文本",
            "sampleValue": "12°C"
          },
          "coldLevel": {
            "type": "string",
            "description": "低温或感冒指数提示",
            "sampleValue": "注意保暖"
          }
        },
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询区县名称",
            "sampleValue": "本地"
          }
        }
      }
    },
    "assets": {
      "hero": {
        "src": {
          "type": "string",
          "description": "物流主视觉素材路径",
          "sampleValue": "resources/base/media/courier_box.png"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/courier_box.png",
      "description": "快递箱子彩色图标，适合物流信息、取件提醒和包裹派送主视觉，主色可延伸为干净的暖橙物流色。",
      "bindTo": "/assets/hero/src"
    }
  ]
}
