{
  "userQuery": "我睡眠数据一直很差，帮我做个干净点的睡眠卡片，背景根据天气加夜晚氛围渐变。顶部一个圆环显示\"深睡比例18%\"动态值红色标出\"严重偏低\"几个固定文字，下面用纯色块横向排列3项数据比如\"入睡23:45\"\"起床06:50\"\"手环电量43%\"，点数据能跳到运动健康App。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/router/sleepDetail"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名，用于生成与当前位置天气相关的夜间氛围。",
            "sampleValue": "青浦区"
          }
        },
        "current": {
          "condition": {
            "type": "string",
            "description": "当前天气现象，用于判断睡眠卡片的夜间氛围背景。",
            "sampleValue": "小雨"
          }
        },
        "theme": {
          "nightStart": {
            "type": "string",
            "description": "由当前天气映射得到的夜间渐变起始色。",
            "sampleValue": "#182345"
          },
          "nightEnd": {
            "type": "string",
            "description": "由当前天气映射得到的夜间渐变结束色。",
            "sampleValue": "#4B3578"
          }
        }
      },
      "sleep": {
        "deepSleepRatioText": {
          "type": "string",
          "description": "深睡比例展示文本。",
          "sampleValue": "18%"
        },
        "deepSleepRatioValue": {
          "type": "number",
          "description": "深睡比例数值，范围为0到100，用于环形进度。",
          "sampleValue": 18
        },
        "severityText": {
          "type": "string",
          "description": "深睡比例健康状态提示。",
          "sampleValue": "严重偏低"
        },
        "fallAsleepTime": {
          "type": "string",
          "description": "昨夜入睡时间展示文本。",
          "sampleValue": "23:45"
        },
        "wakeUpTime": {
          "type": "string",
          "description": "今日起床时间展示文本。",
          "sampleValue": "06:50"
        },
        "bandBatteryText": {
          "type": "string",
          "description": "手环电量展示文本。",
          "sampleValue": "43%"
        }
      }
    }
  },
  "assetCandidates": []
