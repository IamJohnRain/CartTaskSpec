{
  "userQuery": "我同时追足球/篮球/马拉松三项比赛，做个简洁的多赛程提醒卡。横排显示接下来三场比赛，每场用主题图标+勾选框标记是否参加（没勾的标红\"待定\"）。纯文字色块不配图，内嵌一个日板块面方便看具体日期，夜晚渐变。展示型的可以不用点击。",
  "size": "2x4",
  "eventCandidates": [],
  "dataModelSchema": {
    "headerText": {
      "type": "string",
      "description": "卡片顶部标题",
      "sampleValue": "赛事提醒"
    },
    "datePanel": {
      "iconSrc": {
        "type": "string",
        "description": "日期板块使用的日历图标素材路径",
        "sampleValue": "resources/base/media/calendar_fill.svg"
      },
      "day": {
        "type": "string",
        "description": "当前日期的日号",
        "sampleValue": "16"
      },
      "month": {
        "type": "string",
        "description": "当前日期的月份文本",
        "sampleValue": "7月"
      },
      "weekday": {
        "type": "string",
        "description": "当前日期的星期文本",
        "sampleValue": "周四"
      }
    },
    "matches": {
      "football": {
        "iconSrc": {
          "type": "string",
          "description": "足球赛程的主题图标素材路径",
          "sampleValue": "resources/base/media/play_fill.svg"
        },
        "label": {
          "type": "string",
          "description": "足球赛程标题",
          "sampleValue": "足球"
        },
        "whenText": {
          "type": "string",
          "description": "足球赛程的日期和时间文本",
          "sampleValue": "07/18 19:30"
        },
        "selected": {
          "type": "boolean",
          "description": "足球赛程是否已确认参加",
          "sampleValue": true
        },
        "statusText": {
          "type": "string",
          "description": "足球赛程的参加状态文案",
          "sampleValue": "已参加"
        },
        "statusColor": {
          "type": "string",
          "description": "足球赛程状态文案颜色",
          "sampleValue": "#64bb5c"
        }
      },
      "basketball": {
        "iconSrc": {
          "type": "string",
          "description": "篮球赛程的主题图标素材路径",
          "sampleValue": "resources/base/media/person_3_fill.svg"
        },
        "label": {
          "type": "string",
          "description": "篮球赛程标题",
          "sampleValue": "篮球"
        },
        "whenText": {
          "type": "string",
          "description": "篮球赛程的日期和时间文本",
          "sampleValue": "07/20 21:00"
        },
        "selected": {
          "type": "boolean",
          "description": "篮球赛程是否已确认参加",
          "sampleValue": false
        },
        "statusText": {
          "type": "string",
          "description": "篮球赛程的参加状态文案",
          "sampleValue": "待定"
        },
        "statusColor": {
          "type": "string",
          "description": "篮球赛程状态文案颜色",
          "sampleValue": "#ffdb6b42"
        }
      },
      "marathon": {
        "iconSrc": {
          "type": "string",
          "description": "马拉松赛程的主题图标素材路径",
          "sampleValue": "resources/base/media/figure_run.svg"
        },
        "label": {
          "type": "string",
          "description": "马拉松赛程标题",
          "sampleValue": "马拉松"
        },
        "whenText": {
          "type": "string",
          "description": "马拉松赛程的日期和时间文本",
          "sampleValue": "07/22 05:50"
        },
        "selected": {
          "type": "boolean",
          "description": "马拉松赛程是否已确认参加",
          "sampleValue": true
        },
        "statusText": {
          "type": "string",
          "description": "马拉松赛程的参加状态文案",
          "sampleValue": "已参加"
        },
        "statusColor": {
          "type": "string",
          "description": "马拉松赛程状态文案颜色",
          "sampleValue": "#64bb5c"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "深色夜间赛事卡的日历板块图标，用于展示当前日期。",
      "bindTo": "/datePanel/iconSrc"
    },
    {
      "src": "resources/base/media/play_fill.svg",
      "description": "足球赛程的主题图标，适合用于比赛条目标识。",
      "bindTo": "/matches/football/iconSrc"
    },
    {
      "src": "resources/base/media/person_3_fill.svg",
      "description": "篮球赛程的主题图标，适合用于团队比赛条目标识。",
      "bindTo": "/matches/basketball/iconSrc"
    },
    {
      "src": "resources/base/media/figure_run.svg",
      "description": "马拉松赛程的主题图标，适合用于跑步比赛条目标识。",
      "bindTo": "/matches/marathon/iconSrc"
    }
  ]
}
