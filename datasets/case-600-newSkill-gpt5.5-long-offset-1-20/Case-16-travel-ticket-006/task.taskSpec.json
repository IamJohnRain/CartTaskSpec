{
  "userQuery": "白底行程卡太丑了重做!左边步数环显示今天走了XXX步加个跳系统健康设置按钮,右边分割线分天气和行程两块,横向排几个快捷项,完成用绿色,不要渐变,字图标。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "health": {
        "todaySteps": {
          "type": "number",
          "description": "今日步数数值，用于步数环进度。",
          "sampleValue": 8632
        },
        "stepGoal": {
          "type": "number",
          "description": "今日步数目标，用于步数环总量。",
          "sampleValue": 10000
        },
        "todayStepsText": {
          "type": "string",
          "description": "今日步数展示文本。",
          "sampleValue": "8632步"
        }
      },
      "weather": {
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        }
      },
      "calendar": {
        "items": [
          {
            "dtStart": {
              "type": "string",
              "description": "下一条行程开始时间。",
              "sampleValue": "09:40"
            },
            "title": {
              "type": "string",
              "description": "下一条行程标题。",
              "sampleValue": "值机"
            }
          }
        ]
      }
    },
    "assets": {
      "runIcon": {
        "type": "string",
        "description": "运动跑步图标素材路径。",
        "sampleValue": "resources/base/media/figure_run.svg"
      }
    },
    "ui": {
      "quickTrip": {
        "type": "string",
        "description": "行程快捷项短标签。",
        "sampleValue": "票"
      },
      "quickRoute": {
        "type": "string",
        "description": "路线快捷项短标签。",
        "sampleValue": "车"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/figure_run.svg",
      "description": "运动跑步人物图标，适合用于步数统计和健康运动卡片。",
      "bindTo": "/assets/runIcon"
    }
  ]
