{
  "userQuery": "通勤卡片纵向排三个路段(公司路/后湖路/滨河路),每段配语义图标显示时间和距离,左边信息区右边动作区带导航按钮,磨砂底色,某段封路标红色告警,固定文案就行不加渐变。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "StartNavigate",
        "params": {
          "dstLocation": {
            "name": "公司"
          },
          "trafficpe": "Drive"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "route": {
        "segment0": {
          "name": {
            "type": "string",
            "description": "第一段通勤道路名称",
            "sampleValue": "公司路"
          },
          "duration": {
            "type": "string",
            "description": "第一段预计通行时间",
            "sampleValue": "8分钟"
          },
          "distance": {
            "type": "string",
            "description": "第一段通行距离",
            "sampleValue": "1.6km"
          },
          "status": {
            "type": "string",
            "description": "第一段路况状态",
            "sampleValue": "畅通"
          },
          "icon": {
            "type": "string",
            "description": "第一段路段语义图标路径",
            "sampleValue": "resources/base/media/house_fill.svg"
          }
        },
        "segment1": {
          "name": {
            "type": "string",
            "description": "第二段通勤道路名称",
            "sampleValue": "后湖路"
          },
          "duration": {
            "type": "string",
            "description": "第二段预计通行时间",
            "sampleValue": "12分钟"
          },
          "distance": {
            "type": "string",
            "description": "第二段通行距离",
            "sampleValue": "2.4km"
          },
          "status": {
            "type": "string",
            "description": "第二段路况状态",
            "sampleValue": "封路"
          },
          "icon": {
            "type": "string",
            "description": "第二段路段语义图标路径",
            "sampleValue": "resources/base/media/bus_fill.svg"
          }
        },
        "segment2": {
          "name": {
            "type": "string",
            "description": "第三段通勤道路名称",
            "sampleValue": "滨河路"
          },
          "duration": {
            "type": "string",
            "description": "第三段预计通行时间",
            "sampleValue": "6分钟"
          },
          "distance": {
            "type": "string",
            "description": "第三段通行距离",
            "sampleValue": "1.1km"
          },
          "status": {
            "type": "string",
            "description": "第三段路况状态",
            "sampleValue": "缓行"
          },
          "icon": {
            "type": "string",
            "description": "第三段路段语义图标路径",
            "sampleValue": "resources/base/media/location_north_up_right_fill.svg"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/house_fill.svg",
      "description": "房屋实心图标，用于表达从公司相关路段开始的通勤路线识别。",
      "bindTo": "/data/route/segment0/icon"
    },
    {
      "src": "resources/base/media/bus_fill.svg",
      "description": "公交车实心图标，用于表达后湖路交通路段与通勤语义。",
      "bindTo": "/data/route/segment1/icon"
    },
    {
      "src": "resources/base/media/location_north_up_right_fill.svg",
      "description": "方向导航实心图标，用于表达滨河路行进方向和导航语义。",
      "bindTo": "/data/route/segment2/icon"
    }
  ]
}
