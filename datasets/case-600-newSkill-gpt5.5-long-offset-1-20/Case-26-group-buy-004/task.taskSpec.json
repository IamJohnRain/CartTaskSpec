{
  "userQuery": "主题色背景的拼单卡,左侧放奶茶图,右侧勾选列表。每一项\"已选3杯,还差1杯起送\"这种固定文字加动态值,跳到日历看拼单时间。完成状态绿对勾,运动紧迫感渐变,文字小图标,竖向重复排列。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "calendar_group_001"
        }
      }
    }
  ],
  "dataModelSchema": {
    "group": {
      "title": {
        "type": "string",
        "description": "拼单卡片标题。",
        "sampleValue": "拼单"
      },
      "productName": {
        "type": "string",
        "description": "拼单商品名称。",
        "sampleValue": "奶茶"
      },
      "statusText": {
        "type": "string",
        "description": "当前拼单完成状态。",
        "sampleValue": "完成"
      },
      "calendarEntityId": {
        "type": "string",
        "description": "拼单时间对应的日历事件实体 ID。",
        "sampleValue": "calendar_group_001"
      },
      "items": [
        {
          "selectedCups": {
            "type": "number",
            "description": "第一项已选择杯数。",
            "sampleValue": 3
          },
          "missingCups": {
            "type": "number",
            "description": "第一项距离起送还差杯数。",
            "sampleValue": 1
          },
          "done": {
            "type": "boolean",
            "description": "第一项是否已完成。",
            "sampleValue": true
          }
        },
        {
          "selectedCups": {
            "type": "number",
            "description": "第二项已选择杯数。",
            "sampleValue": 2
          },
          "missingCups": {
            "type": "number",
            "description": "第二项距离起送还差杯数。",
            "sampleValue": 2
          },
          "done": {
            "type": "boolean",
            "description": "第二项是否已完成。",
            "sampleValue": false
          }
        }
      ]
    },
    "assets": {
      "groupIcon": {
        "type": "string",
        "description": "群组拼单识别图标素材路径。",
        "sampleValue": "resources/base/media/person_3_fill.svg"
      },
      "calendarIcon": {
        "type": "string",
        "description": "日历入口图标素材路径。",
        "sampleValue": "resources/base/media/calendar_fill.svg"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/person_3_fill.svg",
      "description": "三人组实心图标，适合表达拼单团购的多人参与状态。",
      "bindTo": "/assets/groupIcon"
    },
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "日历实心图标，适合表达查看拼单时间和日程入口。",
      "bindTo": "/assets/calendarIcon"
    }
  ]
}
