{
  "userQuery": "做个雨天打车卡片左右并排两块，左边排队信息右边天气，要那种夜晚倒计时的渐变效果。天气块点一下能跳到天气应用看详细。纵向往下列几个常用目的地公司、家、机场，前面带勾选框我选要去的。提醒我当前定位失败权限被拒了，得手动输地址。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.weather",
        "abilityName": "MainAbility",
        "uri": "weather://detail"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询实际返回的区县名称。",
            "sampleValue": "黄浦区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "适合直接显示的当前温度文本。",
            "sampleValue": "22°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "小雨"
          }
        }
      }
    },
    "state": {
      "taxi": {
        "queueStatus": {
          "type": "string",
          "description": "受控静态候车状态，用于展示当前排队信息。",
          "sampleValue": "正在排队"
        },
        "countdownText": {
          "type": "string",
          "description": "受控静态夜间候车倒计时文本。",
          "sampleValue": "03:28"
        },
        "etaText": {
          "type": "string",
          "description": "受控静态预计候车时长文本。",
          "sampleValue": "预计 8 分钟"
        }
      },
      "location": {
        "permissionAlert": {
          "type": "string",
          "description": "定位权限被拒后需要用户手动输入地址的受控提示。",
          "sampleValue": "定位权限被拒，请手动输地址"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_car.png",
      "description": "汽车图标，表达雨天叫车和候车场景，适合作为左侧候车信息的识别图标。"
    },
    {
      "src": "resources/base/media/icon_weathe2.png",
      "description": "天气图标，表达雨天和天气详情入口，适合作为右侧天气块的视觉识别。"
    }
  ]
}
