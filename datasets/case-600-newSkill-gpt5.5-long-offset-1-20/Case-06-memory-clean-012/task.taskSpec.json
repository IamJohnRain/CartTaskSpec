{
  "userQuery": "帮我设计个清理卡片，背景要那种运动风的紧迫渐变色，带点磨砂质感，中间放个环形图显示存储空间，竖着排几项待清理的文件，比如视频、图片，每项前面配个对应的图标，能勾选清理，点击还能跳到系统存储设置，结合日历看看明天有没有拍会议照的空间，提示一下空间不足的风险。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "storage": {
        "usedPercent": {
          "type": "number",
          "description": "当前存储空间已使用百分比，用于环形进度。",
          "sampleValue": 82
        },
        "totalPercent": {
          "type": "number",
          "description": "存储空间百分比总量。",
          "sampleValue": 100
        },
        "percentText": {
          "type": "string",
          "description": "当前存储空间已使用百分比展示文本。",
          "sampleValue": "82%"
        },
        "usedLabel": {
          "type": "string",
          "description": "当前存储空间占用摘要。",
          "sampleValue": "已用82%"
        },
        "freeLabel": {
          "type": "string",
          "description": "剩余可用空间摘要。",
          "sampleValue": "余18GB"
        },
        "riskText": {
          "type": "string",
          "description": "结合明日日历会议拍照需求给出的空间风险提示。",
          "sampleValue": "明日会议照空间偏紧"
        },
        "cleanupItems": [
          {
            "name": {
              "type": "string",
              "description": "第一类待清理文件名称。",
              "sampleValue": "视频"
            },
            "sizeText": {
              "type": "string",
              "description": "第一类待清理文件预计可释放空间。",
              "sampleValue": "2.1GB"
            },
            "selected": {
              "type": "boolean",
              "description": "第一类待清理文件是否默认勾选。",
              "sampleValue": true
            }
          },
          {
            "name": {
              "type": "string",
              "description": "第二类待清理文件名称。",
              "sampleValue": "图片"
            },
            "sizeText": {
              "type": "string",
              "description": "第二类待清理文件预计可释放空间。",
              "sampleValue": "1.4GB"
            },
            "selected": {
              "type": "boolean",
              "description": "第二类待清理文件是否默认勾选。",
              "sampleValue": true
            }
          }
        ]
      },
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "明日日历事件唯一标识符。",
              "sampleValue": "calendar-demo-001"
            },
            "title": {
              "type": "string",
              "description": "明日可能需要拍会议照的日程标题。",
              "sampleValue": "拍会议照"
            },
            "dtStart": {
              "type": "string",
              "description": "明日日程开始时间。",
              "sampleValue": "09:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "明日日程结束时间。",
              "sampleValue": "10:30"
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适合表达清理任务与释放空间入口。"
    },
    {
      "src": "resources/base/media/externaldrive_fill.svg",
      "description": "外置存储设备图标，适合表达视频等占用存储的文件类别。"
    },
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "日历图标，适合表达图片或会议拍照相关的日程空间风险。"
    }
  ]
}
