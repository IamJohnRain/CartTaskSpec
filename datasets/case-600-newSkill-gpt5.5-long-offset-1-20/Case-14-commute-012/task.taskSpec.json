{
  "userQuery": "上下班路况卡片，左右分区，左边信息右边动作按钮，中间用分隔线划几块。整张卡片由图片延伸出来的视觉风格，上面动态显示剩余电量和通勤进度。要是有事故或者堵车超时严重，得有红色告警标出来。卡片里要有个入口直接跳系统设置去关掉耗电的后台APP。背景用红橙的紧迫感渐变。最下面纵向排几行重复的选项，每行用文字字符画图标。静态数据就行。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "commute": {
      "title": {
        "type": "string",
        "description": "通勤路况卡片标题",
        "sampleValue": "下班通勤"
      },
      "routeName": {
        "type": "string",
        "description": "当前通勤路线名称",
        "sampleValue": "金融街 -> 回家"
      },
      "batteryText": {
        "type": "string",
        "description": "剩余电量展示文本",
        "sampleValue": "电量 28%"
      },
      "progressText": {
        "type": "string",
        "description": "通勤进度展示文本",
        "sampleValue": "已完成 64%"
      },
      "progressValue": {
        "type": "number",
        "description": "通勤进度数值，范围 0 到 100",
        "sampleValue": 64
      },
      "progressTotal": {
        "type": "number",
        "description": "通勤进度总量",
        "sampleValue": 100
      },
      "etaText": {
        "type": "string",
        "description": "预计剩余通勤时间",
        "sampleValue": "还需 18 分钟"
      },
      "alertText": {
        "type": "string",
        "description": "事故或严重拥堵告警文本",
        "sampleValue": "前方事故，预计超时 12 分钟"
      },
      "option0": {
        "type": "string",
        "description": "底部第一行文字字符画选项",
        "sampleValue": "[>>] 避开高架"
      },
      "option1": {
        "type": "string",
        "description": "底部第二行文字字符画选项",
        "sampleValue": "[!!] 事故提醒"
      },
      "option2": {
        "type": "string",
        "description": "底部第三行文字字符画选项",
        "sampleValue": "[--] 省电路线"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/location_north_up_right_fill.svg",
      "description": "方向导航实心箭头图标，适合用于通勤导航、路线规划和前进方向的视觉锚点。"
    },
    {
      "src": "resources/base/media/battery_leaf_fill.svg",
      "description": "电池与绿叶组合图标，适合用于剩余电量、省电和低耗电出行提示。"
    }
  ]
}
