              "dtStart": "7/18 9:00",
              "dtEnd": "7/18 9:20"
            },
            {
              "entityId": "calendar-umbrella-003",
              "title": "回访爸妈",
              "dtStart": "7/19 18:30",
              "dtEnd": "7/19 18:45"
            }
          ],
          "items": {
            "type": "object",
            "description": "单条日程项",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程唯一标识，用于打开日程详情",
                "sampleValue": "calendar-umbrella-001"
              },
              "title": {
                "type": "string",
                "description": "日程标题",
                "sampleValue": "给爸妈送伞"
              },
              "dtStart": {
                "type": "string",
                "description": "日程开始日期和时间展示文本",
                "sampleValue": "7/17 8:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "日程结束日期和时间展示文本",
                "sampleValue": "07/17 09:30"
              }
            }
          }
        }
      },
      "contact": {
        "phoneNumber": {
          "type": "string",
          "description": "一键拨号使用的脱敏联系人电话号码",
          "sampleValue": "138****5678"
        }
      },
      "reminder": {
        "sendUmbrellaChecked": {
          "type": "boolean",
          "description": "送伞提醒任务是否已勾选",
          "sampleValue": true
        },
        "sendUmbrellaLabel": {
          "type": "string",
          "description": "送伞提醒任务的展示文案",
          "sampleValue": "提醒我带伞"
        }
      }
    }
  },
  "assetCandidates": [
