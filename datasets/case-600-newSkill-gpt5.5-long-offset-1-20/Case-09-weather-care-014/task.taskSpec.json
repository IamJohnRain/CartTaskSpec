{
  "userQuery": "帮我做个天气关怀卡片，背景整体用一种暗黑渐变风烘托暴雨氛围。我最近日程里安排了给爸妈送伞，需要横向排列这几天带日程日期的模块，点击能看具体行程安排。底下弄个勾选框绑定我的提醒任务，再弄个“一键拨号”的明确大按钮。要是天气恶化到了红色暴雨预警状态，必须在卡片上直接弹出来。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/0/entityId} }}"
        }
      }
    },
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/1/entityId} }}"
        }
      }
    },
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/2/entityId} }}"
        }
      }
    },
    {
      "call": "clickToCallPhone",
      "args": {
        "phoneNumber": "{{ ${/data/contact/phoneNumber} }}"
      }
    },
    {
      "call": "clickToCallPhone",
      "args": {
        "phoneNumber": "138****5678"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询对应区县名称",
            "sampleValue": "浦东新区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "24°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "暴雨"
          },
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警等级文本",
            "sampleValue": "红色暴雨预警"
          }
        }
      },
      "calendar": {
        "items": {
          "type": "array",
          "description": "未来几天与送伞相关的日程列表",
          "sampleValue": [
            {
              "entityId": "calendar-umbrella-001",
              "title": "给爸妈送伞",
              "dtStart": "7/17 8:30",
              "dtEnd": "7/17 9:30"
            },
            {
              "entityId": "calendar-umbrella-002",
