{
  "userQuery": "给我做个小孩周末防沉迷卡片，表面简洁素净，带个整体氛围背景。卡片上要读取周末天气数据，把玩游戏、看动画片、听故事这几个选项横向排成一排，每个旁边带个勾选框做双向绑定，一旦总时长临近设定的2小时风险阈值，就在旁边亮起一个沙漏语义图标提醒注意。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "children_weekend_screen_time",
          "switchFlag": 1
        }
      }
    }
  ],
  "dataModel": {
    "value": {
      "weather": {
        "date": "周末",
        "condition": "多云",
        "temperature": "26C",
        "weekendText": "周末 多云26C"
      },
      "antiAddiction": {
        "title": "周末守护",
        "thresholdMinutes": 120,
        "usedMinutes": 108,
        "usedText": "108/120分",
        "nearThreshold": true,
        "riskText": "临近2小时",
        "actionText": "设置",
        "options": [
          {
            "label": "游戏",
            "checked": true,
            "minutes": 45
          },
          {
            "label": "动画",
            "checked": true,
            "minutes": 40
          },
          {
            "label": "故事",
            "checked": false,
            "minutes": 23
          }
        ]
      },
      "asset": {
        "hourglassIcon": "resources/base/media/icon_timing.png"
      }
    }
  },
  "assetCandidates": [
    {
      "assetRef": "hourglass_icon",
      "src": "resources/base/media/icon_timing.png",
      "use": "anti-addiction threshold warning icon",
      "description": "沙漏语义的本地计时图标，用于总时长临近周末防沉迷阈值时提醒注意。",
      "bindTo": "/asset/hourglassIcon",
      "static": true
    }
  ]
