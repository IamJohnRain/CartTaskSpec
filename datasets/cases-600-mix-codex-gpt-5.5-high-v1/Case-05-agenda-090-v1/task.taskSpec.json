{
  "userQuery": "整个议程提醒的嘛 从日历读日程点一下能进会议还要红色危险提示",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "JoinCalendarMeeting",
        "params": {
          "entityId": {
            "path": "/calendar/nextEvent/entityId"
