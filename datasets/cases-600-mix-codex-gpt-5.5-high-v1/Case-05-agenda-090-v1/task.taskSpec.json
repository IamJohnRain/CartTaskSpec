            "path": "/calendar/nextEvent/meetingUri"
          }
        }
      }
    }
  ],
  "dataModel": {
    "value": {
      "calendar": {
        "source": "calendar_mock",
        "nextEvent": {
          "entityName": "calendar",
          "entityId": "calendar-agenda-090-next",
