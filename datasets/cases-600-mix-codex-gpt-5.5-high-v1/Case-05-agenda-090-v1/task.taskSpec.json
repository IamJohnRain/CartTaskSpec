      },
      "assets": {
        "agendaIcon": "assets/icons/calendar-alert.png"
      },
      "state": {
        "loading": false
      }
    }
  },
  "assetCandidates": [
    {
      "assetRef": "agenda_alert_icon",
      "src": "assets/icons/calendar-alert.png",
