{
  "userQuery": "帮我弄个比赛倒计时卡片，数字写背景图上，从日历读比赛日程，点开跳进app",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "从日历读取的比赛日程列表，按开始时间排序。",
          "sampleValue": [
            {
              "entityId": "calendar-event-001",
              "title": "城市马拉松",
              "dtStart": "07.18 07:30",
              "dtEnd": "07.18 11:30",
              "eventLocation": "奥体中心",
              "importantEventType": 2
            }
          ],
          "items": {
            "type": "object",
            "description": "单条比赛日程。",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日历日程唯一标识。",
                "sampleValue": "calendar-event-001"
              },
              "title": {
                "type": "string",
                "description": "比赛日程标题。",
                "sampleValue": "城市马拉松"
              },
              "dtStart": {
                "type": "string",
                "description": "比赛开始时间展示文本。",
                "sampleValue": "07.18 07:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "比赛结束时间展示文本。",
                "sampleValue": "07.18 11:30"
              },
              "eventLocation": {
                "type": "string",
                "description": "比赛地点。",
                "sampleValue": "奥体中心"
              },
              "importantEventType": {
                "type": "integer",
                "description": "重要日类型，2 表示倒数日。",
                "sampleValue": 2
              }
            }
          }
        }
      }
    },
    "ui": {
      "kicker": {
        "type": "string",
        "description": "卡片短标题。",
        "sampleValue": "赛事倒计时"
      },
      "countdownNumber": {
        "type": "string",
        "description": "由日历比赛开始时间换算得到的倒计时数字展示文本。",
        "sampleValue": "9"
      },
      "countdownUnit": {
        "type": "string",
        "description": "倒计时单位。",
        "sampleValue": "天"
      },
      "timeLabel": {
        "type": "string",
        "description": "比赛开始时间标签。",
        "sampleValue": "开赛时间"
      },
      "actionLabel": {
        "type": "string",
        "description": "进入应用的短操作文案。",
        "sampleValue": "打开"
      }
    },
    "state": {
      "loading": {
        "type": "boolean",
        "description": "日历日程加载状态。",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_run.png",
      "description": "运动跑步图标，适合用作比赛或运动赛事倒计时卡片的背景视觉锚点。"
    }
  ]
}
