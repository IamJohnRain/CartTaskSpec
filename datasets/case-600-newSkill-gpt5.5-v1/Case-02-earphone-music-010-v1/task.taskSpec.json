{
  "userQuery": "弄个耳机卡，点一下能进系统操作，看到红色那种危险提示",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "device": {
      "name": {
        "type": "string",
        "description": "耳机卡片展示的设备名称",
        "sampleValue": "耳机"
      },
      "mode": {
        "type": "string",
        "description": "当前音频或设备状态短文案",
        "sampleValue": "音乐播放中"
      }
    },
    "alert": {
      "level": {
        "type": "string",
        "description": "危险提示等级短标签",
        "sampleValue": "危险提示"
      },
      "message": {
        "type": "string",
        "description": "进入系统操作前需要用户注意的红色提示文案",
        "sampleValue": "请谨慎操作"
      }
    },
    "action": {
      "label": {
        "type": "string",
        "description": "进入系统设置操作的短按钮文案",
        "sampleValue": "处理"
      }
    },
    "asset": {
      "earphoneIcon": {
        "type": "string",
        "description": "耳机图标素材路径",
        "sampleValue": "resources/base/media/icon_earphone.png"
      },
      "musicIcon": {
        "type": "string",
        "description": "音乐图标素材路径",
        "sampleValue": "resources/base/media/icon_music.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_earphone.png",
      "description": "耳机图标，适合用于戴耳机播控场景的设备识别主视觉。",
      "bindTo": "/asset/earphoneIcon"
    },
    {
      "src": "resources/base/media/icon_music.png",
      "description": "音乐图标，适合用于戴耳机播控场景的音乐播放状态辅助识别。",
      "bindTo": "/asset/musicIcon"
    }
  ]
}
