{
  "userQuery": "整个图像的卡 点了能跳到应用 红色危险提示那种",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气所在区县或当前位置展示名",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "39°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象或高温状态",
            "sampleValue": "高温"
          },
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警等级或预警标题",
            "sampleValue": "红色高温预警"
          },
          "feelsLikeC": {
            "type": "number",
            "description": "当前体感摄氏温度",
            "sampleValue": 42
          },
          "uvIndex": {
            "type": "string",
            "description": "当前紫外线等级",
            "sampleValue": "强"
          }
        }
      }
    },
    "asset": {
      "weatherAlertIcon": {
        "type": "string",
        "description": "高温危险提示图标路径",
        "sampleValue": "resources/base/media/icon_high_temperature.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_high_temperature.png",
      "description": "高温/温度计图标，适合天气关怀中的红色危险或高温预警提示。",
      "bindTo": "/asset/weatherAlertIcon"
    }
  ]
}
