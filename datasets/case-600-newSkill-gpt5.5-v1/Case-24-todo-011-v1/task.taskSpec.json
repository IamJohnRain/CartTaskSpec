            "sampleValue": "28°"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        },
        "daily": {
          "type": "array",
          "description": "天气预报列表。",
          "sampleValue": [
            {
              "condition": "转晴",
              "temperatureRangeText": "25°/31°"
            }
          ],
          "items": {
            "type": "object",
            "description": "单日预报。",
            "properties": {
              "condition": {
                "type": "string",
