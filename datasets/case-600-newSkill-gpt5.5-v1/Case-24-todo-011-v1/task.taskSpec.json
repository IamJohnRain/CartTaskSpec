                "sampleValue": "10:00"
              },
              "importantEventType": {
                "type": "integer",
                "description": "重要日程类型，0 表示普通，1 或 2 表示重要。",
                "sampleValue": 1
              }
            }
          }
        }
      },
      "weather": {
