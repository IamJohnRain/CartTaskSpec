          "sampleValue": [
            {
              "entityId": "calendar-event-sample-001",
              "title": "项目例会",
              "dtStart": "09:30",
              "dtEnd": "10:00"
            }
          ],
          "items": {
            "type": "object",
            "description": "单条日历事件。",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程唯一标识，用于打开系统日历事件详情。",
