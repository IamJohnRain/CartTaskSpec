              },
              "dtEnd": {
                "type": "string",
                "description": "会议结束时间，当天事件使用 HH:MM 格式。",
                "sampleValue": "10:00"
              }
            }
          }
        }
      },
      "weather": {
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
