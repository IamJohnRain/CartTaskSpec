      "actionIcon": {
        "type": "string",
        "description": "打开天气应用或播报天气入口的图标资源路径。",
        "sampleValue": "resources/base/media/icon_weather1.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/partly_cloudy.png",
