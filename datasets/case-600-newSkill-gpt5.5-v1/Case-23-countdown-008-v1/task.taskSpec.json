{
  "userQuery": "帮我弄个倒计时，显示一行带数字的话，点一下能打电话，日历能读呢",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToCallPhone",
      "args": {
        "phoneNumber": "10086"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "title": {
              "type": "string",
              "description": "日历中的纪念日标题",
              "sampleValue": "结婚纪念日"
            },
            "description": {
              "type": "string",
              "description": "纪念日倒计时展示文案，包含数字",
              "sampleValue": "还有 23 天"
            },
            "dtStart": {
              "type": "string",
              "description": "纪念日目标日期展示文本",
              "sampleValue": "08月01日"
            },
            "dtEnd": {
              "type": "string",
              "description": "纪念日日程结束时间或全天标记",
              "sampleValue": "全天"
            },
            "senderName": {
              "type": "string",
              "description": "日历事件来源名称",
              "sampleValue": "本机日历"
            },
            "entityId": {
              "type": "string",
              "description": "日历事件唯一标识符",
              "sampleValue": "calendar-anniversary-001"
            },
            "importantEventType": {
              "type": "integer",
              "description": "重要日类型，2 表示倒数日",
              "sampleValue": 2
            }
          }
        ]
      }
    },
    "contact": {
      "phoneNumber": {
        "type": "string",
        "description": "点击拨号时使用的电话号码",
        "sampleValue": "10086"
      }
    }
  },
  "assetCandidates": []
}
