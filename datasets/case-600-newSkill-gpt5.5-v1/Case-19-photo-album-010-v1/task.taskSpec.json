{
  "userQuery": "整个人脸分组的,能勾选,点进去能操作,看天气,红色危险提示也要有",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "album": {
      "faceGroup": {
        "id": {
          "type": "string",
          "description": "人脸分组标识，用于勾选项取值。",
          "sampleValue": "face-group-family"
        },
        "name": {
          "type": "string",
          "description": "当前人脸分组名称。",
          "sampleValue": "家人分组"
        },
        "countText": {
          "type": "string",
          "description": "当前人脸分组包含的照片数量展示文本。",
          "sampleValue": "128张"
        },
        "checked": {
          "type": "boolean",
          "description": "当前人脸分组是否已勾选。",
          "sampleValue": true
        },
        "riskText": {
          "type": "string",
          "description": "相册管理中的红色危险提示文本。",
          "sampleValue": "需清理重复人脸"
        }
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名称。",
            "sampleValue": "朝阳"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          },
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警级别或提示。",
            "sampleValue": "高温"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/face.svg",
      "description": "简洁人脸轮廓图标，适合表示相册人脸识别、人脸分组或头像占位。"
    },
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "云朵在前、太阳在后的彩色天气图标，适合表示多云或天气速览。"
    }
  ]
}
