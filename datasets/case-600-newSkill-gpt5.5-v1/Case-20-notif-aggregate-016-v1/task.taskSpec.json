{
  "userQuery": "消息聚合卡按紧急程度分组用分隔线。我想要重点是上面那个环形仪表显示处理进度比如65%,旁边动态值显示超时数。点天气部分跳天气App,天气数据要读。素净白底,夜晚渐变,失败告警标红,文字图标,列表可滚动。之前做的太花了,这次想清爽点。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "notifications": {
        "progressPercent": {
          "type": "number",
          "description": "通知处理进度百分比，用于环形进度仪表。",
          "sampleValue": 65
        },
        "progressTotal": {
          "type": "number",
          "description": "通知处理进度总量基准。",
          "sampleValue": 100
        },
        "progressText": {
          "type": "string",
          "description": "通知处理进度展示文本。",
          "sampleValue": "65%"
        },
        "timeoutLabel": {
          "type": "string",
          "description": "当前超时消息数量展示文本。",
          "sampleValue": "超时 4"
        },
        "failureLabel": {
          "type": "string",
          "description": "失败告警数量展示文本，失败状态需要红色强调。",
          "sampleValue": "失败 2"
        },
        "groups": [
          {
            "level": {
              "type": "string",
              "description": "第一组通知紧急程度标签。",
              "sampleValue": "紧急"
            },
            "items": [
              {
                "summary": {
                  "type": "string",
                  "description": "第一组第一条通知摘要。",
                  "sampleValue": "支付失败告警"
                }
              }
            ]
          },
          {
            "level": {
              "type": "string",
              "description": "第二组通知紧急程度标签。",
              "sampleValue": "普通"
            },
            "items": [
              {
                "summary": {
                  "type": "string",
                  "description": "第二组第一条通知摘要。",
                  "sampleValue": "天气预警待查"
                }
              }
            ]
          }
        ]
      },
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气数据对应的区县名称。",
            "sampleValue": "青浦"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气数据对应的城市名称。",
            "sampleValue": "上海"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "26°"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        },
        "weatherSummary": {
          "type": "string",
          "description": "天气胶囊中展示的温度和天气现象摘要。",
          "sampleValue": "26° 多云"
        }
      }
    },
    "assets": {
      "weatherIcon": {
        "type": "string",
        "description": "天气入口使用的多云图标资源路径。",
        "sampleValue": "resources/base/media/partly_cloudy.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "云朵在前、太阳在后的彩色天气图标，适合用于天气入口和天气状态识别。",
      "bindTo": "/assets/weatherIcon"
