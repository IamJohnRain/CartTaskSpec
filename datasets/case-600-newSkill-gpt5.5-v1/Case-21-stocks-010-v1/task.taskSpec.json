{
  "userQuery": "帮我做个卡片,数字会变,点一下跳app,看天气,股票跌了要有红色提醒",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气查询的区县名称",
            "sampleValue": "青浦区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "适合直接显示的当前温度文本",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级",
            "sampleValue": "良"
          }
        }
      }
    },
    "state": {
      "marketAlertText": {
        "type": "string",
        "description": "股票下跌时用于卡片内红色提醒的短文本",
        "sampleValue": "股票下跌"
      },
      "stockAlertColor": {
        "type": "string",
        "description": "股票下跌提醒使用的告警色",
        "sampleValue": "#ffed6f21"
      },
      "loading": {
        "type": "boolean",
        "description": "卡片数据加载态",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色云朵天气图标，适合多云天气速览的主视觉识别。"
    }
  ]
}
