{
  "userQuery": "帮我弄个快递卡片呗 好几个包裹排一起 点一下能跳app 还能看今天天气",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "express": {
        "packageCountText": {
          "type": "string",
          "description": "当前需要关注的包裹数量展示文本。",
          "sampleValue": "3件"
        },
        "packages": {
          "type": "array",
          "description": "按优先级展示的包裹摘要列表。",
          "sampleValue": [
            {
              "name": "包裹1",
              "statusText": "派送中"
            },
            {
              "name": "包裹2",
              "statusText": "待取件"
            }
          ],
          "items": {
            "type": "object",
            "description": "单个包裹摘要。",
            "properties": {
              "name": {
                "type": "string",
                "description": "包裹短名称或序号。",
                "sampleValue": "包裹1"
              },
              "statusText": {
                "type": "string",
                "description": "包裹当前物流状态短文本。",
                "sampleValue": "派送中"
              }
            }
          }
        }
      },
      "weather": {
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "今日当前温度展示文本。",
            "sampleValue": "26℃"
          },
          "condition": {
            "type": "string",
            "description": "今日当前天气现象。",
            "sampleValue": "多云"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/courier_box.png",
      "description": "彩色快递箱图标，适合用于物流卡片的对象识别。"
    },
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "彩色多云天气图标，适合用于今日天气的轻量视觉提示。"
    }
  ]
}
