{
  "userQuery": "帮我弄个天气通知卡片,点一下能跳到app里看",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气查询的区县名称。",
            "sampleValue": "南山区"
          },
          "prefectureName": {
            "type": "string",
            "description": "当前天气查询的城市名称。",
            "sampleValue": "深圳市"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "26°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级。",
            "sampleValue": "良"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比。",
            "sampleValue": 68
          }
        },
        "daily": [
          {
            "temperatureRangeText": {
              "type": "string",
              "description": "今日预报温度范围展示文本。",
              "sampleValue": "24° / 31°"
            },
            "rainProbabilityPercent": {
              "type": "string",
              "description": "今日白天降雨概率百分比。",
              "sampleValue": "20%"
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy.png",
      "description": "云朵组合彩色天气图标，适合用于多云天气通知卡片的主视觉识别。"
    }
  ]
}
