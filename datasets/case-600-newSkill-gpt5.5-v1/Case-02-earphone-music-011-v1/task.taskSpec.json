{
  "userQuery": "做个简洁素净的卡片，能读实时天气情况，上面放一排我跑步歌单的封面，横向铺开排好几项。卡片中间嵌一块磨砂玻璃的面板，里面放个醒目的“一键播放”按钮点开能听歌，背景弄点那种晚上跑步的夜色渐变效果就行了，不用弄特殊状态颜色。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hwmusic://com.huawei.hmsapp.music/showMusicList?code=favoriteSong&type=412"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气查询的区县名称",
            "sampleValue": "南山区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "24°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级",
            "sampleValue": "优"
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "端侧完成天气查询和归一化的时间",
          "sampleValue": "21:18"
        }
      }
    },
    "assets": {
      "coverOne": {
        "type": "string",
        "description": "跑步歌单第一项封面素材路径",
        "sampleValue": "resources/base/media/icon_music.png"
      },
      "coverTwo": {
        "type": "string",
        "description": "跑步歌单第二项封面素材路径",
        "sampleValue": "resources/base/media/icon_run.png"
      },
      "coverThree": {
        "type": "string",
        "description": "跑步歌单第三项封面素材路径",
        "sampleValue": "resources/base/media/icon_earphone.png"
      },
      "coverFour": {
        "type": "string",
        "description": "跑步歌单第四项封面素材路径",
        "sampleValue": "resources/base/media/icon_like.png"
      },
      "weatherIcon": {
        "type": "string",
        "description": "天气支撑信息图标素材路径",
        "sampleValue": "resources/base/media/cloudy.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_music.png",
      "description": "音乐图标，适合用作跑步歌单封面项或音乐服务识别。",
      "bindTo": "/assets/coverOne"
    },
    {
      "src": "resources/base/media/icon_run.png",
      "description": "运动/跑步图标，适合用作跑步歌单封面项。",
      "bindTo": "/assets/coverTwo"
    },
    {
      "src": "resources/base/media/icon_earphone.png",
      "description": "耳机图标，适合表达戴耳机听歌或跑步音乐。",
      "bindTo": "/assets/coverThree"
    },
    {
      "src": "resources/base/media/icon_like.png",
      "description": "收藏/心形图标，适合表达收藏歌单或偏好音乐。",
      "bindTo": "/assets/coverFour"
    },
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色多云天气图标，适合展示实时天气支撑信息。",
      "bindTo": "/assets/weatherIcon"
    }
  ]
}
