{
  "userQuery": "搞个内存卡,点一下能跳到应用里,把今天日历日程也读出来给我看看",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "memory": {
      "title": {
        "type": "string",
        "description": "内存清理卡片标题",
        "sampleValue": "内存清理"
      },
      "usedPercentText": {
        "type": "string",
        "description": "当前内存占用百分比展示文本",
        "sampleValue": "68%"
      },
      "statusText": {
        "type": "string",
        "description": "内存状态短提示",
        "sampleValue": "可释放 1.8GB"
      }
    },
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程唯一标识符",
              "sampleValue": "calendar-event-001"
            },
            "title": {
              "type": "string",
              "description": "今日日程标题",
              "sampleValue": "周会"
            },
            "dtStart": {
              "type": "string",
              "description": "今日日程开始时间",
              "sampleValue": "10:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "今日日程结束时间",
              "sampleValue": "11:00"
            }
          }
        ]
      }
    },
    "action": {
      "label": {
        "type": "string",
        "description": "跳转到清理入口的短动作文案",
        "sampleValue": "去清理"
      }
    },
    "asset": {
      "cleanIcon": {
        "type": "string",
        "description": "清理功能图标素材路径",
        "sampleValue": "resources/base/media/icon_clear.png"
      },
      "scheduleIcon": {
        "type": "string",
        "description": "日程提示图标素材路径",
        "sampleValue": "resources/base/media/icon_schedule.png"
      },
      "actionIcon": {
        "type": "string",
        "description": "清理动作图标素材路径",
        "sampleValue": "resources/base/media/icon_clear.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适合表达内存清理和底部清理动作，PNG 彩色素材。",
      "bindTo": "/asset/cleanIcon"
    },
    {
      "src": "resources/base/media/icon_schedule.png",
      "description": "日程图标，适合表达今天日历日程摘要，PNG 彩色素材。",
      "bindTo": "/asset/scheduleIcon"
    },
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适合表达进入清理应用的动作入口，PNG 彩色素材。",
      "bindTo": "/asset/actionIcon"
    }
  ]
}
