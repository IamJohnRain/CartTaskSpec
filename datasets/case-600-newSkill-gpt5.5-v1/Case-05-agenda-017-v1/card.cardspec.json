{
  "title": "会议倒计时导航卡",
  "description": "会议导航",
  "suggestSize": "2x4",
  "dataBindings": [
    {
      "capabilityId": "calendar.events.search",
      "arguments": {
        "timeInterval": [
          1783497600000,
          1783583999999
        ]
      },
      "writeResultTo": "/data/calendar",
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "description": "日程标题"
                },
                "dtStart": {
                  "type": "string",
                  "description": "事件起始时间，如果是当天的为HH:MM格式"
                },
                "eventLocation": {
                  "type": "string",
                  "description": "日程发生的位置"
                },
                "latitude": {
                  "type": "string",
                  "description": "日程地点纬度"
                },
                "longitude": {
                  "type": "string",
                  "description": "日程地点经度"
                }
              }
            }
          }
        }
      }
    }
  ]
}
