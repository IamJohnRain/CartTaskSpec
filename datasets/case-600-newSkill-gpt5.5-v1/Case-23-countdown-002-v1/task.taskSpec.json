{
  "userQuery": "搞个倒计时卡片 文字放在背景图上面 能从日历读日程",
  "size": "2x2",
  "eventCandidates": [],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日历日程唯一标识符",
              "sampleValue": "calendar_event_anniversary_001"
            },
            "title": {
              "type": "string",
              "description": "用于倒计时展示的日历日程标题",
              "sampleValue": "结婚纪念日"
            },
            "dtStart": {
              "type": "string",
              "description": "日程开始日期或时间展示文本",
              "sampleValue": "07月27日"
            },
            "dtEnd": {
              "type": "string",
              "description": "日程结束日期或时间展示文本",
              "sampleValue": "07月27日"
            },
            "importantEventType": {
              "type": "integer",
              "description": "重要日类型，2 表示倒数日",
              "sampleValue": 2
            }
          }
        ]
      }
    },
    "view": {
      "countdownDays": {
        "type": "string",
        "description": "由日历日程开始日期计算出的剩余天数展示值",
        "sampleValue": "18"
      },
      "countdownUnit": {
        "type": "string",
        "description": "倒计时单位",
        "sampleValue": "天"
      },
      "countdownCaption": {
        "type": "string",
        "description": "倒计时数据来源提示",
        "sampleValue": "来自日历日程"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_schedule2.png",
      "description": "日程图标素材，可作为日历倒计时卡片的背景水印，适合表达从日历读取纪念日或日程。"
    }
  ]
}
