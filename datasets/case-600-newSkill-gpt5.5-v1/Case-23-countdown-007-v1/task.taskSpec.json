{
  "userQuery": "给我做个倒计时，背景图叠字那种，数字会变，点一下跳app，能读日历，显示已连接哈",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日历事件唯一标识符，用于后续详情或端侧更新定位。",
              "sampleValue": "anniversary-001"
            },
            "title": {
              "type": "string",
              "description": "倒计时纪念日的日历事件标题。",
              "sampleValue": "结婚纪念日"
            },
            "dtStart": {
              "type": "string",
              "description": "纪念日发生日期或开始时间展示文本。",
              "sampleValue": "07月16日"
            },
            "dtEnd": {
              "type": "string",
              "description": "纪念日结束时间或全天标识。",
              "sampleValue": "全天"
            },
            "importantEventType": {
              "type": "integer",
              "description": "重要日期类型，2 表示倒数日。",
              "sampleValue": 2
            }
          }
        ]
      }
    },
    "state": {
      "countdownDays": {
        "type": "string",
        "description": "距离纪念日的倒计时天数展示值，由端侧随时间更新。",
        "sampleValue": "07"
      },
      "countdownUnit": {
        "type": "string",
        "description": "倒计时数字的单位。",
        "sampleValue": "天"
      },
      "sourceText": {
        "type": "string",
        "description": "说明倒计时来自日历数据。",
        "sampleValue": "来自日历"
      },
      "connectionText": {
        "type": "string",
        "description": "日历或服务连接状态展示文案。",
        "sampleValue": "已连接"
      },
      "loading": {
        "type": "boolean",
        "description": "日历数据加载状态。",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "日历实心图标，适合用作纪念日倒计时的背景图形和日历数据视觉锚点。"
    }
  ]
