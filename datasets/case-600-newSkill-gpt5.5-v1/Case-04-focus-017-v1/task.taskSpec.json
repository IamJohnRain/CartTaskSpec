{
  "userQuery": "我最近在考证，每天要复习不同科目，给我做个浅色背景的复习专注卡片。中间是个大圆环显示学习进度，下面横着排开好几个科目，像\"距离考试还有45天\"这种文字和数字拼在一起的内容。列表横着滑动能看到每个科目的番茄钟倒计时，全用文字符号代替图标就行。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "cert_exam_plan"
        }
      }
    }
  ],
  "dataModelSchema": {
    "review": {
      "title": {
        "type": "string",
        "description": "复习专注卡片标题",
        "sampleValue": "考证复习"
      },
      "todayFocus": {
        "type": "string",
        "description": "当天主要复习安排",
        "sampleValue": "主攻 综合"
      },
      "streakText": {
        "type": "string",
        "description": "连续复习天数展示文本",
        "sampleValue": "连续 12 天"
      },
      "progressValue": {
        "type": "number",
        "description": "总体学习进度数值",
        "sampleValue": 68
      },
      "progressTotal": {
        "type": "number",
        "description": "总体学习进度总量",
        "sampleValue": 100
      },
      "progressText": {
        "type": "string",
        "description": "总体学习进度百分比文本",
        "sampleValue": "68%"
      },
      "progressCaption": {
        "type": "string",
        "description": "总体学习进度说明",
        "sampleValue": "已完成"
      },
      "examCountdownText": {
        "type": "string",
        "description": "考试倒计时拼接展示文本",
        "sampleValue": "距离考试还有45天"
      },
      "nextPomodoroText": {
        "type": "string",
        "description": "下一段番茄钟状态文本",
        "sampleValue": "25:00"
      },
      "subjects": {
        "type": "array",
        "description": "横向科目复习列表",
        "sampleValue": [
          {
            "name": "综合",
            "timerText": "25:00",
            "mark": "01"
          },
          {
            "name": "法规",
            "timerText": "18:30",
            "mark": "02"
          },
          {
            "name": "实务",
            "timerText": "09:45",
            "mark": "03"
          },
          {
            "name": "案例",
            "timerText": "12:10",
            "mark": "04"
          }
        ],
        "items": {
          "type": "object",
          "description": "单个科目的复习倒计时信息",
          "properties": {
            "name": {
              "type": "string",
              "description": "科目名称",
              "sampleValue": "综合"
            },
            "timerText": {
              "type": "string",
              "description": "该科目的番茄钟倒计时文本",
              "sampleValue": "25:00"
            },
            "mark": {
              "type": "string",
              "description": "用文字符号表示的科目标记",
              "sampleValue": "01"
            }
          }
        }
      }
    }
  },
  "assetCandidates": []
}
