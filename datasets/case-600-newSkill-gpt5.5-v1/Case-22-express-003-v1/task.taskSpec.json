{
  "userQuery": "弄个背景图加文字的物流卡点一下能确认收货还能看天气已送达",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "shipment": {
      "title": {
        "type": "string",
        "description": "物流卡片标题。",
        "sampleValue": "快递物流"
      },
      "status": {
        "type": "string",
        "description": "当前包裹物流状态。",
        "sampleValue": "已送达"
      },
      "summary": {
        "type": "string",
        "description": "物流状态的简短说明。",
        "sampleValue": "包裹已送达门口"
      },
      "trackingNo": {
        "type": "string",
        "description": "脱敏后的运单号摘要。",
        "sampleValue": "SF 4832"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询所在区县名称。",
            "sampleValue": "南山区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/courier_box.png",
      "description": "彩色快递箱子图标，适合物流信息、已送达状态和包裹识别，可作为卡片背景视觉锚点。"
    },
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色云朵天气图标，适合展示当前多云天气或出行天气提示。"
    }
  ]
}
