{
  "userQuery": "弄个股票卡片吧,点一下跳到交易APP,显示已登录那种状态",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.example.trade",
        "abilityName": "com.example.trade.MainAbility",
        "uri": "tradeapp://home"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "stock": {
        "name": {
          "type": "string",
          "description": "股票或自选行情卡片的主标题",
          "sampleValue": "自选股票"
        },
        "priceText": {
          "type": "string",
          "description": "当前关注股票或组合的价格展示文本",
          "sampleValue": "68.42"
        },
        "changeText": {
          "type": "string",
          "description": "当前行情涨跌幅展示文本",
          "sampleValue": "+1.86%"
        },
        "trendLabel": {
          "type": "string",
          "description": "当前行情趋势短标签",
          "sampleValue": "今日上涨"
        },
        "groupName": {
          "type": "string",
          "description": "行情分组或资产关注范围",
          "sampleValue": "自选组合"
        }
      },
      "account": {
        "loginStatus": {
          "type": "string",
          "description": "交易账户登录状态",
          "sampleValue": "已登录"
        },
        "hint": {
          "type": "string",
          "description": "交易账户当前可用状态提示",
          "sampleValue": "交易账户可用"
        },
        "actionLabel": {
          "type": "string",
          "description": "跳转交易应用的动作短文案",
          "sampleValue": "去交易"
        },
        "tipText": {
          "type": "string",
          "description": "交易入口的辅助确认提示",
          "sampleValue": "登录态已确认"
        }
      }
    }
  },
  "assetCandidates": []
}
