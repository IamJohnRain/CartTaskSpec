{
  "title": "ETF观察",
  "description": "涨跌分红",
  "suggestSize": "2x4",
  "dataBindings": [
    {
      "capabilityId": "calendar.events.search",
      "arguments": {
        "title": "ETF分红"
      },
      "writeResultTo": "/data/calendar",
      "outputSchema": {
        "type": "object",
        "properties": {
          "dividendText": {
            "type": "string",
            "description": "从日历能力读取到的ETF分红提醒摘要。"
          },
          "etf0": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "第一只ETF基金简称。"
              },
              "changePercent": {
                "type": "string",
                "description": "第一只ETF涨跌幅展示文本。"
              }
            }
          },
          "etf1": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "第二只ETF基金简称。"
              },
              "changePercent": {
                "type": "string",
                "description": "第二只ETF涨跌幅展示文本。"
              }
            }
          },
          "etf2": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "第三只ETF基金简称。"
              },
              "changePercent": {
                "type": "string",
                "description": "第三只ETF涨跌幅展示文本。"
              },
              "alertText": {
                "type": "string",
                "description": "第三只ETF的红色清盘警告文案。"
              }
            }
          },
          "etf3": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "第四只ETF基金简称。"
              },
              "changePercent": {
                "type": "string",
                "description": "第四只ETF涨跌幅展示文本。"
              }
            }
          }
        }
      }
    }
  ]
}
