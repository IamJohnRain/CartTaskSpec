{
  "userQuery": "给我做个能勾选照片的卡吧，勾完能打电话，天气也能看到",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToCallPhone",
      "args": {
        "phoneNumber": "4008001234"
      }
    }
  ],
  "dataModelSchema": {
    "selection": {
      "photoTitle": {
        "type": "string",
        "description": "当前可勾选的照片名称",
        "sampleValue": "家庭相册"
      },
      "photoCountText": {
        "type": "string",
        "description": "已选照片数量展示文本",
        "sampleValue": "已选 12 张"
      },
      "photoSelected": {
        "type": "boolean",
        "description": "照片是否处于勾选状态",
        "sampleValue": true
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询的区县名称",
            "sampleValue": "朝阳区"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询的城市名称",
            "sampleValue": "北京"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "26°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级",
            "sampleValue": "优"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色云朵天气图标，适合表达多云、阴天等天气状态。"
    },
    {
      "src": "resources/base/media/phone_fill.svg",
      "description": "电话听筒实心图标，适合表达拨打电话动作。"
    }
  ]
}
