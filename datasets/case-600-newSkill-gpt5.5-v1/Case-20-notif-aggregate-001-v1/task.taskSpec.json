{
  "userQuery": "帮我搞个通知卡片 主体是个图 点一下能进微信 能从日历读会议日程 红色紧急提示",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.tencent.mm",
        "abilityName": "com.tencent.mm.ui.LauncherUI",
        "uri": "weixin://"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "从日历读取到的会议日程列表，卡片仅展示第一条会议。",
          "sampleValue": [
            {
              "entityName": "calendar",
              "entityId": "event-001",
              "title": "项目周会",
              "dtStart": "09:30",
              "dtEnd": "10:00",
              "eventLocation": "会议室A"
            }
          ],
          "items": {
            "type": "object",
            "description": "会议日程项。",
            "properties": {
              "entityName": {
                "type": "string",
                "description": "日程内容类别。",
                "sampleValue": "calendar"
              },
              "entityId": {
                "type": "string",
                "description": "日程索引项唯一标识符。",
                "sampleValue": "event-001"
              },
              "title": {
                "type": "string",
                "description": "会议日程标题。",
                "sampleValue": "项目周会"
              },
              "dtStart": {
                "type": "string",
                "description": "会议开始时间，当天事件使用 HH:MM 格式。",
                "sampleValue": "09:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "会议结束时间，当天事件使用 HH:MM 格式。",
                "sampleValue": "10:00"
              },
              "eventLocation": {
                "type": "string",
                "description": "会议地点。",
                "sampleValue": "会议室A"
              }
            }
          }
        }
      }
    },
    "assets": {
      "heroIcon": {
        "type": "string",
        "description": "通知卡片主体日程图标路径，来自允许素材库。",
        "sampleValue": "resources/base/media/icon_schedule.png"
      }
    },
    "status": {
      "alertText": {
        "type": "string",
        "description": "红色紧急提示短文案。",
        "sampleValue": "紧急"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_schedule.png",
      "description": "日程图标，适合用于通知卡片中表达会议日程或当前安排。",
      "bindTo": "/assets/heroIcon"
    }
  ]
}
