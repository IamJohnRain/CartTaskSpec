{
  "userQuery": "搞个缓存清理的卡,里面有几项打勾的,数字会动的那种,点一下能跳到清理app里",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "clean": {
      "title": {
        "type": "string",
        "description": "卡片标题，表示当前服务为缓存清理。",
        "sampleValue": "缓存清理"
      },
      "statusText": {
        "type": "string",
        "description": "当前扫描或清理状态的短文本。",
        "sampleValue": "扫描中"
      },
      "cacheValueText": {
        "type": "string",
        "description": "当前可清理缓存容量的主数值展示文本。",
        "sampleValue": "1.8G"
      },
      "cacheCaption": {
        "type": "string",
        "description": "主数值的辅助说明文本。",
        "sampleValue": "可清理缓存"
      },
      "progressValue": {
        "type": "number",
        "description": "缓存扫描或清理进度当前值。",
        "sampleValue": 68
      },
      "progressTotal": {
        "type": "number",
        "description": "缓存扫描或清理进度总值。",
        "sampleValue": 100
      },
      "checks": {
        "tempFiles": {
          "label": {
            "type": "string",
            "description": "临时文件清理项名称。",
            "sampleValue": "临时文件"
          },
          "selected": {
            "type": "boolean",
            "description": "临时文件清理项是否已勾选。",
            "sampleValue": true
          }
        },
        "appCache": {
          "label": {
            "type": "string",
            "description": "应用缓存清理项名称。",
            "sampleValue": "应用缓存"
          },
          "selected": {
            "type": "boolean",
            "description": "应用缓存清理项是否已勾选。",
            "sampleValue": true
          }
        },
        "logs": {
          "label": {
            "type": "string",
            "description": "日志残留清理项名称。",
            "sampleValue": "日志残留"
          },
          "selected": {
            "type": "boolean",
            "description": "日志残留清理项是否已勾选。",
            "sampleValue": true
          }
        }
      },
      "actionLabel": {
        "type": "string",
        "description": "跳转到清理应用或存储清理入口的按钮文案。",
        "sampleValue": "去清理"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适用于缓存清理、垃圾清理或清理无忧场景，可作为卡片识别图标。"
    }
  ]
}
