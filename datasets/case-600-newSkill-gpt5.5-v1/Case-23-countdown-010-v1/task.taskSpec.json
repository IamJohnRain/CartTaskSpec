{
  "userQuery": "期末考试倒计时，点按钮进复习app，从日历读，弹提醒说快挂了",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日历事件唯一标识，用于打开对应考试日程详情。",
              "sampleValue": "exam-final-001"
            },
            "title": {
              "type": "string",
              "description": "从日历读取的期末考试日程标题。",
              "sampleValue": "期末考试"
            },
            "dtStart": {
              "type": "string",
              "description": "期末考试开始日期或时间展示文本。",
              "sampleValue": "7月15日 09:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "期末考试结束日期或时间展示文本。",
              "sampleValue": "11:00"
            },
            "importantEventType": {
              "type": "integer",
              "description": "重要日类型，2 表示倒数日。",
              "sampleValue": 2
            },
            "remindTime": [
              {
                "type": "string",
                "description": "日程提醒时间文本。",
                "sampleValue": "提前1天提醒"
              }
            ]
          }
        ]
      }
    },
    "ui": {
      "daysLeftText": {
        "type": "string",
        "description": "根据日历考试日期预计算的剩余天数字符串。",
        "sampleValue": "6"
      },
      "daysUnit": {
        "type": "string",
        "description": "倒计时单位。",
        "sampleValue": "天"
      },
      "warningText": {
        "type": "string",
        "description": "临近期末考试的提醒语。",
        "sampleValue": "快挂了，赶紧复习"
      },
      "reviewTargetText": {
        "type": "string",
        "description": "复习入口说明。",
        "sampleValue": "去复习"
      }
    },
    "assets": {
      "calendarIcon": {
        "type": "string",
        "description": "日历图标资源路径。",
        "sampleValue": "resources/base/media/calendar_fill.svg"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "日历实心图标，适合用于日程管理、日历事件查看和当日安排。",
      "bindTo": "/assets/calendarIcon"
    }
  ]
}
