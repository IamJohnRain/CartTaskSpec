{
  "userQuery": "做个深色舞台风的时间管理卡片，左边是信息区放日程，右边是动作区放操作。背景叠加几个图层，最底下是日程列表纵向排列，上面浮着一个环形进度条，圆环中心叠加大号数字显示我今天的专注力得分。日程上的准备工作项能双向绑定勾选，如果某项议程临近开始还没确认，就变成黄色风险状态。日程从日历同步，点一下信息区能直接进日程详情，加上时钟语义图标。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "evt-focus-001"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
