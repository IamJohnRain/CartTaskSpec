            },
            "dtEnd": {
              "type": "string",
              "description": "下一项日程结束时间，今天内展示为 HH:MM。",
              "sampleValue": "15:10"
            }
          },
          {
            "title": {
              "type": "string",
              "description": "今天同步到的后一项日程标题。",
              "sampleValue": "设计评审"
            },
            "dtStart": {
              "type": "string",
              "description": "后一项日程开始时间，今天内展示为 HH:MM。",
              "sampleValue": "16:00"
            }
          }
        ]
      }
    },
    "ui": {
      "focusScore": {
        "type": "string",
        "description": "今天的专注力得分，用于环形进度中心的大号数字。",
        "sampleValue": "86"
      },
      "focusProgress": {
