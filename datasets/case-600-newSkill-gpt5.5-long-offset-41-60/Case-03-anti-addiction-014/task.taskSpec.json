{
  "userQuery": "我想给小孩弄个夏日放假玩手机管控卡片，带浅蓝底色，背景能根据读取到的天气数据变成晴天的氛围渐变。顶部加个可勾选的选项“今日作业完成”，勾选后显示绿色的正向达成状态。旁边放个动态的今日已用屏幕时间比如“120分钟”。用系统里的小盾牌图标做装饰，加个急促的橙色渐变提醒他们抓紧时间，最后放个按钮点了能去系统设置里改应用时长限制。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询的区县名称。",
            "sampleValue": "青浦区"
          }
        },
        "current": {
          "condition": {
            "type": "string",
            "description": "当前天气现象，用于判断晴天氛围。",
            "sampleValue": "晴"
          },
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "31°C"
          }
        }
      },
      "screenControl": {
        "homeworkDone": {
          "type": "boolean",
          "description": "今日作业是否已经完成。",
          "sampleValue": true
        },
        "homeworkStatusText": {
          "type": "string",
          "description": "作业完成后的正向状态文案。",
          "sampleValue": "已达成"
        },
        "screenTimeUsedText": {
          "type": "string",
          "description": "今日已使用屏幕时间展示文本。",
          "sampleValue": "120分钟"
        },
        "weatherGradientStart": {
          "type": "string",
          "description": "根据天气归一化后的卡片背景渐变起色，晴天时为浅蓝。",
          "sampleValue": "#E5F7FF"
        },
        "weatherGradientEnd": {
          "type": "string",
          "description": "根据天气归一化后的卡片背景渐变止色，晴天时为更亮的天空蓝。",
          "sampleValue": "#BFEAFF"
        }
      }
    }
  },
