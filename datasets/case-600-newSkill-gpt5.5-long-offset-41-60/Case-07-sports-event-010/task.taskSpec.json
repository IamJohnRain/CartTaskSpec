{
  "userQuery": "我每周都打篮球联赛，帮我做个赛事总览卡片，主题绿色背景，左边显示我所在球队的战绩积分18胜5负，右边横向排列展示接下来三场比赛的时间和对手，分别显示主场客场图标。如果输球超过10分用红色告警标出来\"需调整战术\"，点进去能直接跳运动健康看训练建议。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    }
  ],
  "dataModelSchema": {
    "league": {
      "title": {
        "type": "string",
        "description": "赛事总览卡片标题",
        "sampleValue": "篮球联赛"
      },
      "teamLabel": {
        "type": "string",
        "description": "用户所在球队标签",
        "sampleValue": "我的球队"
      },
      "recordText": {
        "type": "string",
        "description": "球队当前战绩积分展示文本",
        "sampleValue": "18胜5负"
      },
      "statusText": {
        "type": "string",
        "description": "当前战绩状态短文案",
        "sampleValue": "第2"
      },
      "alertText": {
        "type": "string",
        "description": "输球超过10分时展示的红色告警文案",
        "sampleValue": "需调整战术"
      },
      "actionText": {
        "type": "string",
        "description": "跳转运动健康查看训练建议的动作文案",
        "sampleValue": "训练建议"
      },
      "matches": [
        {
          "timeText": {
            "type": "string",
            "description": "下一场比赛时间展示文本",
            "sampleValue": "周三 19:30"
          },
          "opponent": {
            "type": "string",
            "description": "下一场比赛对手简称",
            "sampleValue": "猎鹰"
          },
          "venueText": {
            "type": "string",
            "description": "下一场比赛主客场文本",
            "sampleValue": "主场"
          },
          "venueIcon": {
            "type": "string",
            "description": "下一场比赛主客场图标资源路径",
            "sampleValue": "resources/base/media/house_fill.svg"
          }
        },
        {
          "timeText": {
            "type": "string",
            "description": "第二场比赛时间展示文本",
            "sampleValue": "周六 15:00"
          },
          "opponent": {
            "type": "string",
            "description": "第二场比赛对手简称",
            "sampleValue": "海浪"
          },
          "venueText": {
            "type": "string",
            "description": "第二场比赛主客场文本",
            "sampleValue": "客场"
          },
          "venueIcon": {
            "type": "string",
            "description": "第二场比赛主客场图标资源路径",
            "sampleValue": "resources/base/media/local_fill.svg"
          }
        },
        {
          "timeText": {
            "type": "string",
            "description": "第三场比赛时间展示文本",
            "sampleValue": "下周二 20:00"
          },
          "opponent": {
            "type": "string",
            "description": "第三场比赛对手简称",
            "sampleValue": "山猫"
          },
          "venueText": {
            "type": "string",
            "description": "第三场比赛主客场文本",
            "sampleValue": "主场"
          },
          "venueIcon": {
            "type": "string",
            "description": "第三场比赛主客场图标资源路径",
            "sampleValue": "resources/base/media/house_fill.svg"
          }
        }
      ]
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/house_fill.svg",
      "description": "房屋实心图标，用于表示篮球比赛主场身份，需放在浅色图标底板上保证绿色背景可读。",
      "bindTo": "/league/matches/0/venueIcon"
    },
    {
      "src": "resources/base/media/local_fill.svg",
      "description": "定位实心图标，用于表示篮球比赛客场或外场地点，需放在浅色图标底板上保证绿色背景可读。",
      "bindTo": "/league/matches/1/venueIcon"
    },
    {
      "src": "resources/base/media/house_fill.svg",
      "description": "房屋实心图标，用于表示第三场篮球比赛主场身份，需放在浅色图标底板上保证绿色背景可读。",
      "bindTo": "/league/matches/2/venueIcon"
    }
  ]
}
