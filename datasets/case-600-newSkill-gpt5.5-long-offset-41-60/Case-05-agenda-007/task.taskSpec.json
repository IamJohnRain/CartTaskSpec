        "sampleValue": "洗漱"
      },
      "sleepText": {
        "type": "string",
        "description": "固定的睡觉打卡项文本。",
        "sampleValue": "睡觉"
      },
      "wakeText": {
        "type": "string",
        "description": "固定的早起打卡项文本。",
        "sampleValue": "早起打卡"
      }
    },
    "asset": {
      "moonIcon": {
        "type": "string",
        "description": "夜间睡眠场景的月亮图标素材路径。",
        "sampleValue": "resources/base/media/icon_sleep.png"
      }
    },
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "今日日历日程结果列表，用于端侧保持日历能力契约。",
          "sampleValue": []
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_sleep.png",
      "description": "睡眠图标，适合用于深色夜间倒计时卡片顶部的月亮/睡眠视觉锚点。",
      "bindTo": "/asset/moonIcon"
    }
  ]
}
