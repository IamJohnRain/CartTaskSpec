{
  "userQuery": "帮我做个深色底色的倒计时卡片，顶部放个大号的月亮图标和当前时间，下面用分隔线划出三个区块，写上固定的洗漱、睡觉和早起打卡项，底部加个按钮能直接跳到闹钟应用去定表。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.clock",
        "abilityName": "com.huawei.hmos.clock.phone",
        "uri": ""
      }
    }
  ],
  "dataModelSchema": {
    "time": {
      "currentTimeText": {
        "type": "string",
        "description": "当前时间展示文本，使用 HH:MM 格式。",
