{
  "userQuery": "想做个深色舞台风的睡眠设置卡片，背景用夜晚蓝紫渐变。卡片用分隔线分三大块：天气提醒块、睡眠数据块、优化建议块。睡眠时长那块显示一个动态数字比如\"6.2小时\"。最下面是可滚动的重复列表，每项是一种睡眠优化建议比如\"关屏提醒\"\"减少蓝光\"\"启用免扰\"，前面带勾选框可选。末尾一个\"去设置\"按钮跳到系统设置里的应用时长页面。要是昨晚睡得不够，标题要标红。图标用月牙、音符这种语义图标。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询的区县名称。",
            "sampleValue": "朝阳区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "23°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比。",
            "sampleValue": 68
          }
        }
      }
    },
    "sleep": {
      "title": {
        "type": "string",
        "description": "睡眠卡片标题。",
        "sampleValue": "昨晚睡眠不足"
      },
      "titleColor": {
        "type": "string",
        "description": "标题状态色，睡眠不足时使用警示红色。",
        "sampleValue": "#FFD94838"
      },
      "durationText": {
        "type": "string",
        "description": "昨晚睡眠时长展示文本。",
        "sampleValue": "6.2小时"
      },
      "durationCaption": {
        "type": "string",
        "description": "睡眠时长说明。",
        "sampleValue": "目标 8小时"
      },
      "ambientHint": {
        "type": "string",
        "description": "睡前环境或音乐提示。",
        "sampleValue": "轻音乐"
      },
      "suggestions": {
        "0": {
          "label": {
            "type": "string",
            "description": "第一条睡眠优化建议。",
            "sampleValue": "关屏提醒"
          },
          "checked": {
            "type": "boolean",
            "description": "第一条建议是否已选择。",
            "sampleValue": true
          }
        },
        "1": {
          "label": {
            "type": "string",
            "description": "第二条睡眠优化建议。",
            "sampleValue": "减少蓝光"
          },
          "checked": {
            "type": "boolean",
            "description": "第二条建议是否已选择。",
            "sampleValue": false
          }
        },
        "2": {
          "label": {
            "type": "string",
            "description": "第三条睡眠优化建议。",
            "sampleValue": "启用免扰"
          },
          "checked": {
            "type": "boolean",
            "description": "第三条建议是否已选择。",
            "sampleValue": true
          }
        }
      }
    },
    "assets": {
      "sleepIcon": {
        "type": "string",
        "description": "睡眠语义图标素材路径。",
        "sampleValue": "resources/base/media/icon_sleep.png"
      },
      "musicIcon": {
        "type": "string",
        "description": "音乐语义图标素材路径。",
        "sampleValue": "resources/base/media/icon_music.png"
      }
    },
    "state": {
      "loading": {
        "type": "boolean",
        "description": "数据加载状态。",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_sleep.png",
      "description": "彩色睡眠图标，适合在深色睡眠监督卡片中表达月夜与睡眠状态。",
      "bindTo": "/assets/sleepIcon"
    },
    {
      "src": "resources/base/media/icon_music.png",
      "description": "彩色音乐图标，适合表达睡前轻音乐或助眠声音建议。",
      "bindTo": "/assets/musicIcon"
    }
  ]
}
