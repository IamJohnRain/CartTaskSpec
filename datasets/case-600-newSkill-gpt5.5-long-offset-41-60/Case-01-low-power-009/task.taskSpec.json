{
  "userQuery": "整卡主题色背景，中央仪表盘环形显示当前电量，环形焦点周围横向排列几个数据条，分别\"今日已耗电XX%\" \"后台占比XX%\" \"亮屏XX小时\"，点环形跳系统省电设置，读取日历日程，15%以下黄色待处理，纯文字色块，不用图片和渐变。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "battery": {
        "level": {
          "type": "number",
          "description": "当前电量百分比数值，用于环形仪表进度。",
          "sampleValue": 12
        },
        "levelText": {
          "type": "string",
          "description": "当前电量展示文本。",
          "sampleValue": "12%"
        },
        "todayUsedText": {
          "type": "string",
          "description": "今日已耗电比例展示文本。",
          "sampleValue": "今日已耗电 38%"
        },
        "backgroundShareText": {
          "type": "string",
          "description": "后台耗电占比展示文本。",
          "sampleValue": "后台占比 24%"
        },
        "screenOnText": {
          "type": "string",
          "description": "今日亮屏时长展示文本。",
          "sampleValue": "亮屏 3.2小时"
        },
        "statusText": {
          "type": "string",
          "description": "低电量状态提示文本。",
          "sampleValue": "15%以下待处理"
        },
        "statusColor": {
          "type": "string",
          "description": "低电量状态色，低于15%时使用黄色警示色。",
          "sampleValue": "#ffe84026"
