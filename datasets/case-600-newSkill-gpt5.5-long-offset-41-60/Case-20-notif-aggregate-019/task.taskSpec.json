        },
        "checked": {
          "type": "boolean",
          "description": "第二条会议通知是否已纳入勿扰",
          "sampleValue": true
        }
      }
    ]
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/bell_slash_fill.svg",
