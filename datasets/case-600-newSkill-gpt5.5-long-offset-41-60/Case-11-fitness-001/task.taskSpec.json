{
  "userQuery": "简洁运动卡片,左边主视觉,环形进度显示动态步数值(比如今天走了多少步)。读天气数据,适合夜晚的渐变,文字做图标,横向重复排列多项。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询对应的区县名称。",
            "sampleValue": "浦东"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "18°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比。",
            "sampleValue": 62
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级。",
            "sampleValue": "优"
          }
        }
      },
      "fitness": {
        "today": {
          "stepCount": {
            "type": "number",
            "description": "今天已完成步数。",
            "sampleValue": 8236
          },
          "stepText": {
            "type": "string",
            "description": "今天已完成步数的展示文本。",
            "sampleValue": "8236"
          },
          "stepGoal": {
            "type": "number",
            "description": "今天步数目标。",
            "sampleValue": 10000
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_run.png",
      "description": "运动跑步图标，适合用于健康运动卡片中的主视觉识别。"
    },
    {
      "src": "resources/base/media/moon_circle_fill.svg",
      "description": "月亮圆形图标，适合用于夜间模式或夜晚场景提示。"
    },
    {
      "src": "resources/base/media/cloudy.png",
      "description": "彩色云朵天气图标，适合用于多云天气状态展示。"
    }
  ]
