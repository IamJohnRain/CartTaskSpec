{
  "userQuery": "做张宝宝生日相册卡,浅粉底+黄昏氛围渐变。左边用文字字符⊞做日历图标,右边信息区显示\"距离宝宝生日还有 12 天\"这种固定文字+动态数值拼接,下面\"查看活动日程\"按钮点了能进入10/15 14:00 生日派对这条日历事件。右上角红色感叹号提示\"上次备份失败 3张照片未同步\"危险告警,左右分区不用列表。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/0/entityId} }}"
        }
      }
    }
  ],
