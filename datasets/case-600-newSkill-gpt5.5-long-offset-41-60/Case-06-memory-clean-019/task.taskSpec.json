{
  "userQuery": "帮我做个浅色底的内存清理卡片，左边上下竖着排几行文字图标（比如“内存”、“电量”、“步数”），标着电量只剩15%快没电了，颜色得是个黄变红的警示渐变色提醒我，右边放个一键清理按钮，点一下能释放空间，点这些数据还能直接跳到运动健康应用里看详情。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    },
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "card": {
      "title": {
        "type": "string",
        "description": "卡片对象标题，表示当前是内存清理状态。",
        "sampleValue": "内存"
      }
    },
    "metrics": {
      "memory": {
        "label": {
          "type": "string",
          "description": "内存指标名称。",
          "sampleValue": "内存"
        },
        "valueText": {
          "type": "string",
          "description": "当前内存占用或可清理状态的短文本。",
          "sampleValue": "64%"
        }
      },
      "battery": {
        "label": {
          "type": "string",
          "description": "电量指标名称。",
          "sampleValue": "电量"
        },
        "valueText": {
          "type": "string",
          "description": "低电量告警展示值。",
          "sampleValue": "15%"
        }
      },
      "steps": {
        "label": {
          "type": "string",
          "description": "步数指标名称。",
          "sampleValue": "步数"
        },
        "valueText": {
          "type": "string",
          "description": "今日步数短格式。",
          "sampleValue": "6k"
        }
      }
    },
    "asset": {
      "memoryIcon": {
        "type": "string",
        "description": "内存或存储状态图标路径。",
        "sampleValue": "resources/base/media/externaldrive_fill.svg"
      },
      "batteryIcon": {
        "type": "string",
        "description": "电量状态图标路径。",
        "sampleValue": "resources/base/media/icon_electricity.png"
      },
      "stepsIcon": {
        "type": "string",
        "description": "步数运动图标路径。",
        "sampleValue": "resources/base/media/icon_run.png"
      }
    },
    "action": {
      "label": {
        "type": "string",
        "description": "清理动作按钮的短文案。",
        "sampleValue": "清理"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/externaldrive_fill.svg",
      "description": "外置存储设备实心图标，适合表达内存或存储管理状态。",
      "bindTo": "/asset/memoryIcon"
    },
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "电池图标，适合表达低电量状态。",
      "bindTo": "/asset/batteryIcon"
    },
    {
      "src": "resources/base/media/icon_run.png",
      "description": "运动跑步图标，适合表达步数和运动健康入口。",
      "bindTo": "/asset/stepsIcon"
    }
  ]
}
