{
  "userQuery": "工作日聚合卡,上面读今天天气(下雨要标),中间环形显示已处理消息数,下面用分隔线分三块:待办、紧急、群消息,待办快超时的标橙,磨砂玻璃质感。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气查询的区县名称",
            "sampleValue": "青浦区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "23°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "小雨"
          },
          "alertLevel": {
            "type": "string",
            "description": "天气预警或降雨提示",
            "sampleValue": "雨天"
          }
        }
      },
      "messages": {
        "processedCount": {
          "type": "number",
          "description": "工作日已处理消息数量",
          "sampleValue": 42
        },
        "processedTotal": {
          "type": "number",
          "description": "工作日预计需要处理的消息总量",
          "sampleValue": 60
        },
        "processedLabel": {
          "type": "string",
          "description": "已处理消息指标标签",
          "sampleValue": "已处理"
        },
        "todoCountText": {
          "type": "string",
          "description": "待办消息数量展示文本",
          "sampleValue": "7项"
        },
        "todoStatusText": {
          "type": "string",
          "description": "待办临近超时状态提示",
          "sampleValue": "2项快超时"
        },
        "urgentCountText": {
          "type": "string",
          "description": "紧急消息数量展示文本",
          "sampleValue": "3条"
        },
        "urgentStatusText": {
          "type": "string",
          "description": "紧急消息处理状态提示",
          "sampleValue": "需今天处理"
        },
        "groupCountText": {
          "type": "string",
          "description": "群消息数量展示文本",
          "sampleValue": "18条"
        },
        "groupStatusText": {
          "type": "string",
          "description": "群消息摘要状态",
          "sampleValue": "5个群有更新"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合彩色天气图标，适合用于下雨天气状态识别。"
    }
  ]
}
