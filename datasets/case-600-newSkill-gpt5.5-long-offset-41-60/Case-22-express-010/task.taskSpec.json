              "dtStart": "明天",
              "dtEnd": "明天"
            },
            {
              "entityName": "calendar",
              "entityId": "evt-2025",
              "title": "#2025",
              "dtStart": "后天",
              "dtEnd": "后天"
            },
            {
              "entityName": "calendar",
              "entityId": "evt-2026",
              "title": "#2026",
              "dtStart": "周五",
              "dtEnd": "周五"
            }
          ],
          "items": {
            "type": "object",
            "description": "单个快递包裹对应的日历事件。",
            "properties": {
              "entityName": {
                "type": "string",
                "description": "内容类别。",
