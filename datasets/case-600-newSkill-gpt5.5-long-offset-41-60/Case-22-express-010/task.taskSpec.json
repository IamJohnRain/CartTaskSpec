              },
              "dtStart": {
                "type": "string",
                "description": "预计到达日期展示文本。",
                "sampleValue": "明天"
              },
              "dtEnd": {
                "type": "string",
                "description": "预计到达结束日期展示文本。",
                "sampleValue": "明天"
              }
            }
          }
        }
      }
    }
  },
