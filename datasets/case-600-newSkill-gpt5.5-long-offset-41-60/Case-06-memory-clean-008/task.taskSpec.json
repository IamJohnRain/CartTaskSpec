{
  "userQuery": "手机太卡了，想弄个简洁素净的存储卡片。中间是个有冲刺感渐变色的仪表盘，各种垃圾文件信息要用分隔线分组。最好能勾选要不要清理微信缓存，显示电量20%的红色风险提示。不用放图片，就纯色块和文字，底下那些重复文件不用做成列表，记得加个能跳到系统应用时长设置的入口。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "storage": {
      "title": {
        "type": "string",
        "description": "卡片标题，描述手机存储清理场景。",
        "sampleValue": "存储清理"
      },
      "junkTotalText": {
        "type": "string",
        "description": "当前建议清理的垃圾文件总量展示文本。",
        "sampleValue": "8.6GB"
      },
      "cleanScore": {
        "type": "number",
        "description": "仪表盘进度值，表示当前可优化程度。",
        "sampleValue": 72
      },
      "cleanScoreTotal": {
        "type": "number",
        "description": "仪表盘进度总值。",
        "sampleValue": 100
      },
      "statusText": {
        "type": "string",
        "description": "清理建议状态文案。",
        "sampleValue": "建议立即清理"
      },
      "batteryRiskText": {
        "type": "string",
        "description": "电量低风险提示文本。",
        "sampleValue": "电量20% 风险"
      },
      "cacheLabel": {
        "type": "string",
        "description": "缓存文件分组名称。",
        "sampleValue": "缓存垃圾"
      },
      "cacheSizeText": {
        "type": "string",
