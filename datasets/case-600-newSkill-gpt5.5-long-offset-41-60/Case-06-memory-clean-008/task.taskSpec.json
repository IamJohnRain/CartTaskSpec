        "sampleValue": "微信缓存"
      },
      "duplicateText": {
        "type": "string",
        "description": "重复文件摘要文本，不以列表形式展开。",
        "sampleValue": "重复文件 1.1GB"
      },
      "actionLabel": {
        "type": "string",
        "description": "跳转到系统应用时长设置的入口文案。",
        "sampleValue": "应用时长"
      }
