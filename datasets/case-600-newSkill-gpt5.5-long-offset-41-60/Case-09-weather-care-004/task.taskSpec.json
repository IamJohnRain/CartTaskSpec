{
  "userQuery": "帮我做个带浅色底色的倒计时天气卡片，背景搞个夜晚星空的渐变。卡片上面横着排开三天的天气预报，全是固定文字提示，比如“明天大雨大风”，遇到台风这种危险天气就用红色预警标记起来。随便挑一个城市的数据就行，最后给我老婆留个一键拨打电话的图标功能。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToCallPhone",
      "args": {
        "phoneNumber": "13800000000"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询区县名称。",
