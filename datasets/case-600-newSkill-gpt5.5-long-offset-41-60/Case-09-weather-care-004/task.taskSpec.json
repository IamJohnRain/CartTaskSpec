    "asset": {
      "callIcon": {
        "type": "string",
        "description": "拨打电话动作图标素材路径。",
        "sampleValue": "resources/base/media/icon_call.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_call.png",
      "description": "电话图标，适合用于亲人关怀场景中的一键拨打动作入口。",
      "bindTo": "/asset/callIcon"
    }
  ]
