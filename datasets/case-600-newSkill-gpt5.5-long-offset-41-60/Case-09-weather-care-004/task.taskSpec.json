          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询城市名称。",
            "sampleValue": "深圳"
          }
        },
        "current": {
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警提示文本。",
            "sampleValue": "台风红色预警"
          }
        },
        "daily": [
          {
            "weekday": {
              "type": "string",
              "description": "第一天预报日期短标签。",
              "sampleValue": "明天"
            },
            "condition": {
              "type": "string",
              "description": "第一天固定天气提示。",
              "sampleValue": "大雨大风"
            }
          },
          {
            "weekday": {
              "type": "string",
              "description": "第二天预报日期短标签。",
              "sampleValue": "后天"
            },
            "condition": {
              "type": "string",
              "description": "第二天固定天气提示。",
              "sampleValue": "阵雨转阴"
            }
          },
          {
            "weekday": {
              "type": "string",
              "description": "第三天预报日期短标签。",
              "sampleValue": "周五"
            },
            "condition": {
              "type": "string",
              "description": "第三天固定危险天气提示。",
              "sampleValue": "台风靠近"
            }
          }
        ]
      }
    },
    "countdown": {
      "value": {
        "type": "string",
        "description": "倒计时天气提示短文本。",
        "sampleValue": "2天后"
      }
