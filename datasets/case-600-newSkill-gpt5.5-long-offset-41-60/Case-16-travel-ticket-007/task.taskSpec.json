{
  "userQuery": "想做一个本月出行总览卡,顶部固定文案介绍有几趟行程、累计多少公里,点击某次能跳进日历看具体日程,整张卡用品牌主色背景,左右信息+动作分区,有航班取消时红色警告,夜晚渐变,纯文字和色块,不用图片,也不要列表。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "trip_evt_001"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "travelSummary": {
          "tripCountText": {
            "type": "string",
            "description": "本月行程趟数展示文本",
            "sampleValue": "3趟"
          },
          "totalDistanceValue": {
            "type": "string",
            "description": "本月累计出行公里数数值文本",
            "sampleValue": "2680"
          },
          "alertText": {
            "type": "string",
            "description": "本月行程中航班取消的告警短文本",
            "sampleValue": "取消"
          },
          "nextTimeText": {
            "type": "string",
            "description": "可点击查看详情的首条行程出发时间",
            "sampleValue": "07/18"
          },
          "nextRouteText": {
            "type": "string",
            "description": "可点击查看详情的首条行程路线短文本",
            "sampleValue": "浦东-北京"
          },
          "nextStatusText": {
            "type": "string",
            "description": "可点击查看详情的首条行程状态短文本",
            "sampleValue": "20:30 起飞"
          }
        },
        "items": [
          {
            "entityId": {
              "type": "string",
