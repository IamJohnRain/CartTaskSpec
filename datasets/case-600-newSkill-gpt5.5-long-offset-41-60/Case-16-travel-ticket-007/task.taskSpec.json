            },
            "title": {
              "type": "string",
              "description": "日历中的票务行程标题",
              "sampleValue": "浦东-北京航班"
            },
            "dtStart": {
              "type": "string",
              "description": "日历中的行程开始时间",
              "sampleValue": "07/18 20:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "日历中的行程结束时间",
              "sampleValue": "07/18 22:45"
            }
          }
        ]
      }
    }
  },
