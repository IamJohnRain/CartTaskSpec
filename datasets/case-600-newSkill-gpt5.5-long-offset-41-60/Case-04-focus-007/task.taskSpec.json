{
  "userQuery": "每天通勤路上想搞个碎片化专注卡片，表面用浅色调，左侧用大色块拼出倒计时主视觉。右边纵向叠放显示日历的待办事项和专注进度数据，如果这一段目标完成就用绿色正向状态表示。不用加图片，纯文字色块就行，点一下能直接跳到闹钟应用，背景加点那种有紧迫感的红色渐变。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.clock",
        "abilityName": "com.huawei.hmos.clock.phone",
        "uri": ""
      }
    }
  ],
