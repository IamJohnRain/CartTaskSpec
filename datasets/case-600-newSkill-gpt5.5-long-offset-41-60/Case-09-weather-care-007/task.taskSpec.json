{
  "userQuery": "给我老婆做个天气关怀卡片，界面简洁点，视觉主体用文字符号拼成的云朵和雨伞形状，卡片里嵌个桌面小组件块，弄个“已添衣”的勾选状态交互项，卡片整体加上天气场景的渐变背景，不需要特殊状态色，点一下卡片能跳转到天气APP里看详细降雨。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询的区县名称",
            "sampleValue": "青浦区"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询的城市名称",
            "sampleValue": "上海市"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "22°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "小雨"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比",
            "sampleValue": 86
          },
          "coldLevel": {
            "type": "string",
            "description": "感冒指数或添衣建议",
            "sampleValue": "易感冒"
          }
        },
        "daily": {
          "type": "array",
          "description": "从今天开始按日期升序排列的每日天气预报",
          "items": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "description": "预报星期文本",
                "sampleValue": "今天"
              },
              "condition": {
                "type": "string",
                "description": "白天天气现象",
                "sampleValue": "阵雨"
              },
              "temperatureRangeText": {
                "type": "string",
                "description": "当天温度范围展示文本",
                "sampleValue": "19° / 24°"
              },
              "rainProbabilityPercent": {
                "type": "string",
                "description": "白天降雨概率百分比",
                "sampleValue": "78%"
              }
            }
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "端侧完成天气查询和归一化的时间",
          "sampleValue": "08:30"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合的彩色天气图标，可用于天气或出行场景。"
    },
    {
      "src": "resources/base/media/icon_weather1.png",
      "description": "亲人关怀场景的天气/雨伞图标，可用于表达雨天关怀和添衣提醒。"
    }
  ]
}
