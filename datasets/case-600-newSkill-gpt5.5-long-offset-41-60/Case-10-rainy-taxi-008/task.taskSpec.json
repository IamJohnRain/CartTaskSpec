{
  "userQuery": "帮我做个打车卡片，要以图标当主体，配几个勾选项让我选叫车平台和是否接受拼车。左边一块底色放天气图标和温度，右边一块底色放动作区。要是叫车超时取消要标红色告警。中间有个按钮能跳到天气应用看详细预报，下雨天自动弹出来。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气查询的区县名称。",
            "sampleValue": "雨花区"
          },
          "cityCode": {
            "type": "string",
            "description": "天气应用城市代码，可用于天气详情页定位城市。",
            "sampleValue": "101250101"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "18°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "小雨"
          },
          "alertLevel": {
            "type": "string",
            "description": "天气预警等级或提示。",
            "sampleValue": "雨天"
          }
        }
      }
    },
    "taxi": {
      "statusText": {
        "type": "string",
        "description": "当前叫车状态提示。",
        "sampleValue": "雨天叫车"
      },
      "timeoutAlertText": {
        "type": "string",
        "description": "叫车超时取消时显示的红色告警文案。",
        "sampleValue": "超时取消"
      },
      "platformASelected": {
        "type": "boolean",
        "description": "是否默认选择平台 A。",
        "sampleValue": true
      },
      "platformBSelected": {
        "type": "boolean",
        "description": "是否默认选择平台 B。",
        "sampleValue": false
      },
      "acceptCarpool": {
        "type": "boolean",
        "description": "是否接受拼车。",
        "sampleValue": true
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_car.png",
      "description": "汽车/打车彩色图标，适合用于雨天打车卡片的主体识别。"
    },
    {
      "src": "resources/base/media/icon_weathe2.png",
      "description": "天气彩色图标，适合用于雨天打车左侧天气面板。"
    }
  ]
}
