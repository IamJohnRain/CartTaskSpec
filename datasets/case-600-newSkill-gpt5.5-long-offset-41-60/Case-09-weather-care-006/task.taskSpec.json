{
  "userQuery": "帮我做个极简素净的跑步天气关怀卡片，读取今天的天气数据，把晨跑步数动态显示在一个环形进度条的中心叠层里，如果空气质量指数临近超标变成风险状态标红，整体背景用那种适合运动冲刺的深色渐变，点卡片能直接跳到天气APP看详情，旁边加个跑步的小图标就行。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气查询的区县名称",
            "sampleValue": "朝阳区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "18°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级",
            "sampleValue": "良"
          },
          "aqiRiskText": {
            "type": "string",
            "description": "面向晨跑的空气质量风险提示",
            "sampleValue": "AQI 临界"
          },
          "aqiStatusColor": {
            "type": "string",
            "description": "空气质量临近超标时用于状态文字和进度强调的颜色",
            "sampleValue": "#FFE84026"
          },
          "windLevel": {
            "type": "integer",
            "description": "当前风力等级",
            "sampleValue": 2
          }
        }
      },
      "run": {
        "morningSteps": {
          "type": "number",
          "description": "今天晨跑已完成步数",
          "sampleValue": 5680
        },
        "morningStepsText": {
          "type": "string",
          "description": "今天晨跑步数展示文本",
          "sampleValue": "5680"
        },
        "stepGoal": {
          "type": "number",
          "description": "今天晨跑目标步数",
          "sampleValue": 8000
        },
        "progressColor": {
          "type": "string",
          "description": "晨跑进度环颜色",
          "sampleValue": "#FFED6F21"
        }
      }
    },
    "state": {
      "loading": {
        "type": "boolean",
        "description": "天气和步数数据是否正在加载",
        "sampleValue": false
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_run.png",
      "description": "彩色运动跑步图标，适合用于跑步天气关怀卡片的运动识别视觉锚点。"
    }
  ]
}
