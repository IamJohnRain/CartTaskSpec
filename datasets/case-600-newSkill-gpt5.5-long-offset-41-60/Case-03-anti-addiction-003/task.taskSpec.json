{
  "userQuery": "做个晚上防熬夜的锁屏管控卡片，背景全用深紫色的夜间主题色。因为要管三个孩子，所以需要纵向重复排列多项日程安排，每项前面加个系统自带的闹钟小图标，把今天系统读取到的日历日程和设置的可用电量比例（比如剩余20%）展示出来。中间嵌一块独立的面板，如果到了晚上11点还没睡，就显示红色的“已超时”告警状态。加上从黑到深蓝的时间倒计时渐变效果，底部加个开关能直接一键开启系统的勿扰模式。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "今天系统日历读取到的三个孩子晚间日程摘要。",
          "sampleValue": [
            {
              "entityId": "child-a-night-001",
