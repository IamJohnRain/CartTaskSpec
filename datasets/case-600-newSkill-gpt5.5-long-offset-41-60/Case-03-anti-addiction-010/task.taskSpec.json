{
  "userQuery": "做个学习模式管控卡片，上面区域用醒目颜色放大号字体显示主视觉，中间放几个可勾选的固定任务选项比如完成作业和阅读，整体加个从橙色到红色的倒计时渐变效果，勾选完以后旁边出现绿色的打勾图标表示任务已达成，卡片下半部分换个底色，底部的按钮要能直接跳进系统设置里的应用限额去解锁娱乐APP，顺便联动一下日历日程看今天有没有课外班。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
