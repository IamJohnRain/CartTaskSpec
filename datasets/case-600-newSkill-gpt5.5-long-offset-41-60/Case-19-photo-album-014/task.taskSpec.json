{
  "userQuery": "之前那个相册日程卡太花哨了,重做。主题橙底里嵌一块白面板,顶部一个'今日拍摄'大按钮,下面横向排三个可勾选任务,旁边'省电拍摄模式'开关。任务从日历读,过期或快到期的标红告警。图标用字符,不渐变。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/0/entityId} }}"
        }
      }
    },
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
