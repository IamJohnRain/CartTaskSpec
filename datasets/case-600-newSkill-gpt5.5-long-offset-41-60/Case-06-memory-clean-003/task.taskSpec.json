          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比。",
            "sampleValue": 68
          }
        }
      }
    },
    "memory": {
      "statusText": {
        "type": "string",
        "description": "手机存储清理状态文案，清理后可更新为已优化。",
        "sampleValue": "存储空间已满"
      },
      "statusColor": {
        "type": "string",
        "description": "手机存储清理状态对应的前景色，已优化状态可使用绿色确认色。",
        "sampleValue": "#ffed6f21"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
