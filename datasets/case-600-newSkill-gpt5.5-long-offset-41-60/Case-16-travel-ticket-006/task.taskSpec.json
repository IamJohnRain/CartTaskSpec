{
  "userQuery": "做一张登机牌卡片，上一版做的实在太乱了。信息用分隔线分成三块：航班、行李、值机状态。中间嵌一个小面板显示预计登机时间，每分钟实时跳一下。整张卡浅米色底，背景带点午夜机场的氛围渐变。上一班飞机延误了2个半小时，气死了，所以这次状态色一定要标\"已取消\"或者\"严重延误\"那种红色告警。点航班号能进日历事件查看。图标用✈、⌖、◐这种纯文字符号。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/0/entityId} }}"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "日历事件列表，用于承载登机牌相关日程。",
