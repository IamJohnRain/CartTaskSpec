            {
              "entityId": "calendar-flight-ca1238",
              "title": "CA1238",
              "dtStart": "21:45",
              "dtEnd": "22:25",
              "eventLocation": "C12",
              "description": "行李 20kg 已托运"
            }
          ],
          "items": {
            "type": "object",
            "description": "单条航班日历事件。",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程索引项唯一标识符，用于查看日历事件详情。",
                "sampleValue": "calendar-flight-ca1238"
              },
              "title": {
                "type": "string",
                "description": "日程标题，此处作为航班号展示。",
                "sampleValue": "CA1238"
              },
              "dtStart": {
                "type": "string",
