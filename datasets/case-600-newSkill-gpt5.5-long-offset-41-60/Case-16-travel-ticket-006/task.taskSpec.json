              },
              "dtEnd": {
                "type": "string",
                "description": "日程结束时间，此处作为预计起飞或结束时间参考。",
                "sampleValue": "22:25"
              },
              "eventLocation": {
                "type": "string",
                "description": "日程发生位置，此处作为航站楼和登机口展示。",
                "sampleValue": "C12"
              },
              "description": {
                "type": "string",
                "description": "日程描述，此处作为行李摘要展示。",
                "sampleValue": "行李 20kg 已托运"
              }
            }
          }
        }
      }
    },
    "ui": {
