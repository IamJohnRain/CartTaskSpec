{
  "userQuery": "今天我有几个快递在不同时间段到，先按时间分组用分割线隔开，比如早上到的、中午到的、下午到的，每组显示具体动态值。中间放一个面板让我点进去看今天日历里那个取件事件，卡片表面磨砂质感的，读取天气数据，下雨的时候提醒我带伞，状态颜色别太多太花，不用渐变，图标用文字符号就行，下面还能滚动看更多。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${/data/calendar/items/0/entityId} }}"
        }
      }
    }
  ],
  "dataModelSchema": {
