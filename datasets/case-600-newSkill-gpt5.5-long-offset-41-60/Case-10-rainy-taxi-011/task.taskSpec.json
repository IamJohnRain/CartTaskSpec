{
  "userQuery": "做个雨天打车卡片，简洁风，左边放圆形进度图配雨伞图标当主视觉，旁边写\"距离高峰结束还剩X分钟\"这种固定文字加动态时间，再横向排三个小方块儿分别显示天气、等待人数、电量。右上角一个勿扰模式开关，天黑自动加夜晚渐变底色，人多了橙色提醒。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询所在区县名称",
            "sampleValue": "雨花台"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询所在城市名称",
            "sampleValue": "南京"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "24°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "小雨"
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "端侧完成天气查询和归一化的时间",
          "sampleValue": "2026-07-14 18:20"
        }
      }
    },
    "taxi": {
      "peakRemainMinutes": {
        "type": "integer",
        "description": "距离打车高峰结束的剩余分钟数",
        "sampleValue": 18
      },
      "peakProgress": {
        "type": "integer",
        "description": "当前高峰进度百分比，0 到 100",
        "sampleValue": 72
      },
      "waitingPeopleText": {
        "type": "string",
        "description": "当前附近等待打车人数展示文本",
        "sampleValue": "28人"
      },
      "batteryText": {
        "type": "string",
        "description": "手机当前电量展示文本",
        "sampleValue": "43%"
      },
      "isNight": {
        "type": "boolean",
        "description": "当前是否进入夜晚显示状态",
        "sampleValue": true
      },
      "crowdWarning": {
        "type": "boolean",
        "description": "等待人数是否达到拥挤提醒阈值",
        "sampleValue": true
      }
    },
    "settings": {
      "doNotDisturb": {
        "type": "boolean",
        "description": "勿扰模式当前是否开启",
        "sampleValue": true
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_weather1.png",
