{
  "userQuery": "想要个磨砂质感的拼单卡。左边大图标(奶茶杯字符)显示状态,右边勾选(少冰/多糖/换大杯),标\"已成团/已送达\"正向状态。跳到天气应用看配送那天下雨不,读下日历朋友生日。不用图。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "group": {
      "title": {
        "type": "string",
        "description": "拼单商品或团购对象名称。",
        "sampleValue": "奶茶拼单"
      },
      "glyph": {
        "type": "string",
        "description": "用于替代图片的奶茶杯字符视觉标识。",
        "sampleValue": "奶茶"
      },
      "formationStatus": {
        "type": "string",
        "description": "拼单成团状态，正向状态显示。",
        "sampleValue": "已成团"
      },
      "deliveryStatus": {
        "type": "string",
        "description": "配送状态，正向状态显示。",
        "sampleValue": "已送达"
      },
      "options": {
        "lessIce": {
          "label": {
            "type": "string",
            "description": "少冰选项标签。",
            "sampleValue": "少冰"
          },
          "selected": {
            "type": "boolean",
            "description": "少冰选项是否已勾选。",
            "sampleValue": true
          }
        },
        "extraSugar": {
          "label": {
            "type": "string",
            "description": "多糖选项标签。",
            "sampleValue": "多糖"
          },
          "selected": {
            "type": "boolean",
            "description": "多糖选项是否已勾选。",
            "sampleValue": true
          }
        },
        "largeCup": {
          "label": {
            "type": "string",
            "description": "换大杯选项标签。",
            "sampleValue": "换大杯"
          },
          "selected": {
            "type": "boolean",
            "description": "换大杯选项是否已勾选。",
            "sampleValue": true
          }
        }
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "配送地的区县名称。",
            "sampleValue": "青浦区"
          },
          "cityCode": {
            "type": "string",
            "description": "天气应用城市代码。",
            "sampleValue": "60814"
          }
        },
        "daily": {
          "type": "array",
          "description": "配送日天气预报列表。",
          "items": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "description": "配送日星期文本。",
                "sampleValue": "配送日"
              },
              "condition": {
                "type": "string",
                "description": "配送日天气现象。",
                "sampleValue": "小雨"
              },
              "rainProbabilityPercent": {
                "type": "string",
                "description": "配送日降雨概率百分比。",
                "sampleValue": "70%"
              }
            }
          }
        }
      },
      "calendar": {
        "items": {
          "type": "array",
          "description": "日历中匹配朋友生日的日程列表。",
          "items": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "生日日程唯一标识符。",
                "sampleValue": "calendar-birthday-001"
              },
              "title": {
                "type": "string",
                "description": "朋友生日日程标题。",
                "sampleValue": "朋友生日"
              },
              "dtStart": {
                "type": "string",
                "description": "生日日程开始时间。",
                "sampleValue": "今天"
              },
              "dtEnd": {
                "type": "string",
                "description": "生日日程结束时间。",
                "sampleValue": "23:59"
              }
            }
          }
        }
      }
    }
  },
  "assetCandidates": []
}
