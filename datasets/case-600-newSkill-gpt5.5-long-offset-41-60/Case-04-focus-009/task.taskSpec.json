{
  "userQuery": "晚上经常失眠想听白噪音助眠，帮我做个竖着排版的卡片，用不同底色分上下两块。顶上是个环形图显示当前室外的天气和气温，底下连着显示一排能上下滚动的白噪音列表（像下雨、海浪）。中间放个文字写的\"开始\"按钮，点一下就能打开睡眠模式，显示\"已连接音频\"的状态。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前室外天气所在区县名称",
            "sampleValue": "当前室外"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前室外温度展示文本",
            "sampleValue": "18°C"
          },
          "condition": {
            "type": "string",
            "description": "当前室外天气现象",
            "sampleValue": "小雨"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比，用于环形天气视觉",
            "sampleValue": 72
          }
        }
      }
    },
    "sleep": {
      "statusText": {
        "type": "string",
        "description": "睡眠模式音频连接状态",
        "sampleValue": "已连接音频"
      },
      "actionLabel": {
        "type": "string",
        "description": "进入睡眠模式的动作短文案",
        "sampleValue": "开始"
      }
    },
    "noise": {
      "items": {
        "0": {
          "type": "string",
          "description": "第一项白噪音名称",
          "sampleValue": "下雨"
        },
        "1": {
          "type": "string",
          "description": "第二项白噪音名称",
          "sampleValue": "海浪"
        },
        "2": {
          "type": "string",
          "description": "第三项白噪音名称",
          "sampleValue": "森林"
        }
      }
    },
    "asset": {
      "weatherIcon": {
        "type": "string",
        "description": "天气图标素材路径",
        "sampleValue": "resources/base/media/rain.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合的彩色天气图标，适合表达雨天室外环境和助眠白噪音的雨声锚点。",
      "bindTo": "/asset/weatherIcon"
    },
    {
      "src": "resources/base/media/moon_z_fill_1.svg",
      "description": "月亮加 Z 的睡眠图标，适合表达睡眠模式入口或夜间休息状态。"
    },
    {
      "src": "resources/base/media/play_fill.svg",
      "description": "播放实心图标，适合表达开始播放音频或媒体控制动作。"
    }
  ]
}
