{
  "userQuery": "婚礼倒计时卡片。主题色背景,中间一个圆环里面叠个数字写\"还剩48天\",底下固定显示婚礼日期、酒店名字和\"距离我们的大日子还有__天\",点卡片能跳到天气APP看那天预报,不用列表。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "title": {
              "type": "string",
              "description": "婚礼日程标题",
              "sampleValue": "婚礼"
            },
            "dtStart": {
              "type": "string",
              "description": "婚礼日期展示文本",
              "sampleValue": "2026年8月30日"
            },
            "eventLocation": {
              "type": "string",
              "description": "婚礼酒店名称",
              "sampleValue": "星河湾酒店"
            }
          }
        ]
      }
    },
    "view": {
      "remainingDays": {
        "type": "number",
        "description": "距离婚礼剩余天数",
        "sampleValue": 48
      },
      "remainingText": {
        "type": "string",
        "description": "主倒计时展示文案",
        "sampleValue": "还剩48天"
      },
      "detailText": {
        "type": "string",
        "description": "底部倒计时说明文案",
        "sampleValue": "距离我们的大日子还有48天"
      },
      "progressValue": {
        "type": "number",
        "description": "倒计时环形进度样例值",
        "sampleValue": 52
      },
      "progressTotal": {
        "type": "number",
        "description": "倒计时环形进度总量",
        "sampleValue": 100
      }
    }
  },
  "assetCandidates": []
}
