{
  "userQuery": "帮我做一个监测天气的主题色卡片，读取老家天气情况，用天气和健康的语义图标当视觉主体，中心做个环形仪表盘数据焦点，比如显示当前舒适度100%表示状态可用（绿色正向状态），弄个勾选交互项记录我“今天已确认父母添衣”，整个卡片用柔和的天气氛围渐变，点进去能看详细的天气APP内容。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "老家所在区县名称",
            "sampleValue": "青浦区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "24°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          },
          "coldLevel": {
            "type": "string",
            "description": "感冒指数或添衣健康提示",
            "sampleValue": "舒适"
          }
        }
      }
    },
    "care": {
      "comfortPercent": {
        "type": "number",
        "description": "天气关怀舒适度百分比，100表示状态可用",
        "sampleValue": 100
      },
      "comfortText": {
        "type": "string",
        "description": "天气关怀舒适度展示文本",
        "sampleValue": "100%"
      },
      "statusText": {
        "type": "string",
        "description": "天气健康状态文本",
        "sampleValue": "状态可用"
      },
      "confirmedClothing": {
        "type": "boolean",
        "description": "今天是否已确认父母添衣",
        "sampleValue": true
      },
      "confirmLabel": {
        "type": "string",
        "description": "父母添衣确认项展示文案",
        "sampleValue": "已确认添衣"
      }
    },
    "asset": {
      "weatherIcon": {
        "type": "string",
        "description": "天气语义图标素材路径",
        "sampleValue": "resources/base/media/icon_weather1.png"
      },
      "healthIcon": {
        "type": "string",
        "description": "健康关怀语义图标素材路径",
        "sampleValue": "resources/base/media/heart_fill.svg"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_weather1.png",
      "description": "天气/雨伞图标，适合亲人关怀场景中表达老家天气监测。",
      "bindTo": "/asset/weatherIcon"
    },
    {
      "src": "resources/base/media/heart_fill.svg",
      "description": "心形实心图标，适合表达健康关怀与父母照护确认状态。",
      "bindTo": "/asset/healthIcon"
    }
  ]
}
