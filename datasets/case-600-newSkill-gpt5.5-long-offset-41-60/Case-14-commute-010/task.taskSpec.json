{
  "userQuery": "通勤卡想带点运动元素,左右分区用细线分开。左边浅蓝块写'今日步数8420步',右边浅绿块显示'下一会议还有23分钟',要读日历日程。底部横向重复两三个小方块显示最近三天步数,点步数跳到运动健康App。整体淡粉到淡紫环境氛围渐变。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/home/sport?sportType=2"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "fitness": {
        "today": {
          "stepsText": {
            "type": "string",
