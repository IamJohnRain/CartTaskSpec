              "dayText": "前天",
              "stepsText": "7600"
            },
            {
              "dayText": "昨天",
              "stepsText": "8230"
            },
            {
              "dayText": "今天",
              "stepsText": "8420"
            }
          ],
          "items": {
            "type": "object",
            "description": "单日步数摘要",
            "properties": {
              "dayText": {
                "type": "string",
                "description": "日期短标签",
                "sampleValue": "今天"
              },
              "stepsText": {
                "type": "string",
                "description": "单日步数数值文本",
                "sampleValue": "8420"
              }
            }
          }
        }
      },
      "calendar": {
        "items": {
