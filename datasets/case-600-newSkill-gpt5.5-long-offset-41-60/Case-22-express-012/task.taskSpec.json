{
  "userQuery": "做个快递清单卡,每个件前面能勾选已签收,顶上显示\"今日已签收 X 单\"这种动态数字,点时间能跳到闹钟,不同区域底色分开,中间加个环形图展示签收率,物流场景里的图标就够用,列表能滚",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.clock",
        "abilityName": "com.huawei.hmos.clock.phone",
        "uri": ""
      }
    }
  ],
  "dataModelSchema": {
    "summary": {
      "signedText": {
        "type": "string",
        "description": "今日已签收数量的完整展示文案。",
        "sampleValue": "今日已签收 8 单"
      },
      "totalText": {
        "type": "string",
        "description": "今日快递总单量的短文案。",
        "sampleValue": "共 12 单"
      },
      "rate": {
        "type": "number",
        "description": "今日签收率百分比数值，用于环形进度。",
        "sampleValue": 67
      },
      "rateText": {
        "type": "string",
        "description": "今日签收率展示文本。",
        "sampleValue": "67%"
      },
      "timeText": {
        "type": "string",
        "description": "下一次提醒或查看时间。",
        "sampleValue": "18:30"
      },
      "statusText": {
        "type": "string",
        "description": "清单当前处理状态。",
        "sampleValue": "待签收 4 单"
      }
    },
    "shipments": [
      {
        "title": {
          "type": "string",
          "description": "第一件快递的简短名称或来源。",
          "sampleValue": "京东小件"
        },
        "time": {
          "type": "string",
          "description": "第一件快递的时间信息。",
          "sampleValue": "16:20"
        },
        "signed": {
          "type": "boolean",
          "description": "第一件快递是否已签收。",
          "sampleValue": true
        }
      },
      {
        "title": {
          "type": "string",
          "description": "第二件快递的简短名称或来源。",
          "sampleValue": "顺丰文件"
        },
        "time": {
          "type": "string",
          "description": "第二件快递的时间信息。",
          "sampleValue": "17:10"
        },
        "signed": {
          "type": "boolean",
          "description": "第二件快递是否已签收。",
          "sampleValue": true
        }
      },
      {
        "title": {
          "type": "string",
          "description": "第三件快递的简短名称或来源。",
          "sampleValue": "菜鸟驿站"
        },
        "time": {
          "type": "string",
          "description": "第三件快递的时间信息。",
          "sampleValue": "19:00"
        },
        "signed": {
          "type": "boolean",
          "description": "第三件快递是否已签收。",
          "sampleValue": false
        }
      }
    ],
    "assets": {
      "boxIcon": {
        "type": "string",
        "description": "快递箱图标素材路径。",
        "sampleValue": "resources/base/media/courier_box.png"
      },
      "alarmIcon": {
        "type": "string",
        "description": "闹钟图标素材路径。",
        "sampleValue": "resources/base/media/alarm_fill_1.svg"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/courier_box.png",
      "description": "快递箱子彩色图标，适合用于物流清单和包裹状态识别。",
      "bindTo": "/assets/boxIcon"
    },
    {
      "src": "resources/base/media/alarm_fill_1.svg",
      "description": "闹钟实心图标，适合用于时间提醒和跳转闹钟入口。",
      "bindTo": "/assets/alarmIcon"
    }
  ]
}
