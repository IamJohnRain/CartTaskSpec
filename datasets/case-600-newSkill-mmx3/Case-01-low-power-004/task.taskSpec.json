  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "use": "battery-icon",
      "description": "电池图标，适用场景：低电模式，作为卡片头部主视觉图标，提示当前电量状态。"
    },
    {
      "src": "resources/base/media/calendar_fill.svg",
      "use": "calendar-icon",
      "description": "日历实心图标，黑色，图形为带格线的日历本造型，适用场景：日程管理、下一日程标识。"
    }
  ]
