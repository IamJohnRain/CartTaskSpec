        "calendar": {
          "items": [
            {
              "entityId": "evt-001",
              "title": "团队周会",
              "dtStart": "14:00",
              "dtEnd": "14:30"
            }
          ]
        }
      },
      "state": {
        "loading": false
      }
    }
