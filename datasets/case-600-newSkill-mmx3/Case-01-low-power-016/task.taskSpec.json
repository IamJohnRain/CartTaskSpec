{
  "userQuery": "我每天出门前都要检查手机还有多少电和今天要办的事,老是忘。做个卡片,上面放电池图标做主视觉,下面纵向排列几个待办日程项,每项能勾选绑定。卡片读取天气预报显示今天天气,也要能点击进入具体的日程事件详情。简洁素净的卡片表面,整体氛围背景,不要渐变。电量低于20%时待办项显示橙色注意状态。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "{{ ${entityId} }}"
        }
      }
    }
  ],
  "dataModel": {
    "value": {
      "data": {
        "weather": {
          "location": {},
          "current": {},
          "daily": [],
          "updatedAt": ""
        },
        "calendar": {
          "items": [
            {
              "title": "产品评审",
              "dtStart": "14:00",
              "entityId": "placeholder_001"
            },
            {
              "title": "客户回访",
              "dtStart": "16:30",
              "entityId": "placeholder_002"
            }
          ]
        }
      },
      "state": {
        "loading": true
      },
      "card": {
        "batteryPercent": 18,
        "batteryWarning": true,
        "batteryColor": "#ffed6f21",
        "titleColor": "#ffed6f21"
      },
      "asset": {
        "batteryIcon": "resources/base/media/icon_electricity.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "use": "batteryIcon",
      "description": "电池图标，适用场景：低电模式。作为卡片顶部主视觉图标，提示当前电量状态；浅色平铺背景下识别度高，可直接用于2x2卡片主视觉。",
      "bindTo": "/asset/batteryIcon"
    }
  ]
}
