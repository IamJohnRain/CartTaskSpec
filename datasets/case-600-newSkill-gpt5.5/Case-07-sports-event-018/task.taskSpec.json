{
  "userQuery": "下个月5号有场社区5公里跑，做个赛事提醒卡片。整体浅米色底，左边信息区显示赛事名\"秋日社区跑\"和倒计时12天（动态数字），右边动作区放一个\"查看日程\"按钮，并标个\"注意：赛事临近\"。底部横向排三个小模块：天气、配速建议、装备清单，用\"☀\"\"⚡\"\"✓\"这种文字字符当图标，整体带点夜晚渐变蓝紫调。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "autumn-community-run"
        }
      }
    }
  ],
  "dataModelSchema": {
    "event": {
      "name": {
        "type": "string",
        "description": "赛事名称",
        "sampleValue": "秋日社区跑"
      },
      "dateLabel": {
        "type": "string",
        "description": "赛事日期展示文本",
        "sampleValue": "8月5日"
      },
      "distanceLabel": {
        "type": "string",
        "description": "赛事距离展示文本",
        "sampleValue": "5公里"
      },
      "countdownDays": {
        "type": "number",
        "description": "距离赛事开始的倒计时天数",
        "sampleValue": 12
      },
      "warningText": {
        "type": "string",
        "description": "赛事临近提醒文本",
        "sampleValue": "注意：赛事临近"
      }
    },
    "modules": {
      "weather": {
        "icon": {
          "type": "string",
          "description": "天气模块文字图标",
          "sampleValue": "☀"
        },
        "summary": {
          "type": "string",
          "description": "天气摘要",
          "sampleValue": "晴22℃"
        }
      },
      "pace": {
        "icon": {
          "type": "string",
          "description": "配速建议模块文字图标",
          "sampleValue": "⚡"
        },
        "summary": {
          "type": "string",
          "description": "配速建议摘要",
          "sampleValue": "6:20配速"
        }
      },
      "gear": {
        "icon": {
          "type": "string",
          "description": "装备清单模块文字图标",
          "sampleValue": "✓"
        },
        "summary": {
          "type": "string",
          "description": "装备清单摘要",
          "sampleValue": "带水鞋"
        }
      }
    }
  },
  "assetCandidates": []
}
