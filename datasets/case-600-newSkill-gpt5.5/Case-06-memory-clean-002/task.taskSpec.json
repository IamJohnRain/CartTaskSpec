{
  "userQuery": "帮我整个内存清理卡片吧，上面写个数字比如32天没清理，点一下跳到清理app",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "storage_settings"
      }
    }
  ],
  "dataModelSchema": {
    "memoryClean": {
      "title": {
        "type": "string",
        "description": "内存清理卡片标题",
        "sampleValue": "内存清理"
      },
      "daysText": {
        "type": "string",
        "description": "距离上次清理的天数数字文本",
        "sampleValue": "32"
      },
      "unitText": {
        "type": "string",
        "description": "主数字单位",
        "sampleValue": "天"
      },
      "caption": {
        "type": "string",
        "description": "主数字说明文本",
        "sampleValue": "没清理"
      },
      "statusText": {
        "type": "string",
        "description": "内存清理状态提示",
        "sampleValue": "建议释放缓存"
      },
      "detailText": {
        "type": "string",
        "description": "清理入口辅助说明",
        "sampleValue": "临时文件"
      },
      "actionLabel": {
        "type": "string",
        "description": "打开清理入口的动作文案",
        "sampleValue": "去清理"
      },
      "progressValue": {
        "type": "number",
        "description": "清理提醒仪表当前值",
        "sampleValue": 32
      },
      "progressTotal": {
        "type": "number",
        "description": "清理提醒仪表最大参考值",
        "sampleValue": 40
      },
      "iconSrc": {
        "type": "string",
        "description": "内存清理语义图标素材路径",
        "sampleValue": "resources/base/media/icon_clear.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_clear.png",
      "description": "清除图标，适合用于内存清理、缓存释放和清理入口识别。",
      "bindTo": "/memoryClean/iconSrc"
    }
  ]
}
