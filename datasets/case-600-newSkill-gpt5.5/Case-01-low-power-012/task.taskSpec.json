{
  "userQuery": "我经常在外面手机突然没电导航都断了。横向排三个环形数据，中间大环显示当前电量，旁边两小环一个显示今日总用电一个显示预估剩余时长。点击天气图标能跳到天气app看是否要下雨。浅色底清爽一点，电量低于15%时大环变红色告警。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "power": {
      "title": {
        "type": "string",
        "description": "低电模式卡片标题",
        "sampleValue": "低电模式"
      },
      "batteryPercent": {
        "type": "number",
        "description": "当前手机电量百分比",
        "sampleValue": 12
      },
      "batteryText": {
        "type": "string",
        "description": "当前手机电量展示文本",
        "sampleValue": "12%"
      },
      "todayUsagePercent": {
        "type": "number",
        "description": "今日总用电占满电容量的百分比",
        "sampleValue": 68
      },
      "todayUsageText": {
        "type": "string",
        "description": "今日总用电展示文本",
        "sampleValue": "68%"
      },
      "remainingPercent": {
        "type": "number",
        "description": "预估剩余可用时长折算进度百分比",
        "sampleValue": 30
      },
      "remainingText": {
        "type": "string",
        "description": "预估剩余时长展示文本",
        "sampleValue": "1.5h"
      },
      "ringColor": {
        "type": "string",
        "description": "当前电量环颜色，低于15%时为告警色，否则为电池场景强调色",
        "sampleValue": "#ffed6f21"
      },
      "supportColor": {
        "type": "string",
        "description": "两侧辅助数据环颜色",
        "sampleValue": "#61cfbe"
      }
    },
    "data": {
      "weather": {
        "location": {
          "cityCode": {
            "type": "string",
            "description": "天气应用城市代码，可用于天气页定位",
            "sampleValue": ""
          },
          "districtName": {
            "type": "string",
            "description": "天气查询区县名",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          }
        },
        "daily": [
          {
            "rainProbabilityPercent": {
              "type": "string",
              "description": "今日降雨概率百分比",
              "sampleValue": "30%"
            },
            "condition": {
              "type": "string",
              "description": "今日白天天气现象",
              "sampleValue": "多云"
            }
          }
        ]
      }
    },
    "asset": {
      "weatherIcon": {
        "type": "string",
        "description": "天气入口图标资源路径",
        "sampleValue": "resources/base/media/partly_cloudy.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "云朵在前、太阳在后的彩色天气图标，适合表达天气入口和出行前查看是否下雨。",
      "bindTo": "/asset/weatherIcon"
    }
  ]
}
