{
  "userQuery": "帮我弄个 几个能打勾的选项 一行字显示今天已用200分钟 点一下进设置 看下天气 快到了提醒下",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "appUsage": {
      "todayText": {
        "type": "string",
        "description": "今日已使用时长的展示文本",
        "sampleValue": "今日已用200分钟"
      },
      "usedMinutes": {
        "type": "number",
        "description": "今日已使用分钟数",
        "sampleValue": 200
      },
      "limitMinutes": {
        "type": "number",
        "description": "今日使用时长限制分钟数",
        "sampleValue": 240
      },
      "warningText": {
        "type": "string",
        "description": "接近使用时长限制时的提醒文本",
        "sampleValue": "还剩40分钟"
      }
    },
    "checklist": {
      "focusDone": {
        "type": "boolean",
        "description": "是否已开启专注提醒选项",
        "sampleValue": true
      },
      "sleepDone": {
        "type": "boolean",
        "description": "是否已勾选睡前停用选项",
        "sampleValue": false
      },
      "focusLabel": {
        "type": "string",
        "description": "专注提醒勾选项标签",
        "sampleValue": "专注提醒"
      },
      "sleepLabel": {
        "type": "string",
        "description": "睡前停用勾选项标签",
        "sampleValue": "睡前停用"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名称",
            "sampleValue": "当前位置"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "26°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "多云"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_timing.png",
      "description": "防沉迷计时图标，适合用于应用时长和健康使用提醒卡片的识别。"
    }
  ]
}
