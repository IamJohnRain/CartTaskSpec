{
  "userQuery": "晚上手机经常掉到30%以下,想要一张暗色低电卡片,几个小面板横向排开:环形电池图标叠百分比数字、省电模式开关、勿扰开关,都能勾选一键切换,用夜晚深色渐变,提醒我该开启省电了。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    },
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    },
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "battery": {
      "percent": {
        "type": "number",
        "description": "当前手机电量百分比数值",
        "sampleValue": 28
      },
      "percentText": {
        "type": "string",
        "description": "当前手机电量百分比展示文本",
        "sampleValue": "28%"
      },
      "statusText": {
        "type": "string",
        "description": "低电状态提醒文本",
        "sampleValue": "该开启省电了"
      },
      "lowPowerOn": {
        "type": "boolean",
        "description": "省电模式是否已开启",
        "sampleValue": false
      },
      "doNotDisturbOn": {
        "type": "boolean",
        "description": "勿扰模式是否已开启",
        "sampleValue": false
      }
    },
    "assets": {
      "batteryIcon": {
        "type": "string",
        "description": "低电模式电池图标路径",
        "sampleValue": "resources/base/media/icon_electricity.png"
      },
      "powerSaveIcon": {
        "type": "string",
        "description": "省电模式图标路径",
        "sampleValue": "resources/base/media/icon_save_power.png"
      },
      "dndIcon": {
        "type": "string",
        "description": "勿扰或夜间模式图标路径",
        "sampleValue": "resources/base/media/icon_focus.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "低电模式电池图标，适合作为当前电量状态小面板的识别素材。",
      "bindTo": "/assets/batteryIcon"
    },
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，适合作为省电模式切换面板的状态素材。",
      "bindTo": "/assets/powerSaveIcon"
    },
    {
      "src": "resources/base/media/icon_focus.png",
      "description": "专注图标，适合作为夜间勿扰或专注模式切换面板的识别素材。",
      "bindTo": "/assets/dndIcon"
    }
  ]
}
