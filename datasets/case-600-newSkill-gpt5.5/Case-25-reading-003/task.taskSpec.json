{
  "userQuery": "弄个书架卡片,列一排我的书,点一下跳进去,显示已读完",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "intelligent_scene_entry"
      }
    }
  ],
  "dataModelSchema": {
    "shelf": {
      "title": {
        "type": "string",
        "description": "书架卡片标题",
        "sampleValue": "我的书架"
      },
      "finishedText": {
        "type": "string",
        "description": "书籍完成状态短文本",
        "sampleValue": "已读完"
      },
      "finishSummary": {
        "type": "string",
        "description": "书架已读完成汇总",
        "sampleValue": "已读完 3 本"
      },
      "hint": {
        "type": "string",
        "description": "进入书架前的短提示",
        "sampleValue": "继续阅读"
      },
      "actionLabel": {
        "type": "string",
        "description": "进入书架动作短文案",
        "sampleValue": "进入"
      },
      "asset": {
        "audioGlyph": {
          "type": "string",
          "description": "阅读听书场景的音频识别图标路径",
          "sampleValue": "resources/base/media/music_fill.svg"
        }
      },
      "books": [
        {
          "title": {
            "type": "string",
            "description": "第一本书的标题",
            "sampleValue": "三体全集"
          },
          "status": {
            "type": "string",
            "description": "第一本书的阅读状态",
            "sampleValue": "已读完"
          }
        },
        {
          "title": {
            "type": "string",
            "description": "第二本书的标题",
            "sampleValue": "深夜书店"
          },
          "status": {
            "type": "string",
            "description": "第二本书的阅读状态",
            "sampleValue": "已读完"
          }
        },
        {
          "title": {
            "type": "string",
            "description": "第三本书的标题",
            "sampleValue": "时间简史"
          },
          "status": {
            "type": "string",
            "description": "第三本书的阅读状态",
            "sampleValue": "已读完"
          }
        }
      ]
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/music_fill.svg",
      "description": "音乐音符实心图标，可作为阅读听书卡片的音频识别 glyph，适合放在浅色书架标题区域。",
      "bindTo": "/shelf/asset/audioGlyph"
    }
  ]
}
