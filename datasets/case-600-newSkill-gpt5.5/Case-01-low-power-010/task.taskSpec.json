{
  "userQuery": "搞个省电模式卡片 文字叠在图上 显示剩多少电 点了能跳应用",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "power": {
      "modeTitle": {
        "type": "string",
        "description": "省电模式卡片标题",
        "sampleValue": "省电模式"
      },
      "batteryText": {
        "type": "string",
        "description": "当前剩余电量显示文本",
        "sampleValue": "剩余 24%"
      },
      "batteryValue": {
        "type": "number",
        "description": "当前剩余电量数值，用于进度条",
        "sampleValue": 24
      },
      "batteryTotal": {
        "type": "number",
        "description": "电量总量基准值",
        "sampleValue": 100
      },
      "statusText": {
        "type": "string",
        "description": "省电模式当前状态说明",
        "sampleValue": "已为低电量优化"
      },
      "actionLabel": {
        "type": "string",
        "description": "打开应用的按钮文案",
        "sampleValue": "打开设置"
      },
      "heroImage": {
        "type": "string",
        "description": "低电或省电模式视觉锚点素材路径",
        "sampleValue": "resources/base/media/battery_leaf_fill.svg"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/battery_leaf_fill.svg",
      "description": "电池与绿叶组合图标，适合节能模式、绿色用电、省电状态识别，可作为图上叠字的主视觉锚点。",
      "bindTo": "/power/heroImage"
    }
  ]
}
