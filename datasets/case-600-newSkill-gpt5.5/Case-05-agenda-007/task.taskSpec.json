{
  "userQuery": "整个显示时间的卡片，点一下打开日历看看今天有啥会",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.calendar",
        "abilityName": "com.huawei.hmos.calendar.MainAbility",
        "uri": ""
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "time": {
        "displayTime": {
          "type": "string",
          "description": "当前时间的小时分钟展示文本",
          "sampleValue": "09:30"
        },
        "dateLabel": {
          "type": "string",
          "description": "今天日期与星期展示文本",
          "sampleValue": "7月9日 周四"
        }
      },
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符，用于打开对应日程",
              "sampleValue": "calendar-demo-001"
            },
            "title": {
              "type": "string",
              "description": "今天第一条日程标题",
              "sampleValue": "产品评审"
            },
            "dtStart": {
              "type": "string",
              "description": "今天第一条日程开始时间，格式为 HH:MM",
              "sampleValue": "14:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "今天第一条日程结束时间，格式为 HH:MM",
              "sampleValue": "15:00"
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_time.png",
      "description": "时间图标，适合用于当前时间显示和当日安排入口。"
    }
  ]
}
