{
  "userQuery": "整个电量数字会变的卡片 点一下能进省电模式 还要有红色危险提示",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "card": {
      "title": {
        "type": "string",
        "description": "卡片标题，说明当前展示的是低电模式状态。",
        "sampleValue": "低电模式"
      }
    },
    "asset": {
      "primaryIcon": {
        "type": "string",
        "description": "低电模式状态识别图标路径。",
        "sampleValue": "resources/base/media/icon_electricity.png"
      },
      "actionIcon": {
        "type": "string",
        "description": "省电模式动作图标路径。",
        "sampleValue": "resources/base/media/icon_save_power.png"
      }
    },
    "meter": {
      "progressValue": {
        "type": "number",
        "description": "当前电量进度数值，用于仪表环展示。",
        "sampleValue": 12
      },
      "progressTotal": {
        "type": "number",
        "description": "电量总量基准。",
        "sampleValue": 100
      },
      "centerLabel": {
        "type": "string",
        "description": "当前电量百分比主显示文本。",
        "sampleValue": "12%"
      },
      "caption": {
        "type": "string",
        "description": "电量状态短标签。",
        "sampleValue": "电量"
      }
    },
    "support": {
      "line1": {
        "type": "string",
        "description": "低电危险状态提示。",
        "sampleValue": "危险"
      },
      "line2": {
        "type": "string",
        "description": "建议用户立即开启省电的短提示。",
        "sampleValue": "立即省电"
      }
    },
    "action": {
      "label": {
        "type": "string",
        "description": "进入省电模式的动作文案。",
        "sampleValue": "开启省电"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "电池图标，适合低电模式卡片中表达当前电量状态。",
      "bindTo": "/asset/primaryIcon"
    },
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，适合省电模式入口或节能动作提示。",
      "bindTo": "/asset/actionIcon"
    }
  ]
}
