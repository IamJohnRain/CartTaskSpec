{
  "userQuery": "整个电量数字会变的卡片 点一下能进省电模式 还要有红色危险提示",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "card": {
      "title": {
        "type": "string",
        "description": "卡片标题，标识当前展示低电模式状态。",
        "sampleValue": "低电模式"
      }
    },
    "asset": {
      "primaryIcon": {
        "type": "string",
        "description": "主识别图标资源路径，用于表达电池与省电语义。",
        "sampleValue": "resources/base/media/battery_leaf_fill.svg"
      },
      "actionIcon": {
        "type": "string",
        "description": "动作区图标资源路径，用于表达电量或充电相关动作。",
        "sampleValue": "resources/base/media/bolt_fill.svg"
      }
    },
    "meter": {
      "progressValue": {
        "type": "number",
        "description": "当前电量进度数值，用于驱动电量环形进度。",
        "sampleValue": 12
      },
      "progressTotal": {
        "type": "number",
        "description": "电量进度总量，用于计算环形进度比例。",
        "sampleValue": 100
      },
      "centerLabel": {
        "type": "string",
        "description": "中心电量百分比文本，随电量变化展示。",
        "sampleValue": "12%"
      },
      "caption": {
        "type": "string",
        "description": "主数值短标签，说明中心数字代表电量。",
        "sampleValue": "电量"
      }
    },
    "support": {
      "line1": {
        "type": "string",
        "description": "红色危险状态提示文案。",
        "sampleValue": "危险"
      },
      "line2": {
        "type": "string",
        "description": "低电状态下的短辅助建议。",
        "sampleValue": "立即省电"
      }
    },
    "action": {
      "label": {
        "type": "string",
        "description": "省电模式入口的动作按钮文案。",
        "sampleValue": "开启省电"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/battery_leaf_fill.svg",
      "description": "电池与绿叶组合实心图标，适合低电与省电模式识别。",
      "bindTo": "/asset/primaryIcon"
    },
    {
      "src": "resources/base/media/bolt_fill.svg",
      "description": "闪电实心图标，适合电量、充电或省电动作入口。",
      "bindTo": "/asset/actionIcon"
    }
  ]
}
