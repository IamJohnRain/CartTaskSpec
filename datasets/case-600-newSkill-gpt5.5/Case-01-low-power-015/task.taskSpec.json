{
  "userQuery": "晚上睡前手机经常只剩30%多,第二天起床怕没电。做个卡片纵向堆叠显示当前电量、明早天气、闹钟时间几个信息。卡片内嵌小面板,点卡片能跳到闹钟应用。浅色调底色,用夜晚的深蓝紫色渐变。电量低于30%时显示橙色待处理。底部横向排几个常用图标。",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.clock",
        "abilityName": "com.huawei.hmos.clock.phone",
        "uri": ""
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "device": {
        "batteryPercentText": {
          "type": "string",
          "description": "当前手机电量百分比展示文本",
          "sampleValue": "32%"
        },
        "batteryPercent": {
          "type": "number",
          "description": "当前手机电量百分比数值，用于判断是否低于 30%",
          "sampleValue": 32
        },
        "batteryStatusText": {
          "type": "string",
          "description": "低电量状态提示，低于 30% 时显示待处理",
          "sampleValue": "电量尚可"
        }
      },
      "weather": {
        "daily": [
          {
            "weekday": {
              "type": "string",
              "description": "明早对应的星期文本",
              "sampleValue": "明早"
            },
            "condition": {
              "type": "string",
              "description": "明早天气现象",
              "sampleValue": "多云"
            },
            "temperatureRangeText": {
              "type": "string",
              "description": "明早温度范围展示文本",
              "sampleValue": "22-28°C"
            }
          }
        ]
      },
      "alarm": {
        "timeText": {
          "type": "string",
          "description": "明早闹钟时间展示文本",
          "sampleValue": "07:30"
        }
      },
      "assets": {
        "weatherIcon": {
          "type": "string",
          "description": "明早天气图标素材路径",
          "sampleValue": "resources/base/media/partly_cloudy.png"
        },
        "batteryIcon": {
          "type": "string",
          "description": "低电模式电池图标素材路径",
          "sampleValue": "resources/base/media/icon_electricity.png"
        },
        "chargeIcon": {
          "type": "string",
          "description": "充电快捷提示图标素材路径",
          "sampleValue": "resources/base/media/icon_charge.png"
        },
        "alarmIcon": {
          "type": "string",
          "description": "闹钟快捷入口图标素材路径",
          "sampleValue": "resources/base/media/icon_alarm_clock1.png"
        },
        "savePowerIcon": {
          "type": "string",
          "description": "省电模式快捷提示图标素材路径",
          "sampleValue": "resources/base/media/icon_save_power.png"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/partly_cloudy.png",
      "description": "云朵在前、太阳在后的彩色天气图标，适合表达明早多云或转晴天气状态。",
      "bindTo": "/data/assets/weatherIcon"
    },
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "低电模式电池图标，适合表达当前手机电量与低电状态。",
      "bindTo": "/data/assets/batteryIcon"
    },
    {
      "src": "resources/base/media/icon_charge.png",
      "description": "充电闪电图标，适合表达睡前充电或补电快捷提示。",
      "bindTo": "/data/assets/chargeIcon"
    },
    {
      "src": "resources/base/media/icon_alarm_clock1.png",
      "description": "睡眠监督场景的闹钟图标，适合表达明早闹钟入口。",
      "bindTo": "/data/assets/alarmIcon"
    },
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "低电模式省电图标，适合表达省电或节能快捷提示。",
      "bindTo": "/data/assets/savePowerIcon"
    }
  ]
}
