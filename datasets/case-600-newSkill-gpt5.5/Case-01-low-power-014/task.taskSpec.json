{
  "userQuery": "出差总忘记提前充电，上次飞机上手机没电差点误事。帮我做低电管理卡，上方大区域显示电量和\"距离下次会议还有3小时\"倒计时感信息，下面纵向排列今天日程每条前面勾选框双向绑定可勾选，底部按钮跳系统省电设置，深色舞台配夜晚渐变，5%以下红色超限告警纯文字色块。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
