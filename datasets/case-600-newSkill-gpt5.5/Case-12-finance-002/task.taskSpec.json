{
  "userQuery": "帮我弄个记账卡 余额数字会变 预算快花完提醒我 点进去能改",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "budget_edit_event"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "finance": {
        "accountName": {
          "type": "string",
          "description": "记账卡展示的账户或账本名称。",
          "sampleValue": "日常账户"
        },
        "balanceText": {
          "type": "string",
          "description": "当前账户余额展示文本，运行时可随记账数据变化。",
          "sampleValue": "¥2360"
        },
        "warningBadge": {
          "type": "string",
          "description": "预算状态短标签，用于提示预算接近用完。",
          "sampleValue": "预算预警"
        },
        "budgetUsedText": {
          "type": "string",
          "description": "本月预算使用比例展示文本。",
          "sampleValue": "本月已用 92%"
        },
        "budgetLeftText": {
          "type": "string",
          "description": "剩余预算展示文本。",
          "sampleValue": "剩余 ¥180"
        },
        "budgetProgressValue": {
          "type": "number",
          "description": "预算已使用进度值。",
          "sampleValue": 92
        },
        "budgetProgressTotal": {
          "type": "number",
          "description": "预算进度总值。",
          "sampleValue": 100
        },
        "warningText": {
          "type": "string",
          "description": "预算接近用完时的提醒文案。",
          "sampleValue": "预算快用完"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/bell_fill.svg",
      "description": "铃铛实心图标，适合用于预算临近耗尽时的提醒状态。"
    }
  ]
}
