{
  "userQuery": "弄个健康提醒的卡片，数字会变的，点一下能跳到应用，还能从日历读日程出来",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "huaweischeme://healthapp/router/sleepDetail"
      }
    }
  ],
  "dataModelSchema": {
    "card": {
      "title": {
        "type": "string",
        "description": "卡片对象短标题",
        "sampleValue": "健康提醒"
      }
    },
    "asset": {
      "primaryIcon": {
        "type": "string",
        "description": "健康提醒图标资源路径",
        "sampleValue": "resources/base/media/icon_remind.png"
      },
      "timeIcon": {
        "type": "string",
        "description": "时间图标资源路径",
        "sampleValue": "resources/base/media/clock.svg"
      },
      "scheduleIcon": {
        "type": "string",
        "description": "日程图标资源路径",
        "sampleValue": "resources/base/media/calendar_fill.svg"
      }
    },
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "今日从日历读取的健康提醒日程列表",
          "sampleValue": [
            {
              "entityName": "calendar",
              "entityId": "calendar-health-001",
              "title": "服药提醒",
              "dtStart": "09:30",
              "dtEnd": "09:40",
              "eventLocation": "家中",
              "description": "早餐后服药"
            },
            {
              "entityName": "calendar",
              "entityId": "calendar-health-002",
              "title": "血压记录",
              "dtStart": "15:30",
              "dtEnd": "15:40",
              "eventLocation": "客厅",
              "description": "记录血压"
            },
            {
              "entityName": "calendar",
              "entityId": "calendar-health-003",
              "title": "复查准备",
              "dtStart": "18:00",
              "dtEnd": "18:15",
              "eventLocation": "家中",
              "description": "整理病历"
            }
          ],
          "items": {
            "type": "object",
            "description": "健康提醒日程项",
            "properties": {
              "entityName": {
                "type": "string",
                "description": "日程实体类别",
                "sampleValue": "calendar"
              },
              "entityId": {
                "type": "string",
                "description": "日程唯一标识符",
                "sampleValue": "calendar-health-001"
              },
              "title": {
                "type": "string",
                "description": "日程标题",
                "sampleValue": "服药提醒"
              },
              "dtStart": {
                "type": "string",
                "description": "日程开始时间展示文本",
                "sampleValue": "09:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "日程结束时间展示文本",
                "sampleValue": "09:40"
              },
              "eventLocation": {
                "type": "string",
                "description": "日程发生地点",
                "sampleValue": "家中"
              },
              "description": {
                "type": "string",
                "description": "日程补充说明",
                "sampleValue": "早餐后服药"
              }
            }
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_remind.png",
      "description": "提醒图标，适合表达健康提醒或看护提醒入口。",
      "bindTo": "/asset/primaryIcon"
    },
    {
      "src": "resources/base/media/clock.svg",
      "description": "时钟线框图标，适合表达日程开始时间。",
      "bindTo": "/asset/timeIcon"
    },
    {
      "src": "resources/base/media/calendar_fill.svg",
      "description": "日历实心图标，适合表达从日历读取的日程。",
      "bindTo": "/asset/scheduleIcon"
    }
  ]
}
