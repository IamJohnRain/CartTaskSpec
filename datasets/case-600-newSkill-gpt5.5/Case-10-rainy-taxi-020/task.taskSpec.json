{
  "userQuery": "下雨天赶9点会议要迟到了，帮我做个卡片横着排三个小圆环：距离会议开始还有47分钟、距离出门还有15分钟、距离上车还有8分钟。点一下直接跳到天气App看雨什么时候停。底色用雨景照片的色调就行。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "title": {
              "type": "string",
              "description": "当天下一场会议标题。",
              "sampleValue": "9点会议"
            },
            "dtStart": {
              "type": "string",
              "description": "会议开始时间，今天内使用 HH:MM 格式。",
              "sampleValue": "09:00"
            },
            "entityId": {
              "type": "string",
              "description": "日程项唯一标识符。",
              "sampleValue": "calendar-meeting-0900"
            }
          }
        ]
      }
    },
    "ui": {
      "weatherIcon": {
        "type": "string",
        "description": "雨天出行天气图标素材路径。",
        "sampleValue": "resources/base/media/rain.png"
      },
      "actionLabel": {
        "type": "string",
        "description": "跳转天气应用的短按钮文案。",
        "sampleValue": "看雨停"
      },
      "timers": [
        {
          "label": {
            "type": "string",
            "description": "第一项倒计时对象标签。",
            "sampleValue": "会议开始"
          },
          "valueText": {
            "type": "string",
            "description": "距离会议开始的倒计时展示文本。",
            "sampleValue": "47分钟"
          },
          "value": {
            "type": "number",
            "description": "距离会议开始剩余分钟数。",
            "sampleValue": 47
          },
          "total": {
            "type": "number",
            "description": "小圆环的参考总分钟数。",
            "sampleValue": 60
          }
        },
        {
          "label": {
            "type": "string",
            "description": "第二项倒计时对象标签。",
            "sampleValue": "出门"
          },
          "valueText": {
            "type": "string",
            "description": "距离出门的倒计时展示文本。",
            "sampleValue": "15分钟"
          },
          "value": {
            "type": "number",
            "description": "距离出门剩余分钟数。",
            "sampleValue": 15
          },
          "total": {
            "type": "number",
            "description": "小圆环的参考总分钟数。",
            "sampleValue": 60
          }
        },
        {
          "label": {
            "type": "string",
            "description": "第三项倒计时对象标签。",
            "sampleValue": "上车"
          },
          "valueText": {
            "type": "string",
            "description": "距离上车的倒计时展示文本。",
            "sampleValue": "8分钟"
          },
          "value": {
            "type": "number",
            "description": "距离上车剩余分钟数。",
            "sampleValue": 8
          },
          "total": {
            "type": "number",
            "description": "小圆环的参考总分钟数。",
            "sampleValue": 60
          }
        }
      ]
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合的彩色天气图标，适合雨天出行、天气状态和跳转天气应用的视觉识别。",
      "bindTo": "/ui/weatherIcon"
    }
  ]
}
