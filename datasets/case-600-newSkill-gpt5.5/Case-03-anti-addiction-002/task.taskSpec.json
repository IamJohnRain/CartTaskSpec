{
  "userQuery": "帮我弄个应用时长的卡片 数字会变 点一下能进系统设置 日历读日程",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "parent_control"
      }
    }
  ],
  "dataModelSchema": {
    "usage": {
      "title": {
        "type": "string",
        "description": "卡片展示的应用时长对象标题",
        "sampleValue": "应用时长"
      },
      "todayText": {
        "type": "string",
        "description": "今日应用使用时长的展示文本",
        "sampleValue": "2小时35分"
      },
      "limitText": {
        "type": "string",
        "description": "今日应用使用时长限制的展示文本",
        "sampleValue": "限额 4小时"
      },
      "percent": {
        "type": "number",
        "description": "今日已使用时长占限额的百分比",
        "sampleValue": 65
      },
      "summary": {
        "type": "string",
        "description": "使用时长状态的简短摘要",
        "sampleValue": "距离限额还剩 1小时25分"
      }
    },
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "今天的日历日程列表",
          "sampleValue": [
            {
              "entityId": "event-001",
              "title": "晚间自习",
              "dtStart": "19:00",
              "dtEnd": "20:30"
            }
          ],
          "items": {
            "type": "object",
            "description": "日历日程项",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程唯一标识符",
                "sampleValue": "event-001"
              },
              "title": {
                "type": "string",
                "description": "日程标题",
                "sampleValue": "晚间自习"
              },
              "dtStart": {
                "type": "string",
                "description": "日程开始时间展示文本",
                "sampleValue": "19:00"
              },
              "dtEnd": {
                "type": "string",
                "description": "日程结束时间展示文本",
                "sampleValue": "20:30"
              }
            }
          }
        }
      }
    },
    "asset": {
      "timingIcon": {
        "type": "string",
        "description": "防沉迷计时图标资源路径",
        "sampleValue": "resources/base/media/icon_timing.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_timing.png",
      "description": "防沉迷计时图标，适合表达应用使用时长和时长管理。",
      "bindTo": "/asset/timingIcon"
    }
  ]
}
