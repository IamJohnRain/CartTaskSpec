{
  "userQuery": "卡片主体是个图 数字会跳的那种 点一下打开打车app 显示天气",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "当前天气查询的区县名称",
            "sampleValue": "青浦区"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本",
            "sampleValue": "23°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象",
            "sampleValue": "小雨"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比",
            "sampleValue": 86
          }
        },
        "daily": {
          "type": "array",
          "description": "从今天开始按日期升序排列的每日预报",
          "sampleValue": [
            {
              "rainProbabilityPercent": "83%"
            }
          ],
          "items": {
            "type": "object",
            "description": "单日天气预报",
            "properties": {
              "rainProbabilityPercent": {
                "type": "string",
                "description": "白天降雨概率百分比",
                "sampleValue": "83%"
              }
            }
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/rain.png",
      "description": "云朵和雨滴组合的彩色天气图标，适合雨天打车卡片中的主体天气图。"
    },
    {
      "src": "resources/base/media/icon_car.png",
      "description": "汽车/打车彩色图标，适合表达雨天叫车或出行入口。"
    }
  ]
}
