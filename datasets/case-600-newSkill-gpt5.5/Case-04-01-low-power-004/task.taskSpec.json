{
  "userQuery": "弄个卡片吧，按钮能进系统设置，电量数字会变，能读日历提醒快没电了",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "battery": {
      "percentText": {
        "type": "string",
        "description": "当前电量展示文本，会随运行时电量变化。",
        "sampleValue": "18%"
      },
      "statusText": {
        "type": "string",
        "description": "低电量状态提示。",
        "sampleValue": "快没电了"
      },
      "progressValue": {
        "type": "number",
        "description": "当前电量进度值。",
        "sampleValue": 18
      },
      "progressTotal": {
        "type": "number",
        "description": "电量进度总值。",
        "sampleValue": 100
      }
    },
    "data": {
      "calendar": {
        "items": {
          "type": "array",
          "description": "日历提醒列表，首条用于展示低电量提醒。",
          "items": {
            "type": "object",
            "description": "日历提醒项。",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "日程项唯一标识符。",
                "sampleValue": "calendar-low-power-1"
              },
              "title": {
                "type": "string",
                "description": "日程提醒标题。",
                "sampleValue": "低电量提醒"
              },
              "dtStart": {
                "type": "string",
                "description": "日程提醒开始时间。",
                "sampleValue": "18:30"
              },
              "dtEnd": {
                "type": "string",
                "description": "日程提醒结束时间。",
                "sampleValue": "18:35"
              }
            },
            "sampleValue": {
              "entityId": "calendar-low-power-1",
              "title": "低电量提醒",
              "dtStart": "18:30",
              "dtEnd": "18:35"
            }
          },
          "sampleValue": [
            {
              "entityId": "calendar-low-power-1",
              "title": "低电量提醒",
              "dtStart": "18:30",
              "dtEnd": "18:35"
            }
          ]
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，适合低电模式和电池续航提示。"
    }
  ]
