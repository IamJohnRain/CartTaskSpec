{
  "userQuery": "能打勾的待办，点一下能跳到app，从日历读日程，提醒我快没了",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程唯一标识符，用于端侧定位日程项。",
              "sampleValue": "calendar-event-001"
            },
            "title": {
              "type": "string",
              "description": "待办或日程标题。",
              "sampleValue": "产品评审"
            },
            "dtStart": {
              "type": "string",
              "description": "日程开始时间，今日日程使用 HH:MM 展示。",
              "sampleValue": "14:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "日程结束时间，今日日程使用 HH:MM 展示。",
              "sampleValue": "15:00"
            },
            "remindTime": [
              {
                "type": "string",
                "description": "日程提醒时间展示文本。",
                "sampleValue": "提前15分钟"
              }
            ],
            "importantEventType": {
              "type": "integer",
              "description": "日程重要日期类型，0 为普通，1 为正数日，2 为倒数日。",
              "sampleValue": 2
            }
          },
          {
            "entityId": {
              "type": "string",
              "description": "第二条日程唯一标识符。",
              "sampleValue": "calendar-event-002"
            },
            "title": {
              "type": "string",
              "description": "第二条待办或日程标题。",
              "sampleValue": "客户回访"
            },
            "dtStart": {
              "type": "string",
              "description": "第二条日程开始时间。",
              "sampleValue": "16:00"
            },
            "dtEnd": {
              "type": "string",
              "description": "第二条日程结束时间。",
              "sampleValue": "16:30"
            },
            "remindTime": [
              {
                "type": "string",
                "description": "第二条日程提醒时间展示文本。",
                "sampleValue": "提前10分钟"
              }
            ],
            "importantEventType": {
              "type": "integer",
              "description": "第二条日程重要日期类型。",
              "sampleValue": 0
            }
          }
        ]
      }
    },
    "ui": {
      "todo0Checked": {
        "type": "boolean",
        "description": "第一条待办的勾选样例状态。",
        "sampleValue": false
      },
      "todo1Checked": {
        "type": "boolean",
        "description": "第二条待办的勾选样例状态。",
        "sampleValue": false
      },
      "urgencyLabel": {
        "type": "string",
        "description": "提醒状态短标签。",
        "sampleValue": "快到点"
      },
      "remainingText": {
        "type": "string",
        "description": "距离下一条日程开始的短提醒。",
        "sampleValue": "距下一项15分钟"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/checkmark_calendar_fill.svg",
      "description": "带对勾的日历实心图标，适合表示可勾选的日程待办。"
    }
  ]
}
