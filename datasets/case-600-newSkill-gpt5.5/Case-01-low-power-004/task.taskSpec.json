{
  "userQuery": "弄个卡片吧，按钮能进系统设置，电量数字会变，能读日历提醒快没电了",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "battery": {
        "levelText": {
          "type": "string",
          "description": "当前电量百分比展示文本",
          "sampleValue": "18%"
        },
        "levelValue": {
          "type": "number",
          "description": "当前电量数值，用于电量进度展示",
          "sampleValue": 18
        },
        "total": {
          "type": "number",
          "description": "电量总量基准值",
          "sampleValue": 100
        },
        "statusText": {
          "type": "string",
          "description": "低电状态短提示",
          "sampleValue": "电量偏低"
        },
        "remindText": {
          "type": "string",
          "description": "结合日历场景给出的低电提醒文案",
          "sampleValue": "出门前建议充电"
        }
      },
      "calendar": {
        "items": [
          {
            "title": {
              "type": "string",
              "description": "下一条日历提醒标题",
              "sampleValue": "客户沟通"
            },
            "dtStart": {
              "type": "string",
              "description": "下一条日历提醒开始时间",
              "sampleValue": "16:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "下一条日历提醒结束时间",
              "sampleValue": "17:00"
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "低电模式电池图标，适合用于电量状态识别。"
    },
    {
      "src": "resources/base/media/icon_schedule.png",
      "description": "日程图标，适合用于日历提醒信息。"
    }
  ]
}
