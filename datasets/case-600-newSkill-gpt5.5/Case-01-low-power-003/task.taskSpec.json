{
  "userQuery": "整个电量监控的嘛,能看百分比,点能开省电,能读天气,红色警告加上",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "battery": {
      "percent": {
        "type": "number",
        "description": "当前电池剩余电量百分比，用于进度条和主数值展示。",
        "sampleValue": 18
      },
      "percentText": {
        "type": "string",
        "description": "当前电池剩余电量的可读百分比文本。",
        "sampleValue": "18%"
      },
      "statusText": {
        "type": "string",
        "description": "低电量红色警告状态短文案。",
        "sampleValue": "低电量警告"
      },
      "savingState": {
        "type": "string",
        "description": "省电模式当前状态提示。",
        "sampleValue": "省电未开启"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名称。",
            "sampleValue": "本地"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前天气温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "晴"
          },
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警级别或提示。",
            "sampleValue": "无天气预警"
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "天气数据更新时间。",
          "sampleValue": "09:30"
        }
      }
    },
    "asset": {
      "batteryIcon": {
        "type": "string",
        "description": "低电模式电池图标素材路径。",
        "sampleValue": "resources/base/media/battery_leaf_fill.svg"
      },
      "savePowerIcon": {
        "type": "string",
        "description": "省电模式动作图标素材路径。",
        "sampleValue": "resources/base/media/bolt_fill.svg"
      },
      "weatherIcon": {
        "type": "string",
        "description": "当前天气图标素材路径。",
        "sampleValue": "resources/base/media/sun_max.svg"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/battery_leaf_fill.svg",
      "description": "电池与绿叶组合图标，适合低电模式卡片中表示电量监控和节能状态。",
      "bindTo": "/asset/batteryIcon"
    },
    {
      "src": "resources/base/media/bolt_fill.svg",
      "description": "闪电图标，适合表示省电模式或用电动作入口。",
      "bindTo": "/asset/savePowerIcon"
    },
    {
      "src": "resources/base/media/sun_max.svg",
      "description": "太阳图标，适合表示当前天气概况。",
      "bindTo": "/asset/weatherIcon"
    }
  ]
}
