{
  "userQuery": "整个电量监控的嘛,能看百分比,点能开省电,能读天气,红色警告加上",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    },
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "battery": {
      "levelPercent": {
        "type": "number",
        "description": "当前电量百分比数值，用于进度环。",
        "sampleValue": 18
      },
      "levelText": {
        "type": "string",
        "description": "当前电量百分比展示文本。",
        "sampleValue": "18%"
      },
      "statusText": {
        "type": "string",
        "description": "低电量红色警告状态。",
        "sampleValue": "低电量警告"
      },
      "modeHint": {
        "type": "string",
        "description": "省电模式操作提示。",
        "sampleValue": "开启省电延长续航"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询地区名称。",
            "sampleValue": "本地"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "29°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          }
        }
      }
    },
    "asset": {
      "batteryIcon": {
        "type": "string",
        "description": "低电量监控图标资源路径。",
        "sampleValue": "resources/base/media/icon_electricity.png"
      },
      "savePowerIcon": {
        "type": "string",
        "description": "省电模式动作图标资源路径。",
        "sampleValue": "resources/base/media/icon_save_power.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_electricity.png",
      "description": "电池图标，适合低电模式卡片中表示当前电量监控和低电提醒。",
      "bindTo": "/asset/batteryIcon"
    },
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，适合表示开启省电模式的动作入口。",
      "bindTo": "/asset/savePowerIcon"
    }
  ]
}
