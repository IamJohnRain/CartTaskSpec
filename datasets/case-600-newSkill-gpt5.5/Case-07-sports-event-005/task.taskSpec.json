{
  "userQuery": "整个足球赛背景图卡片吧，文字叠在图上，显示一行比分，点进系统操作，读天气，红色危险提示",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "match": {
      "title": {
        "type": "string",
        "description": "足球赛事阶段或名称，用于叠加在背景图上的赛事标签。",
        "sampleValue": "半决赛"
      },
      "scoreLine": {
        "type": "string",
        "description": "一行足球比分摘要，包含主客队短名和当前比分。",
        "sampleValue": "主队2-1客队"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询区县名称。",
            "sampleValue": "浦东新区"
          }
        },
        "current": {
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "雷阵雨"
          },
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "28°C"
          },
          "alertLevel": {
            "type": "string",
            "description": "当前天气预警级别或预警提示。",
            "sampleValue": "红色预警"
          }
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/thunderstorm.png",
      "description": "雷暴天气彩色图标素材，可作为危险天气背景视觉锚点，适合赛事天气预警场景。"
    }
  ]
}
