{
  "userQuery": "能点开导航找充电宝的，能读天气，提示我快没电了吧",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "card": {
      "title": {
        "type": "string",
        "description": "卡片短标题，提示当前处于低电提醒场景。",
        "sampleValue": "低电提醒"
      }
    },
    "asset": {
      "statusIcon": {
        "type": "string",
        "description": "低电状态图标素材路径，只能取素材白名单中的低电节能图标。",
        "sampleValue": "resources/base/media/battery_leaf_fill.svg"
      },
      "weatherIcon": {
        "type": "string",
        "description": "当前天气图标素材路径，只能取素材白名单中的天气图标。",
        "sampleValue": "resources/base/media/sun_max.svg"
      }
    },
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "天气查询的区县或当前位置展示名。",
            "sampleValue": "当前位置"
          },
          "prefectureName": {
            "type": "string",
            "description": "天气查询的城市名或本地泛称。",
            "sampleValue": "本地"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "28°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象短文本。",
            "sampleValue": "多云"
          }
        }
      }
    },
    "battery": {
      "warningText": {
        "type": "string",
        "description": "低电状态提醒短文本。",
        "sampleValue": "电量低"
      }
    },
    "action": {
      "label": {
        "type": "string",
        "description": "底部动作按钮文本，用于进入与充电寻找相关的入口。",
        "sampleValue": "找充电宝"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/battery_leaf_fill.svg",
      "description": "电池与绿叶组合图标，适合表达低电和节能提醒状态。",
      "bindTo": "/asset/statusIcon"
    },
    {
      "src": "resources/base/media/sun_max.svg",
      "description": "太阳天气图标，适合表达天气速览入口和当前天气状态。",
      "bindTo": "/asset/weatherIcon"
    }
  ]
}
