{
  "userQuery": "整个能打勾那种省电卡数字会变点一下找充电宝能读日程还有红色提醒",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    },
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "com.huawei.hmos.settings",
        "abilityName": "com.huawei.hmos.settings.MainAbility",
        "uri": "battery"
      }
    }
  ],
  "dataModelSchema": {
    "battery": {
      "levelText": {
        "type": "string",
        "description": "当前电量百分比展示文本，用于低电量主数字。",
        "sampleValue": "18%"
      },
      "isLowPowerOn": {
        "type": "boolean",
        "description": "省电模式是否已经开启，用于打勾状态。",
        "sampleValue": true
      }
    },
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日程索引项唯一标识符。",
              "sampleValue": "sample-event-001"
            },
            "title": {
              "type": "string",
              "description": "下一条日程标题。",
              "sampleValue": "14:30 评审"
            },
            "dtStart": {
              "type": "string",
              "description": "下一条日程开始时间。",
              "sampleValue": "14:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "下一条日程结束时间。",
              "sampleValue": "15:00"
            }
          }
        ]
      }
    },
    "asset": {
      "powerIcon": {
        "type": "string",
        "description": "低电模式省电图标路径。",
        "sampleValue": "resources/base/media/icon_save_power.png"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_save_power.png",
      "description": "省电图标，适合低电模式卡片中表达已开启省电与绿色用电状态。",
      "bindTo": "/asset/powerIcon"
    }
  ]
}
