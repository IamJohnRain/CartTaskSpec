{
  "userQuery": "显示还剩多少分钟,点一下导航去会议室,自动读日历,显示已入会",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "StartNavigate",
        "params": {
          "dstLocation": {
            "latitude": "22.543096",
            "longitude": "114.057865"
          },
          "trafficpe": "Walk"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityId": {
              "type": "string",
              "description": "日历事件唯一标识符，用于定位当前会议事件。",
              "sampleValue": "calendar_event_10086"
            },
            "title": {
              "type": "string",
              "description": "当前或下一场会议标题。",
              "sampleValue": "同步会"
            },
            "dtStart": {
              "type": "string",
              "description": "会议开始时间，今天内使用 HH:MM 展示。",
              "sampleValue": "10:40"
            },
            "eventLocation": {
              "type": "string",
              "description": "会议室或日程地点短文本。",
              "sampleValue": "A座301"
            },
            "remainingMinutesText": {
              "type": "string",
              "description": "距离会议开始剩余分钟数的展示文本。",
              "sampleValue": "12"
            },
            "countdownProgress": {
              "type": "number",
              "description": "倒计时进度值，供小型仪表展示。",
              "sampleValue": 48
            },
            "countdownTotal": {
              "type": "number",
              "description": "倒计时仪表总量。",
              "sampleValue": 60
            },
            "joinedStatus": {
              "type": "string",
              "description": "会议加入状态短文本。",
              "sampleValue": "已入会"
            },
            "destination": {
              "latitude": {
                "type": "string",
                "description": "从会议地点解析出的导航目的地纬度。",
                "sampleValue": "22.543096"
              },
              "longitude": {
                "type": "string",
                "description": "从会议地点解析出的导航目的地经度。",
                "sampleValue": "114.057865"
              }
            }
          }
        ]
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/icon_meeting.png",
      "description": "会议图标，适合用于议程提醒卡片的会议对象识别。"
    },
    {
      "src": "resources/base/media/clock.svg",
      "description": "时钟线框图标，适合用于会议开始时间或倒计时信息。"
    },
    {
      "src": "resources/base/media/location_north_up_right_fill.svg",
      "description": "方向导航实心图标，适合用于地图导航动作入口。"
    },
    {
      "src": "resources/base/media/checkmark_calendar_fill.svg",
      "description": "带对勾的日历图标，适合用于日程确认或已入会状态。"
    }
  ]
}
