              "sampleValue": "12:30 到达"
            },
            "statusText": {
              "type": "string",
              "description": "第一件包裹状态展示文本。",
              "sampleValue": "已签收"
            },
            "statusMark": {
              "type": "string",
              "description": "第一件包裹完成态标记。",
              "sampleValue": "√"
            },
            "statusColor": {
              "type": "string",
