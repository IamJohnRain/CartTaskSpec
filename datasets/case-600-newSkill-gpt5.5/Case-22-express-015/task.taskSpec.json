{
  "userQuery": "做一个浅色底的物流卡吧,我老是忘看天气结果取快递被淋湿,烦死了。左边一个快递车文字图标做大主视觉,旁边显示\"今日新增 6 单\"动态数字,右上角放个跳天气app的入口,卡片里直接读未来几小时天气数据,下面是能滚动的列表展示各包裹送达时间,已签收的标绿色对勾完成态,不要渐变。",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "22°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "小雨"
          }
        },
        "nextHours": {
          "summary": {
            "type": "string",
            "description": "未来几小时天气提示，用于提醒取快递前查看降雨情况。",
            "sampleValue": "未来3小时有雨"
          }
        }
      },
      "express": {
        "todayNewText": {
          "type": "string",
          "description": "今日新增快递单量展示文本。",
          "sampleValue": "6 单"
        },
