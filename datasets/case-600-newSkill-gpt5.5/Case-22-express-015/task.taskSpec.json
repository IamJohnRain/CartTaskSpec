            "statusMark": {
              "type": "string",
              "description": "第二件包裹完成态标记。",
              "sampleValue": ""
            },
            "statusColor": {
              "type": "string",
              "description": "第二件包裹状态文本颜色。",
              "sampleValue": "#99000000"
            }
          }
        ]
      }
    }
  },
