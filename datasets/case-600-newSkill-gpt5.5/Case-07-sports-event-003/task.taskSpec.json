{
  "userQuery": "弄个比赛提醒卡片嘛 点一下就能看 要是快开始了就提醒我一下",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "ViewCalendarEvent",
        "params": {
          "entityId": "sports_event_001"
        }
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "calendar": {
        "items": [
          {
            "entityName": {
              "type": "string",
              "description": "日程项类别名称",
              "sampleValue": "日历事件"
            },
            "entityId": {
              "type": "string",
              "description": "用于打开日程详情的事件唯一标识",
              "sampleValue": "sports_event_001"
            },
            "title": {
              "type": "string",
              "description": "比赛或赛事标题",
              "sampleValue": "湖人 vs 勇士"
            },
            "eventLocation": {
              "type": "string",
              "description": "比赛地点或观看地点",
              "sampleValue": "主场馆 A 区"
            },
            "dtStart": {
              "type": "string",
              "description": "比赛开始时间展示文本",
              "sampleValue": "今晚 19:30"
            },
            "dtEnd": {
              "type": "string",
              "description": "比赛结束时间展示文本",
              "sampleValue": "21:30"
            },
            "remindTime": {
              "type": "array",
              "description": "已设置的提醒时间列表",
              "sampleValue": [
                "开赛前 15 分钟"
              ]
            }
          }
        ]
      }
    },
    "ui": {
      "countdownText": {
        "type": "string",
        "description": "距离比赛开始的短倒计时展示文本",
        "sampleValue": "15分"
      },
      "statusText": {
        "type": "string",
        "description": "比赛临近开始时的提醒状态文案",
        "sampleValue": "快开始了"
      },
      "actionLabel": {
        "type": "string",
        "description": "打开赛事日程详情的动作文案",
        "sampleValue": "看赛程"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/stopwatch_fill.svg",
      "description": "秒表实心图标，适合表达赛事倒计时、开赛提醒和临近开始状态。"
    }
  ]
}
