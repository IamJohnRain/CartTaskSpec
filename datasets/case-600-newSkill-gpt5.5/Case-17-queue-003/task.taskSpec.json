{
  "userQuery": "帮我做个取号打勾的那种吧，有几个选项，人数会变，点一下能调提醒，快到号喊我",
  "size": "2x2",
  "eventCandidates": [
    {
      "call": "clickToIntent",
      "args": {
        "intentName": "SetSettingSwitch",
        "params": {
          "appBundleName": "com.huawei.hmos.settings",
          "itemName": "battery_saving_mode",
          "switchFlag": 0
        }
      }
    }
  ],
  "dataModelSchema": {
    "queue": {
      "title": {
        "type": "string",
        "description": "排队取号服务的卡片标题",
        "sampleValue": "取号排队"
      },
      "ticketNo": {
        "type": "string",
        "description": "当前用户已取得的排队号码",
        "sampleValue": "A128"
      },
      "waitingText": {
        "type": "string",
        "description": "当前排在用户前方的人数展示文本",
        "sampleValue": "前方 6 人"
      },
      "statusText": {
        "type": "string",
        "description": "排队叫号的当前提醒状态",
        "sampleValue": "快到号提醒"
      },
      "remindEnabled": {
        "type": "boolean",
        "description": "是否已开启快到号提醒",
        "sampleValue": true
      },
      "optionLabel": {
        "type": "string",
        "description": "用户可勾选的提醒选项名称",
        "sampleValue": "快到号喊我"
      }
    },
    "asset": {
      "remindIcon": {
        "type": "string",
        "description": "提醒状态图标资源路径",
        "sampleValue": "resources/base/media/bell_fill.svg"
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/bell_fill.svg",
      "description": "铃铛实心图标，适合表达排队叫号的通知提醒和快到号提示。",
      "bindTo": "/asset/remindIcon"
    }
  ]
}
