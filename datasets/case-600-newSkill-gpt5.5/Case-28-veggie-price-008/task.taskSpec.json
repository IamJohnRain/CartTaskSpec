{
  "userQuery": "点开外卖app查菜价，顺便看下今天天气",
  "size": "2x4",
  "eventCandidates": [
    {
      "call": "clickToDeeplink",
      "args": {
        "bundleName": "",
        "abilityName": "",
        "uri": "hww://www.huawei.com/totemweather?enterType=share&cityCode="
      }
    }
  ],
  "dataModelSchema": {
    "data": {
      "weather": {
        "location": {
          "districtName": {
            "type": "string",
            "description": "实际查询成功的区县名称，用于标识当前天气位置。",
            "sampleValue": "本地"
          }
        },
        "current": {
          "temperatureText": {
            "type": "string",
            "description": "当前温度展示文本。",
            "sampleValue": "26°C"
          },
          "condition": {
            "type": "string",
            "description": "当前天气现象。",
            "sampleValue": "多云"
          },
          "airQuality": {
            "type": "string",
            "description": "当前空气质量等级。",
            "sampleValue": "优"
          },
          "humidityPercent": {
            "type": "number",
            "description": "当前相对湿度百分比。",
            "sampleValue": 62
          }
        },
        "daily": [
          {
            "weekday": {
              "type": "string",
              "description": "第一天预报的星期或相对日期文本。",
              "sampleValue": "今天"
            },
            "temperatureRangeText": {
              "type": "string",
              "description": "第一天预报的温度范围展示文本。",
              "sampleValue": "24°/31°"
            }
          },
          {
            "weekday": {
              "type": "string",
              "description": "第二天预报的星期或相对日期文本。",
              "sampleValue": "明天"
            },
            "temperatureRangeText": {
              "type": "string",
              "description": "第二天预报的温度范围展示文本。",
              "sampleValue": "25°/32°"
            }
          }
        ],
        "updatedAt": {
          "type": "string",
          "description": "天气数据更新时间的短文本。",
          "sampleValue": "10:30更新"
        }
      }
    }
  },
  "assetCandidates": [
    {
      "src": "resources/base/media/cloudy_turning_sunny.png",
      "description": "小云朵和太阳组合的彩色天气图标，适合用于天气状态识别和轻量环境氛围。"
    }
  ]
}
